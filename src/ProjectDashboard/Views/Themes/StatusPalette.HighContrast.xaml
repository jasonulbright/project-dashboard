<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Under a Windows high-contrast theme every color must come from the theme's own system
         palette: the fixed hex values of the light and dark palettes are tuned against surfaces
         that theme replaces, and a hardcoded tint can land invisible against, or identical to,
         whatever the user chose. Status is not color-coded here — the word labels and announced
         names carry it — and each key resolves through SystemColors so a theme change at run
         time re-resolves without a restart. -->
    <SolidColorBrush x:Key="StatusGoodFg" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="StatusWarnFg" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="StatusBadFg" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="StatusPrivateFg" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="StatusInfoFg" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="StatusNeutralFg" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />

    <SolidColorBrush x:Key="StatusGoodBg" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="StatusWarnBg" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="StatusBadBg" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="StatusPrivateBg" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="StatusInfoBg" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="StatusNeutralBg" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />

    <SolidColorBrush x:Key="FocusRingBrush" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />

    <!-- A diff line's own +/- marker and its numbers are what tell added from removed here;
         the raw unified text keeps its marker column by design. -->
    <SolidColorBrush x:Key="DiffRemovedCellBg" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="DiffAddedCellBg" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="DiffRemovedWordBg" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="DiffAddedWordBg" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="DiffAbsentCellBg" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />

    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
</ResourceDictionary>
