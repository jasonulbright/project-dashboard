<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Functional repo-status colours for the dark surfaces. Bg is a ~16% tint for a soft
         badge. Each Fg clears 4.5:1 against the #343434 card fill these render on; over its
         own tint composited on that fill the range is 3.5:1 to 4.3:1, so a badge label is
         large-text contrast, not body contrast. -->
    <SolidColorBrush x:Key="StatusGoodFg" Color="#3FB950" />
    <SolidColorBrush x:Key="StatusWarnFg" Color="#E8A317" />
    <SolidColorBrush x:Key="StatusBadFg" Color="#F08585" />
    <SolidColorBrush x:Key="StatusPrivateFg" Color="#A78BFA" />
    <SolidColorBrush x:Key="StatusInfoFg" Color="#6CA4D9" />
    <SolidColorBrush x:Key="StatusNeutralFg" Color="#9AA0A6" />

    <SolidColorBrush x:Key="StatusGoodBg" Color="#283FB950" />
    <SolidColorBrush x:Key="StatusWarnBg" Color="#28E8A317" />
    <SolidColorBrush x:Key="StatusBadBg" Color="#28F08585" />
    <SolidColorBrush x:Key="StatusPrivateBg" Color="#28A78BFA" />
    <SolidColorBrush x:Key="StatusInfoBg" Color="#286CA4D9" />
    <SolidColorBrush x:Key="StatusNeutralBg" Color="#18FFFFFF" />

    <!-- Focus ring, and the diff row tints. Both are drawn over the dark surface. -->
    <SolidColorBrush x:Key="FocusRingBrush" Color="#4CC2FF" />
    <SolidColorBrush x:Key="DiffRemovedCellBg" Color="#1EE05252" />
    <SolidColorBrush x:Key="DiffAddedCellBg" Color="#1E3FB950" />
    <SolidColorBrush x:Key="DiffRemovedWordBg" Color="#4CE05252" />
    <SolidColorBrush x:Key="DiffAddedWordBg" Color="#4C3FB950" />
    <SolidColorBrush x:Key="DiffAbsentCellBg" Color="#0D808080" />
</ResourceDictionary>
