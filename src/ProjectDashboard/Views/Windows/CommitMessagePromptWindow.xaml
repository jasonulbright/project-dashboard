<ui:FluentWindow
    x:Class="ProjectDashboard.Views.Windows.CommitMessagePromptWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:ProjectDashboard.Helpers"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Commit message"
    Width="640"
    Height="420"
    FontFamily="Segoe UI"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica">

    <ui:FluentWindow.Resources>
        <helpers:HasNonWhitespaceTextConverter x:Key="HasNonWhitespaceTextConverter" />
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" x:Name="TitleBarControl" Title="Commit message" ShowMaximize="False" ShowMinimize="False" />

        <TextBlock Grid.Row="1" x:Name="PromptText" Margin="16,8,16,8" FontSize="13" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <ui:TextBox Grid.Row="2" x:Name="MessageInput" Margin="16,0,16,8"
                    AcceptsReturn="True" TextWrapping="Wrap"
                    VerticalContentAlignment="Top"
                    VerticalScrollBarVisibility="Auto"
                    FontFamily="Cascadia Code,Consolas" FontSize="13"
                    AutomationProperties.Name="Commit message"
                    AutomationProperties.HelpText="{Binding Text, ElementName=PromptText}" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,0,16,16">
            <TextBlock Text="Ctrl+Enter saves, Esc cancels." FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            <ui:Button x:Name="CancelButton" Content="Cancel" Padding="14,5" Margin="0,0,8,0"
                       IsCancel="True" Click="OnCancel"
                       AutomationProperties.Name="Cancel and keep the message unchanged" />
            <ui:Button x:Name="SaveButton" Content="Save" Padding="14,5" Appearance="Primary"
                       IsDefault="False" Click="OnSave"
                       IsEnabled="{Binding Text, ElementName=MessageInput, Converter={StaticResource HasNonWhitespaceTextConverter}}"
                       AutomationProperties.Name="Save this commit message" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
