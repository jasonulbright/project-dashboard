<ui:FluentWindow
    x:Class="ProjectDashboard.Views.Windows.TextPromptWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:ProjectDashboard.Helpers"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Confirm"
    Width="560"
    SizeToContent="Height"
    FontFamily="Segoe UI"
    ShowInTaskbar="False"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica">

    <ui:FluentWindow.Resources>
        <helpers:HasNonWhitespaceTextConverter x:Key="HasNonWhitespaceTextConverter" />
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" x:Name="TitleBarControl" Title="Confirm" ShowMaximize="False" ShowMinimize="False" />

        <TextBlock Grid.Row="1" x:Name="PromptText" Margin="16,8,16,10" FontSize="13" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <!-- The prompt names what has to be typed, so it labels the box: a static name would
             leave a reader with the field and not the value it is asking for. -->
        <ui:TextBox Grid.Row="2" x:Name="ValueInput" Margin="16,0,16,10"
                    FontFamily="Cascadia Code,Consolas" FontSize="13"
                    AutomationProperties.LabeledBy="{Binding ElementName=PromptText}"
                    AutomationProperties.HelpText="{Binding Text, ElementName=PromptText}" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,0,16,16">
            <TextBlock Text="Enter confirms, Esc cancels." FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            <ui:Button x:Name="CancelButton" Content="Cancel" Padding="14,5" Margin="0,0,8,0"
                       IsCancel="True" Click="OnCancel"
                       AutomationProperties.Name="Cancel without changing anything" />
            <ui:Button x:Name="ConfirmButton" Content="Confirm" Padding="14,5"
                       Appearance="Danger" IsDefault="True" Click="OnConfirm"
                       IsEnabled="{Binding Text, ElementName=ValueInput, Converter={StaticResource HasNonWhitespaceTextConverter}}"
                       AutomationProperties.Name="Confirm this action" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
