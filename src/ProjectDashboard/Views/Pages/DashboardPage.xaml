<Page
    x:Class="ProjectDashboard.Views.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:helpers="clr-namespace:ProjectDashboard.Helpers"
    xmlns:models="clr-namespace:ProjectDashboard.Models">

    <Page.Resources>
        <helpers:RelativeTimeConverter x:Key="RelativeTimeConverter" />
        <!-- FocusRing / FocusableChip live in App.xaml (shared with the detail page). -->
    </Page.Resources>

    <DockPanel Margin="24,16">

        <!-- Discovery failure banner: a faulted scan must say so, not show nothing -->
        <Border DockPanel.Dock="Top"
                Visibility="{Binding DiscoveryErrorVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{StaticResource StatusBadFg}" BorderThickness="1" CornerRadius="8"
                Padding="12,8" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="ErrorCircle24" Foreground="{StaticResource StatusBadFg}" FontSize="16"
                               Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding DiscoveryErrorText}" VerticalAlignment="Center" TextWrapping="Wrap"
                           MaxWidth="760"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="13" />
                <ui:Button Content="Retry" FontSize="12" Padding="10,4" Margin="14,0,0,0"
                           Command="{Binding ForceRefreshCommand}" />
                <ui:Button Content="Open Settings" FontSize="12" Padding="10,4" Margin="8,0,0,0"
                           Command="{Binding OpenSettingsCommand}" />
            </StackPanel>
        </Border>

        <!-- GitHub-not-ready banner: shows when gh is missing or not signed in -->
        <Border DockPanel.Dock="Top"
                Visibility="{Binding GhBannerVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="#E8A317" BorderThickness="1" CornerRadius="8"
                Padding="12,8" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Warning24" Foreground="#E8A317" FontSize="16"
                               Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding GhBannerText}" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="13" />
                <ui:Button Content="Sign in to GitHub" FontSize="12" Padding="10,4" Margin="14,0,0,0"
                           Appearance="Primary"
                           Command="{Binding GhSignInCommand}"
                           Visibility="{Binding GhSignInVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <ui:Button Content="Open Settings" FontSize="12" Padding="10,4" Margin="8,0,0,0"
                           Command="{Binding OpenSettingsCommand}" />
                <ui:Button Content="Dismiss" FontSize="12" Padding="10,4" Margin="8,0,0,0"
                           Command="{Binding DismissGhBannerCommand}" />
            </StackPanel>
        </Border>

        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Summary bar (clickable filters, aligned to filter bar below) -->
        <StackPanel x:Name="SummaryBar" Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8"
                    KeyboardNavigation.TabNavigation="Once"
                    PreviewKeyDown="SummaryBar_PreviewKeyDown">
            <!-- All chip Borders become keyboard-focusable (Enter/Space handled in code-behind). -->
            <StackPanel.Resources>
                <Style TargetType="Border" BasedOn="{StaticResource FocusableChip}" />
            </StackPanel.Resources>
            <!-- Group 1: Total + Dirty = 180px (aligns with Category dropdown) -->
            <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                    CornerRadius="8" Padding="12,8" Width="86" Margin="0,0,8,0"
                    Cursor="Hand" ToolTip="Show all projects"
                    AutomationProperties.Name="{Binding TotalCount, StringFormat='Show all projects, {0} total'}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding SetFilterCommand}" CommandParameter="all" />
                </Border.InputBindings>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Total: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding TotalCount}" FontWeight="SemiBold" FontSize="12"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                    CornerRadius="8" Padding="12,8" Width="86" Margin="0,0,12,0"
                    Cursor="Hand" ToolTip="Show only dirty projects"
                    AutomationProperties.Name="{Binding DirtyCount, StringFormat='Show dirty projects, {0} dirty'}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding SetFilterCommand}" CommandParameter="dirty" />
                </Border.InputBindings>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Dirty: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding DirtyCount}" FontWeight="SemiBold" FontSize="12"
                               Foreground="#E8A317" />
                </StackPanel>
            </Border>

            <!-- Group 2: Tasks + Issues = 180px (aligns with Sort dropdown) -->
            <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                    CornerRadius="8" Padding="12,8" Width="86" Margin="0,0,8,0"
                    Cursor="Hand" ToolTip="Show projects with pending tasks"
                    AutomationProperties.Name="{Binding TodoCount, StringFormat='Show projects with tasks, {0} have tasks'}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding SetFilterCommand}" CommandParameter="todos" />
                </Border.InputBindings>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Tasks: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding TodoCount}" FontWeight="SemiBold" FontSize="12"
                               Foreground="{StaticResource StatusInfoFg}" />
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                    CornerRadius="8" Padding="12,8" Width="86" Margin="0,0,12,0"
                    Cursor="Hand" ToolTip="Show projects with open issues"
                    AutomationProperties.Name="{Binding IssueCount, StringFormat='Show projects with open issues, {0} open issues'}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding SetFilterCommand}" CommandParameter="issues" />
                </Border.InputBindings>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Issues: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding IssueCount}" FontWeight="SemiBold" FontSize="12"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Cloud chip: GitHub repos not cloned locally (ROADMAP v1.1) -->
            <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                    CornerRadius="8" Padding="12,8" Margin="0,0,8,0"
                    Cursor="Hand" ToolTip="Show GitHub repos that aren't cloned locally"
                    AutomationProperties.Name="{Binding CloudCount, StringFormat='Show cloud-only repos, {0} not cloned'}"
                    Visibility="{Binding HasCloud, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding SetFilterCommand}" CommandParameter="cloud" />
                </Border.InputBindings>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <ui:SymbolIcon Symbol="Cloud24" FontSize="14" Margin="0,0,6,0"
                                   Foreground="{StaticResource StatusInfoFg}" VerticalAlignment="Center" />
                    <TextBlock Text="Cloud: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding CloudCount}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource StatusInfoFg}" />
                </StackPanel>
            </Border>

            <!-- Data-quality badges: only shown when there's something to fix -->
            <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                    CornerRadius="8" Padding="12,8" Margin="0,0,8,0"
                    Cursor="Hand" ToolTip="Show projects whose git remote does not match their folder name"
                    AutomationProperties.Name="{Binding MismatchCount, StringFormat='Show remote-mismatch projects, {0} mismatched'}"
                    Visibility="{Binding HasMismatches, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding SetFilterCommand}" CommandParameter="mismatch" />
                </Border.InputBindings>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <ui:SymbolIcon Symbol="PlugDisconnected24" FontSize="14" Margin="0,0,6,0"
                                   Foreground="#E8A317" VerticalAlignment="Center" />
                    <TextBlock Text="Remote: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding MismatchCount}" FontWeight="SemiBold" FontSize="12" Foreground="#E8A317" />
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                    CornerRadius="8" Padding="12,8" Margin="0,0,12,0"
                    Cursor="Hand" ToolTip="Show projects with no metadata or a blank description"
                    AutomationProperties.Name="{Binding IncompleteCount, StringFormat='Show projects needing metadata, {0} need it'}"
                    Visibility="{Binding HasIncomplete, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding SetFilterCommand}" CommandParameter="incomplete" />
                </Border.InputBindings>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <ui:SymbolIcon Symbol="DocumentError24" FontSize="14" Margin="0,0,6,0"
                                   Foreground="#E8A317" VerticalAlignment="Center" />
                    <TextBlock Text="Needs meta: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding IncompleteCount}" FontWeight="SemiBold" FontSize="12" Foreground="#E8A317" />
                </StackPanel>
            </Border>

            <!-- Group 3: Hidden + Refresh + New = 280px (aligns with Search box) -->
            <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                    CornerRadius="8" Padding="12,8" Width="86" Margin="0,0,8,0"
                    Cursor="Hand" ToolTip="Show hidden projects"
                    AutomationProperties.Name="{Binding HiddenCount, StringFormat='Show hidden projects, {0} hidden'}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding FilterHiddenCommand}" />
                </Border.InputBindings>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Hidden: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding HiddenCount}" FontWeight="SemiBold" FontSize="12"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Border>
            <ui:Button Content="Refresh" FontSize="12" Padding="8,6"
                       Icon="{ui:SymbolIcon ArrowSync24}"
                       Command="{Binding ForceRefreshCommand}"
                       Width="90" Margin="0,0,8,0" />
            <ui:Button Content="New" FontSize="12" Padding="8,6"
                       Icon="{ui:SymbolIcon Add24}"
                       Command="{Binding NewProjectCommand}"
                       Width="80" Margin="0,0,8,0" />
            <ui:Button Content="Clone" FontSize="12" Padding="8,6"
                       Icon="{ui:SymbolIcon CloudArrowDown24}"
                       Command="{Binding CloneRepoCommand}"
                       Width="86" Margin="0,0,8,0" />
            <ui:Button Content="Sync All" FontSize="12" Padding="8,6"
                       Icon="{ui:SymbolIcon ArrowSyncCircle24}"
                       Command="{Binding SyncAllCommand}"
                       ToolTip="Fetch every clean repo; fast-forward the ones behind, push the ones ahead"
                       Width="96" Margin="0,0,8,0" />
            <TextBlock Text="{Binding OpStatusText}" FontSize="12" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Filter + Sort bar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <ComboBox ItemsSource="{Binding Categories}"
                      SelectedItem="{Binding SelectedCategory}"
                      AutomationProperties.Name="Category filter"
                      ToolTip="Category filter"
                      Width="180" Margin="0,0,12,0" />

            <ComboBox ItemsSource="{Binding SortOptions}"
                      SelectedItem="{Binding SelectedSort}"
                      AutomationProperties.Name="Sort order"
                      ToolTip="Sort order"
                      Width="180" Margin="0,0,12,0" />

            <ui:TextBox PlaceholderText="Search projects..."
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                        Width="272" Margin="0,0,12,0" />

            <ui:Button Content="{Binding DensityToggleLabel}" FontSize="12" Padding="8,6"
                       Icon="{ui:SymbolIcon ArrowAutofitHeight24}"
                       Command="{Binding ToggleDensityCommand}"
                       ToolTip="Switch card density"
                       AutomationProperties.Name="{Binding DensityToggleLabel, StringFormat='Switch cards to {0} density'}"
                       Width="140" />

            <!-- Reload over a rendered grid reports itself here; replacing the body with a
                 spinner would discard the scroll position and the focused card. -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0"
                        Visibility="{Binding ShowRefreshing, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" VerticalAlignment="Center" />
                <TextBlock Text="Refreshing…" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </StackPanel>

        <!-- Loading: distinct from every empty state below -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding ShowLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ui:ProgressRing IsIndeterminate="True" Width="32" Height="32" HorizontalAlignment="Center" />
            <TextBlock Text="Scanning for projects…" FontSize="15" Margin="0,12,0,0"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Faulted scan with nothing cached: the banner carries the reason, the body says
             why it is empty rather than rendering as a blank page. -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480"
                    Visibility="{Binding ShowScanFailed, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ui:SymbolIcon Symbol="ErrorCircle24" FontSize="30" HorizontalAlignment="Center"
                           Foreground="{StaticResource StatusBadFg}" />
            <TextBlock Text="That scan didn't finish" FontSize="16" FontWeight="SemiBold"
                       Margin="0,10,0,0" HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock Text="Nothing was discovered, so there are no projects to show."
                       FontSize="13" Margin="0,6,0,0" HorizontalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                <ui:Button Content="Scan again" Appearance="Primary" FontSize="12" Padding="12,6"
                           Command="{Binding ForceRefreshCommand}" Margin="0,0,8,0" />
                <ui:Button Content="Open Settings" FontSize="12" Padding="12,6"
                           Command="{Binding OpenSettingsCommand}" />
            </StackPanel>
        </StackPanel>

        <!-- Configured root does not exist: a different fault from an empty one -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520"
                    Visibility="{Binding ShowRootMissing, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ui:SymbolIcon Symbol="FolderProhibited24" FontSize="34" HorizontalAlignment="Center"
                           Foreground="{StaticResource StatusBadFg}" />
            <TextBlock Text="That projects folder isn't there" FontSize="17" FontWeight="SemiBold"
                       Margin="0,12,0,0" HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock Text="{Binding ConfiguredRootPath}" FontSize="12" Margin="0,6,0,0"
                       FontFamily="Cascadia Code,Consolas" TextWrapping="Wrap"
                       HorizontalAlignment="Center" TextAlignment="Center"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            <TextBlock Text="The drive may be disconnected, or the folder moved."
                       FontSize="13" Margin="0,6,0,0" HorizontalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                <ui:Button Content="Change projects folder" Appearance="Primary" FontSize="12" Padding="12,6"
                           Command="{Binding OpenSettingsCommand}" Margin="0,0,8,0" />
                <ui:Button Content="Scan again" FontSize="12" Padding="12,6"
                           Command="{Binding ForceRefreshCommand}" />
            </StackPanel>
        </StackPanel>

        <!-- Root exists but holds no repositories -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520"
                    Visibility="{Binding ShowEmptyRoot, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ui:SymbolIcon Symbol="FolderOpen24" FontSize="34" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            <TextBlock Text="No git repositories here yet" FontSize="17" FontWeight="SemiBold"
                       Margin="0,12,0,0" HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock Text="{Binding ConfiguredRootPath}" FontSize="12" Margin="0,6,0,0"
                       FontFamily="Cascadia Code,Consolas" TextWrapping="Wrap"
                       HorizontalAlignment="Center" TextAlignment="Center"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            <TextBlock Text="Start a project, clone one, or point the dashboard at a different folder."
                       FontSize="13" Margin="0,6,0,0" HorizontalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                <ui:Button Content="New project" Appearance="Primary" FontSize="12" Padding="12,6"
                           Icon="{ui:SymbolIcon Add24}"
                           Command="{Binding NewProjectCommand}" Margin="0,0,8,0" />
                <ui:Button Content="Clone a repository" FontSize="12" Padding="12,6"
                           Icon="{ui:SymbolIcon CloudArrowDown24}"
                           Command="{Binding CloneRepoCommand}" Margin="0,0,8,0" />
                <ui:Button Content="Change projects folder" FontSize="12" Padding="12,6"
                           Command="{Binding OpenSettingsCommand}" />
            </StackPanel>
        </StackPanel>

        <!-- Projects exist; the current filter/search matches none of them -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480"
                    Visibility="{Binding ShowNoMatches, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ui:SymbolIcon Symbol="SearchInfo24" FontSize="30" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            <TextBlock Text="No projects match this view" FontSize="16" FontWeight="SemiBold"
                       Margin="0,10,0,0" HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <ui:Button Content="Clear filters" FontSize="12" Padding="12,6" Margin="0,12,0,0"
                       HorizontalAlignment="Center"
                       Command="{Binding SetFilterCommand}" CommandParameter="all" />
        </StackPanel>

        <!-- Card grid -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding ShowCards, Converter={StaticResource BooleanToVisibilityConverter}}"
                      PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
            <!-- TabNavigation Once: the card Border carries its own Local scope, so Tab
                 walks the focused card's actions and then leaves the grid. Local here
                 instead costs a stop per card plus three per card's buttons, which puts
                 anything below a large grid out of reach. -->
            <ItemsControl ItemsSource="{Binding FilteredProjects}"
                          KeyboardNavigation.TabNavigation="Once"
                          KeyboardNavigation.DirectionalNavigation="Cycle">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:ProjectInfo}">
                        <Border Width="320" Margin="8"
                                MinHeight="{Binding DataContext.CardMinHeight, RelativeSource={RelativeSource AncestorType=Page}}"
                                Padding="{Binding DataContext.CardPadding, RelativeSource={RelativeSource AncestorType=Page}}"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Cursor="Hand"
                                Focusable="True"
                                FocusVisualStyle="{StaticResource FocusRing}"
                                KeyboardNavigation.TabNavigation="Local"
                                AutomationProperties.Name="{Binding DisplayName}">
                            <Border.Tag>
                                <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Page}" />
                            </Border.Tag>
                            <Border.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="Clone"
                                              Command="{Binding Tag.CloneRemoteOnlyCommand}"
                                              CommandParameter="{Binding DataContext}">
                                        <MenuItem.Style>
                                            <Style TargetType="MenuItem">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.IsRemoteOnly}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </MenuItem.Style>
                                    </MenuItem>
                                    <MenuItem Header="Open Details"
                                              Command="{Binding Tag.OpenProjectCommand}"
                                              CommandParameter="{Binding DataContext}">
                                        <MenuItem.Style>
                                            <Style TargetType="MenuItem">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.IsRemoteOnly}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </MenuItem.Style>
                                    </MenuItem>
                                    <MenuItem Header="Refresh Status"
                                              Command="{Binding Tag.RefreshSingleCommand}"
                                              CommandParameter="{Binding DataContext}">
                                        <MenuItem.Style>
                                            <Style TargetType="MenuItem">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.IsRemoteOnly}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </MenuItem.Style>
                                    </MenuItem>
                                    <!-- Pin/Unpin key on the repo path, which a remote-only card has none of. -->
                                    <MenuItem Header="Pin to Top"
                                              Command="{Binding Tag.TogglePinCommand}"
                                              CommandParameter="{Binding DataContext}">
                                        <MenuItem.Style>
                                            <Style TargetType="MenuItem">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.IsPinned}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DataContext.IsRemoteOnly}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </MenuItem.Style>
                                    </MenuItem>
                                    <MenuItem Header="Unpin"
                                              Command="{Binding Tag.TogglePinCommand}"
                                              CommandParameter="{Binding DataContext}">
                                        <MenuItem.Style>
                                            <Style TargetType="MenuItem">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.IsPinned}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </MenuItem.Style>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="Fetch"
                                              Command="{Binding Tag.FetchProjectCommand}"
                                              CommandParameter="{Binding DataContext}">
                                        <MenuItem.Style>
                                            <Style TargetType="MenuItem">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.IsRemoteOnly}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </MenuItem.Style>
                                    </MenuItem>
                                    <MenuItem Header="Pull"
                                              Command="{Binding Tag.PullProjectCommand}"
                                              CommandParameter="{Binding DataContext}">
                                        <MenuItem.Style>
                                            <Style TargetType="MenuItem">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.IsRemoteOnly}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </MenuItem.Style>
                                    </MenuItem>
                                    <MenuItem Header="Push"
                                              Command="{Binding Tag.PushProjectCommand}"
                                              CommandParameter="{Binding DataContext}">
                                        <MenuItem.Style>
                                            <Style TargetType="MenuItem">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.IsRemoteOnly}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </MenuItem.Style>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="Open on GitHub"
                                              Command="{Binding Tag.OpenGitHubCommand}"
                                              CommandParameter="{Binding DataContext}" />
                                    <MenuItem Header="Open Issues on GitHub"
                                              Command="{Binding Tag.OpenIssuesCommand}"
                                              CommandParameter="{Binding DataContext}" />
                                    <MenuItem Header="Open Pull Requests on GitHub"
                                              Command="{Binding Tag.OpenPullRequestsCommand}"
                                              CommandParameter="{Binding DataContext}" />
                                    <MenuItem Header="Open Folder"
                                              Command="{Binding Tag.OpenFolderCommand}"
                                              CommandParameter="{Binding DataContext}">
                                        <MenuItem.Style>
                                            <Style TargetType="MenuItem">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.IsRemoteOnly}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </MenuItem.Style>
                                    </MenuItem>
                                    <MenuItem Header="Open in Terminal"
                                              Command="{Binding Tag.OpenTerminalCommand}"
                                              CommandParameter="{Binding DataContext}">
                                        <MenuItem.Style>
                                            <Style TargetType="MenuItem">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.IsRemoteOnly}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </MenuItem.Style>
                                    </MenuItem>
                                    <MenuItem Header="Copy Path"
                                              Command="{Binding Tag.CopyPathCommand}"
                                              CommandParameter="{Binding DataContext}">
                                        <MenuItem.Style>
                                            <Style TargetType="MenuItem">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.IsRemoteOnly}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </MenuItem.Style>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="Report a Bug"
                                              Command="{Binding Tag.ReportBugCommand}"
                                              CommandParameter="{Binding DataContext}" />
                                    <MenuItem Header="Request a Feature"
                                              Command="{Binding Tag.RequestFeatureCommand}"
                                              CommandParameter="{Binding DataContext}" />
                                    <!-- Hide/Unhide work on the excluded-directories list, which cannot
                                         apply to a repo with no local directory: collapse the whole
                                         group (separator included) for remote-only cards. -->
                                    <Separator>
                                        <Separator.Style>
                                            <Style TargetType="Separator">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.IsRemoteOnly}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Separator.Style>
                                    </Separator>
                                    <MenuItem Header="Hide Project"
                                              Command="{Binding Tag.HideProjectCommand}"
                                              CommandParameter="{Binding DataContext}">
                                        <MenuItem.Style>
                                            <Style TargetType="MenuItem">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.IsHidden}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DataContext.IsRemoteOnly}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </MenuItem.Style>
                                    </MenuItem>
                                    <MenuItem Header="Unhide Project"
                                              Command="{Binding Tag.UnhideProjectCommand}"
                                              CommandParameter="{Binding DataContext}">
                                        <MenuItem.Style>
                                            <Style TargetType="MenuItem">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.IsHidden}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </MenuItem.Style>
                                    </MenuItem>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.OpenProjectCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                              CommandParameter="{Binding}" />
                                <KeyBinding Key="Enter"
                                            Command="{Binding DataContext.OpenProjectCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}" />
                                <KeyBinding Key="Space"
                                            Command="{Binding DataContext.OpenProjectCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}" />
                            </Border.InputBindings>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Display Name + pin marker -->
                                <DockPanel Grid.Row="0">
                                    <ui:SymbolIcon DockPanel.Dock="Right" Symbol="Pin24" FontSize="14"
                                                   VerticalAlignment="Center" Margin="6,0,0,0"
                                                   ToolTip="Pinned to the top of the grid"
                                                   Foreground="{StaticResource StatusInfoFg}"
                                                   Visibility="{Binding IsPinned, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBlock Text="{Binding DisplayName}"
                                               FontWeight="Bold" FontSize="14"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </DockPanel>

                                <!-- Version + Status -->
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock FontSize="12" Margin="0,0,10,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding LatestVersion}" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LatestVersion}" Value="">
                                                        <Setter Property="Text" Value="no version" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Border CornerRadius="4" Padding="6,2">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource StatusGoodBg}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Manifest.Status}" Value="maintenance">
                                                        <Setter Property="Background" Value="{StaticResource StatusWarnBg}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Manifest.Status}" Value="archived">
                                                        <Setter Property="Background" Value="{StaticResource StatusNeutralBg}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Manifest.Status}" Value="experimental">
                                                        <Setter Property="Background" Value="{StaticResource StatusPrivateBg}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Manifest.Status}" FontSize="10">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource StatusGoodFg}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Manifest.Status}" Value="maintenance">
                                                            <Setter Property="Foreground" Value="{StaticResource StatusWarnFg}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Manifest.Status}" Value="archived">
                                                            <Setter Property="Foreground" Value="{StaticResource StatusNeutralFg}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Manifest.Status}" Value="experimental">
                                                            <Setter Property="Foreground" Value="{StaticResource StatusPrivateFg}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>

                                <!-- Sync status + note prefix icons -->
                                <DockPanel Grid.Row="2" Margin="0,6,0,0">
                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                        <ui:SymbolIcon FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center">
                                            <ui:SymbolIcon.Style>
                                                <Style TargetType="ui:SymbolIcon">
                                                    <Setter Property="Symbol" Value="CheckmarkCircle24" />
                                                    <Setter Property="Foreground" Value="{StaticResource StatusGoodFg}" />
                                                    <!-- Later triggers win: uncommitted work is the actionable
                                                         state and must not be masked by a missing remote. -->
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding GitStatus.RemoteUrl}" Value="">
                                                            <Setter Property="Symbol" Value="CloudOff24" />
                                                            <Setter Property="Foreground" Value="{StaticResource StatusBadFg}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding GitStatus.IsDirty}" Value="True">
                                                            <Setter Property="Symbol" Value="Edit24" />
                                                            <Setter Property="Foreground" Value="{StaticResource StatusWarnFg}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding GitStatus.NeedsAttention}" Value="True">
                                                            <Setter Property="Symbol" Value="Warning24" />
                                                            <Setter Property="Foreground" Value="{StaticResource StatusBadFg}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding GitStatus.HasError}" Value="True">
                                                            <Setter Property="Symbol" Value="QuestionCircle24" />
                                                            <Setter Property="Foreground" Value="{StaticResource StatusNeutralFg}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsRemoteOnly}" Value="True">
                                                            <Setter Property="Symbol" Value="CloudArrowDown24" />
                                                            <Setter Property="Foreground" Value="{StaticResource StatusInfoFg}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:SymbolIcon.Style>
                                        </ui:SymbolIcon>
                                        <!-- Deep link: the working-tree summary opens the Changes tab. -->
                                        <TextBlock FontSize="12" Cursor="Hand"
                                                   ToolTip="Open the Changes tab"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                            <TextBlock.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                              Command="{Binding Tag.OpenChangesTabCommand, RelativeSource={RelativeSource AncestorType=Border}}"
                                                              CommandParameter="{Binding}" />
                                            </TextBlock.InputBindings>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Synced" />
                                                    <!-- Later triggers win. A dirty repo with no remote reports
                                                         both; "No remote" alone hid the uncommitted count. -->
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding GitStatus.RemoteUrl}" Value="">
                                                            <Setter Property="Text" Value="No remote" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding GitStatus.IsDirty}" Value="True">
                                                            <Setter Property="Text"
                                                                    Value="{Binding GitStatus.TotalChanges, StringFormat='{}{0} uncommitted'}" />
                                                        </DataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding GitStatus.IsDirty}" Value="True" />
                                                                <Condition Binding="{Binding GitStatus.RemoteUrl}" Value="" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Text"
                                                                    Value="{Binding GitStatus.TotalChanges, StringFormat='{}{0} uncommitted · no remote'}" />
                                                        </MultiDataTrigger>
                                                        <DataTrigger Binding="{Binding GitStatus.NeedsAttention}" Value="True">
                                                            <Setter Property="Text" Value="{Binding GitStatus.AttentionLabel}" />
                                                            <Setter Property="Foreground" Value="{StaticResource StatusBadFg}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding GitStatus.HasError}" Value="True">
                                                            <Setter Property="Text" Value="status unavailable" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsRemoteOnly}" Value="True">
                                                            <Setter Property="Text" Value="Not cloned — click to clone" />
                                                            <Setter Property="Foreground" Value="{StaticResource StatusInfoFg}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <!-- Current branch + divergence; deep link to the Branches tab -->
                                        <TextBlock FontSize="11" FontFamily="Cascadia Code,Consolas" Margin="8,0,0,0"
                                                   VerticalAlignment="Center" Cursor="Hand"
                                                   ToolTip="Open the Branches tab"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                            <TextBlock.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                              Command="{Binding Tag.OpenBranchesTabCommand, RelativeSource={RelativeSource AncestorType=Border}}"
                                                              CommandParameter="{Binding}" />
                                            </TextBlock.InputBindings>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding GitStatus.Branch}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding GitStatus.Branch}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding GitStatus.IsDetached}" Value="True">
                                                            <Setter Property="Text" Value="detached" />
                                                            <Setter Property="Foreground" Value="{StaticResource StatusWarnFg}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"
                                                   Text="{Binding GitStatus.AheadBehindLabel}"
                                                   Cursor="Hand" ToolTip="Open the Branches tab"
                                                   Foreground="{StaticResource StatusInfoFg}">
                                            <TextBlock.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                              Command="{Binding Tag.OpenBranchesTabCommand, RelativeSource={RelativeSource AncestorType=Border}}"
                                                              CommandParameter="{Binding}" />
                                            </TextBlock.InputBindings>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Note prefix icons (right-justified) -->
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <!-- TASK icon + count -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center"
                                                    ToolTip="{Binding TaskCount, StringFormat='{}{0} task(s)'}">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TaskCount}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <ui:SymbolIcon Symbol="CheckboxUnchecked24" FontSize="14" Foreground="{StaticResource StatusInfoFg}" />
                                            <TextBlock Text="{Binding TaskCount}" FontSize="11" Foreground="{StaticResource StatusInfoFg}"
                                                       Margin="2,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <!-- BUG icon + count -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center"
                                                    ToolTip="{Binding BugCount, StringFormat='{}{0} bug(s)'}">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding BugCount}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <ui:SymbolIcon Symbol="Bug24" FontSize="14" Foreground="{StaticResource StatusBadFg}" />
                                            <TextBlock Text="{Binding BugCount}" FontSize="11" Foreground="{StaticResource StatusBadFg}"
                                                       Margin="2,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <!-- WAIT icon + count -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                    ToolTip="{Binding WaitCount, StringFormat='{}{0} waiting'}">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding WaitCount}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <ui:SymbolIcon Symbol="Clock24" FontSize="14" Foreground="#E8A317" />
                                            <TextBlock Text="{Binding WaitCount}" FontSize="11" Foreground="#E8A317"
                                                       Margin="2,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>

                                <!-- Category + Type + Validation + Visibility badges -->
                                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,6,0,0">
                                    <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                            CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding Manifest.Category}" FontSize="10"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                    <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                            CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding Manifest.ProjectType}" FontSize="10"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                    <Border CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Setter Property="Background" Value="{StaticResource StatusInfoBg}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Manifest.ValidationSchedule}" Value="none">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Manifest.ValidationSchedule}" Value="daily">
                                                        <Setter Property="Background" Value="{StaticResource StatusBadBg}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Manifest.ValidationSchedule}" FontSize="10">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource StatusInfoFg}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Manifest.ValidationSchedule}" Value="daily">
                                                            <Setter Property="Foreground" Value="{StaticResource StatusBadFg}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <!-- Visibility badge: GitHub-native glyph + tonal chip -->
                                    <Border CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource StatusGoodBg}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding GitStatus.Visibility}" Value="private">
                                                        <Setter Property="Background" Value="{StaticResource StatusPrivateBg}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding GitStatus.Visibility}" Value="local">
                                                        <Setter Property="Background" Value="{StaticResource StatusBadBg}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding GitStatus.Visibility}" Value="remote">
                                                        <Setter Property="Background" Value="{StaticResource StatusInfoBg}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding GitStatus.Visibility}" Value="unknown">
                                                        <Setter Property="Background" Value="{StaticResource StatusNeutralBg}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon FontSize="11" Margin="0,0,3,0" VerticalAlignment="Center">
                                                <ui:SymbolIcon.Style>
                                                    <Style TargetType="ui:SymbolIcon">
                                                        <Setter Property="Symbol" Value="Globe24" />
                                                        <Setter Property="Foreground" Value="{StaticResource StatusGoodFg}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding GitStatus.Visibility}" Value="private">
                                                                <Setter Property="Symbol" Value="LockClosed24" />
                                                                <Setter Property="Foreground" Value="{StaticResource StatusPrivateFg}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding GitStatus.Visibility}" Value="local">
                                                                <Setter Property="Symbol" Value="Desktop24" />
                                                                <Setter Property="Foreground" Value="{StaticResource StatusBadFg}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding GitStatus.Visibility}" Value="remote">
                                                                <Setter Property="Symbol" Value="Cloud24" />
                                                                <Setter Property="Foreground" Value="{StaticResource StatusInfoFg}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding GitStatus.Visibility}" Value="unknown">
                                                                <Setter Property="Symbol" Value="QuestionCircle24" />
                                                                <Setter Property="Foreground" Value="{StaticResource StatusNeutralFg}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:SymbolIcon.Style>
                                            </ui:SymbolIcon>
                                            <TextBlock Text="{Binding GitStatus.Visibility}" FontSize="10" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource StatusGoodFg}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding GitStatus.Visibility}" Value="private">
                                                                <Setter Property="Foreground" Value="{StaticResource StatusPrivateFg}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding GitStatus.Visibility}" Value="local">
                                                                <Setter Property="Foreground" Value="{StaticResource StatusBadFg}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding GitStatus.Visibility}" Value="remote">
                                                                <Setter Property="Foreground" Value="{StaticResource StatusInfoFg}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding GitStatus.Visibility}" Value="unknown">
                                                                <Setter Property="Foreground" Value="{StaticResource StatusNeutralFg}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Description (from manifest, replaces notes on card) -->
                                <TextBlock Grid.Row="4" Margin="0,6,0,0" FontSize="11"
                                           TextWrapping="Wrap" MaxHeight="32"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Text="{Binding Manifest.Description}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Manifest.Description}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Bottom row: last commit + issues -->
                                <DockPanel Grid.Row="5" Margin="0,6,0,0">
                                    <TextBlock DockPanel.Dock="Left" FontSize="11"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Text="{Binding GitStatus.LastCommitDate, Converter={StaticResource RelativeTimeConverter}}" />

                                    <TextBlock DockPanel.Dock="Right" FontSize="11"
                                               HorizontalAlignment="Right"
                                               Foreground="#E8A317"
                                               Cursor="Hand"
                                               ToolTip="Open the Issues tab">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding OpenIssueCount}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding OpenIssueCount}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="TextDecorations" Value="Underline" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                        <TextBlock.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding Tag.OpenIssuesTabCommand, RelativeSource={RelativeSource AncestorType=Border}}"
                                                          CommandParameter="{Binding}" />
                                        </TextBlock.InputBindings>
                                        <Run Text="{Binding OpenIssueCount, Mode=OneWay}" />
                                        <Run Text=" issues" />
                                    </TextBlock>

                                    <TextBlock DockPanel.Dock="Right" FontSize="11"
                                               HorizontalAlignment="Right"
                                               Margin="0,0,10,0"
                                               Foreground="{StaticResource StatusInfoFg}"
                                               Cursor="Hand"
                                               ToolTip="Open the Pull Requests tab">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding OpenPrCount}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding OpenPrCount}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="TextDecorations" Value="Underline" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                        <TextBlock.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding Tag.OpenPullRequestsTabCommand, RelativeSource={RelativeSource AncestorType=Border}}"
                                                          CommandParameter="{Binding}" />
                                        </TextBlock.InputBindings>
                                        <Run Text="{Binding OpenPrCount, Mode=OneWay}" />
                                        <Run Text=" PRs" />
                                    </TextBlock>
                                </DockPanel>

                                <!-- Quick actions: revealed on hover, and again whenever one of them
                                     takes keyboard focus — Opacity 0 keeps them in the card's tab
                                     order, where Visibility Collapsed would remove them from it.
                                     DirectionalNavigation None keeps these buttons out of the grid's
                                     arrow-key scope, where they would be the nearest target in every
                                     direction and card-to-card arrows would never fire. -->
                                <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,8,0,0"
                                            HorizontalAlignment="Left"
                                            KeyboardNavigation.DirectionalNavigation="None">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Opacity" Value="0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRemoteOnly}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                                    <Setter Property="Opacity" Value="1" />
                                                </DataTrigger>
                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                    <Setter Property="Opacity" Value="1" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <ui:Button Content="Fetch" FontSize="11" Padding="8,3" Margin="0,0,6,0"
                                               Icon="{ui:SymbolIcon ArrowDownload24}"
                                               ToolTip="Fetch this repository"
                                               AutomationProperties.Name="{Binding DisplayName, StringFormat='Fetch {0}'}"
                                               Command="{Binding Tag.FetchProjectCommand, RelativeSource={RelativeSource AncestorType=Border}}"
                                               CommandParameter="{Binding}" />
                                    <ui:Button Content="Pull" FontSize="11" Padding="8,3" Margin="0,0,6,0"
                                               Icon="{ui:SymbolIcon ArrowSync24}"
                                               ToolTip="Fetch, then fast-forward this repository"
                                               AutomationProperties.Name="{Binding DisplayName, StringFormat='Pull {0}'}"
                                               Command="{Binding Tag.PullProjectCommand, RelativeSource={RelativeSource AncestorType=Border}}"
                                               CommandParameter="{Binding}" />
                                    <ui:Button Content="Push" FontSize="11" Padding="8,3"
                                               Icon="{ui:SymbolIcon ArrowUpload24}"
                                               ToolTip="Fetch, then push this repository"
                                               AutomationProperties.Name="{Binding DisplayName, StringFormat='Push {0}'}"
                                               Command="{Binding Tag.PushProjectCommand, RelativeSource={RelativeSource AncestorType=Border}}"
                                               CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        </Grid>
    </DockPanel>
</Page>
