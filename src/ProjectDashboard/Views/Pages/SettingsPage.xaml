<Page
    x:Class="ProjectDashboard.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:helpers="clr-namespace:ProjectDashboard.Helpers"
    xmlns:vm="clr-namespace:ProjectDashboard.ViewModels.Pages">

    <Page.Resources>
        <helpers:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
        <helpers:HasNonWhitespaceTextConverter x:Key="HasNonWhitespaceTextConverter" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" VerticalAlignment="Top" MaxWidth="600" HorizontalAlignment="Left">
            <TextBlock Text="Settings" FontSize="24" Margin="0,0,0,24"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

            <!-- Theme -->
            <TextBlock Text="Theme" FontSize="16" Margin="0,0,0,12"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <RadioButton Content="Light" Margin="0,0,0,8"
                         IsChecked="{Binding CurrentTheme, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Light}"
                         Command="{Binding ChangeThemeCommand}"
                         CommandParameter="Light" />
            <RadioButton Content="Dark" Margin="0,0,0,24"
                         IsChecked="{Binding CurrentTheme, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Dark}"
                         Command="{Binding ChangeThemeCommand}"
                         CommandParameter="Dark" />

            <!-- Projects Folders -->
            <TextBlock Text="Projects Folders" FontSize="16" Margin="0,0,0,4"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock Text="Every folder listed here is scanned, in this order. Order decides which folder wins when two hold a repository of the same name. Saving rescans straight away; a rescan waits if a repository operation is running, and starts when it finishes."
                       FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

            <ItemsControl ItemsSource="{Binding ProjectRoots}" Margin="0,0,0,8"
                          AutomationProperties.Name="Projects folders">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                            <StackPanel>
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Enabled}"
                                              Margin="0,0,8,0" VerticalAlignment="Center"
                                              AutomationProperties.Name="Scan this projects folder" />
                                    <ui:Button DockPanel.Dock="Right" Content="Remove" FontSize="12" Padding="8,4"
                                               Margin="4,0,0,0"
                                               AutomationProperties.Name="Remove this projects folder"
                                               Command="{Binding DataContext.RemoveRootCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               CommandParameter="{Binding}" />
                                    <ui:Button DockPanel.Dock="Right" Content="Down" FontSize="12" Padding="8,4"
                                               Margin="4,0,0,0"
                                               AutomationProperties.Name="Move this projects folder down"
                                               Command="{Binding DataContext.MoveRootDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               CommandParameter="{Binding}" />
                                    <ui:Button DockPanel.Dock="Right" Content="Up" FontSize="12" Padding="8,4"
                                               Margin="4,0,0,0"
                                               AutomationProperties.Name="Move this projects folder up"
                                               Command="{Binding DataContext.MoveRootUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               CommandParameter="{Binding}" />
                                    <ui:Button DockPanel.Dock="Right" Content="Browse" FontSize="12" Padding="8,4"
                                               Margin="8,0,0,0"
                                               AutomationProperties.Name="Browse for this projects folder"
                                               Command="{Binding DataContext.BrowseRootFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               CommandParameter="{Binding}" />
                                    <ui:TextBox Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}"
                                                AutomationProperties.Name="Projects folder path"
                                                PlaceholderText="C:\projects" />
                                </DockPanel>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBox Grid.Column="0"
                                                Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                                                AutomationProperties.Name="Name for this projects folder"
                                                PlaceholderText="Name (optional — the folder name is used when blank)" />
                                    <ComboBox Grid.Column="1" Margin="8,0,0,0" Width="160"
                                              ItemsSource="{Binding DepthChoices}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding ScanDepth}"
                                              AutomationProperties.Name="How deep to scan this projects folder" />
                                </Grid>

                                <ui:TextBox Margin="0,8,0,0"
                                            Text="{Binding ExcludedDirectories, UpdateSourceTrigger=PropertyChanged}"
                                            AutomationProperties.Name="Folders to skip under this projects folder"
                                            PlaceholderText="Skip: Internal, games, clients\archive" />

                                <DockPanel Margin="0,8,0,0">
                                    <RadioButton DockPanel.Dock="Left" GroupName="DefaultProjectsRoot"
                                                 IsChecked="{Binding IsDefault}"
                                                 Content="New projects and clones go here"
                                                 FontSize="12" VerticalAlignment="Center"
                                                 AutomationProperties.Name="Put new projects and clones in this folder"
                                                 Command="{Binding DataContext.MakeDefaultRootCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                 CommandParameter="{Binding}" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Status}"
                                               FontSize="12" VerticalAlignment="Center" TextAlignment="Right"
                                               AutomationProperties.LiveSetting="Polite"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Scanning stops at each repository and does not look inside it. Under &quot;Skip&quot;, a plain name is skipped wherever it appears; an entry with a backslash is one place under this folder."
                       FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                <ui:Button Content="Add a projects folder"
                           Icon="{ui:SymbolIcon FolderAdd24}"
                           AutomationProperties.Name="Add a projects folder"
                           Command="{Binding AddRootCommand}" />
                <TextBlock Text="{Binding RootsStatus}"
                           AutomationProperties.LiveSetting="Polite" FontSize="12" TextWrapping="Wrap"
                           MaxWidth="400"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>

            <!-- Project metadata: what is stored, and the records naming folders that are gone.
                 Forgetting is the only deletion in this feature and it happens here, by hand. -->
            <TextBlock Text="Project Metadata" FontSize="16" Margin="0,0,0,4"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock Text="Descriptions, categories, statuses and notes are kept outside your repositories, so nothing is ever written into them. A repository that moves or is renamed is recognised on the next scan and its metadata moves with it."
                       FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            <TextBlock Text="{Binding MetadataSummary}" FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap"
                       AutomationProperties.AutomationId="SettingsMetadataSummary"
                       AutomationProperties.LiveSetting="Polite"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <ItemsControl ItemsSource="{Binding MetadataOrphans}" Margin="0,0,0,8"
                          AutomationProperties.Name="Saved metadata for folders that are no longer there">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                            <DockPanel>
                                <ui:Button DockPanel.Dock="Right" Content="Forget" FontSize="12" Padding="8,4"
                                           Margin="8,0,0,0" VerticalAlignment="Center"
                                           AutomationProperties.Name="Forget the saved metadata for this folder"
                                           Command="{Binding DataContext.ForgetMetadataCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                           CommandParameter="{Binding}" />
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="13"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{Binding Path}" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap"
                                               Visibility="{Binding Description, Converter={StaticResource HasNonWhitespaceTextConverter}}"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="{Binding LastSeen}" FontSize="12"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                <ui:Button Content="Forget all of these"
                           Icon="{ui:SymbolIcon Delete24}"
                           AutomationProperties.Name="Forget every saved record for folders that are no longer there"
                           Visibility="{Binding HasMetadataOrphans, Converter={StaticResource BooleanToVisibilityConverter}}"
                           Command="{Binding ForgetAllMetadataCommand}" />
                <TextBlock Text="{Binding MetadataStatus}"
                           AutomationProperties.LiveSetting="Polite" FontSize="12" TextWrapping="Wrap"
                           MaxWidth="400"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>

            <!-- Refresh Interval -->
            <TextBlock Text="Refresh Interval (seconds)" FontSize="16" Margin="0,0,0,4"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock Text="How often the dashboard reconciles every repository. Minimum 30 seconds; saving retunes the running timer."
                       FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                <ui:TextBox Text="{Binding RefreshIntervalSeconds, UpdateSourceTrigger=PropertyChanged}"
                            AutomationProperties.Name="Refresh interval in seconds"
                            PlaceholderText="300"
                            Width="150" />
                <ui:Button Content="Sync Now"
                           Icon="{ui:SymbolIcon ArrowSync24}"
                           Command="{Binding ForceSyncCommand}"
                           Margin="8,0,0,0" />
                <TextBlock Text="{Binding SyncStatus}"
                           AutomationProperties.LiveSetting="Polite" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>

            <!-- Save -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:Button Grid.Column="0"
                           Content="Save Settings"
                           Appearance="Primary"
                           Command="{Binding SaveSettingsCommand}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding SaveStatus}"
                           AutomationProperties.LiveSetting="Polite" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" Margin="12,0,0,0" />
            </Grid>

            <!-- GitHub Status -->
            <TextBlock Text="GitHub CLI Status" FontSize="16" Margin="0,0,0,8"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <ui:SymbolIcon FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center">
                    <ui:SymbolIcon.Style>
                        <Style TargetType="ui:SymbolIcon">
                            <Setter Property="Symbol" Value="PlugDisconnected24" />
                            <Setter Property="Foreground" Value="{DynamicResource StatusWarnFg}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding GitHubStatus}" Value="Signed in">
                                    <Setter Property="Symbol" Value="PlugConnected24" />
                                    <Setter Property="Foreground" Value="{DynamicResource StatusGoodFg}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding GitHubStatus}" Value="GitHub CLI not found">
                                    <Setter Property="Foreground" Value="{DynamicResource StatusBadFg}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:SymbolIcon.Style>
                </ui:SymbolIcon>
                <TextBlock Text="{Binding GitHubStatus}"
                           FontSize="14" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ui:Button Content="Re-check" FontSize="12" Padding="8,4"
                           Command="{Binding RecheckGitHubCommand}"
                           Margin="12,0,0,0" />
            </StackPanel>
            <TextBlock FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Text="Repos show as &quot;local&quot; until gh is found and signed in (run: gh auth login). gh is delegated to for auth — the app never reads or stores your token. If gh is installed but not detected when launched from the Start Menu, point to gh.exe below." />
            <DockPanel Margin="0,0,0,24">
                <ui:Button DockPanel.Dock="Right"
                           Content="Browse"
                           Command="{Binding BrowseGhCommand}"
                           AutomationProperties.Name="Browse for the GitHub CLI executable"
                           Margin="8,0,0,0" />
                <ui:TextBox Text="{Binding GhPath, UpdateSourceTrigger=PropertyChanged}"
                            AutomationProperties.Name="Path to the GitHub CLI executable"
                            PlaceholderText="Auto-detect (leave blank to use PATH)" />
            </DockPanel>

            <!-- GitHub discovery -->
            <TextBlock Text="GitHub Discovery" FontSize="16" Margin="0,24,0,4"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <CheckBox Content="Show my GitHub repos that aren't cloned locally (Cloud cards)"
                      IsChecked="{Binding EnableGitHubDiscovery}"
                      Margin="0,0,0,4" />
            <TextBlock Text="When on, signed-in GitHub repositories with no local clone appear as Cloud cards you can clone in one click. Requires gh signed in. Saving rescans so the Cloud cards appear or clear immediately."
                       FontSize="12" Margin="0,0,0,16" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            <CheckBox Content="Auto-refresh a repo when its files change on disk"
                      IsChecked="{Binding EnableAutoRefresh}"
                      Margin="0,0,0,4" />
            <TextBlock Text="Watches the projects root and updates a card within a couple of seconds of an edit, commit, or branch switch — no waiting for the refresh interval. Saving starts or stops the watcher straight away."
                       FontSize="12" Margin="0,0,0,24" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

            <!-- Update check -->
            <TextBlock Text="Updates" FontSize="16" Margin="0,24,0,4"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <CheckBox Content="Check for a newer release on launch"
                      IsChecked="{Binding EnableUpdateCheck}"
                      Margin="0,0,0,4"
                      AutomationProperties.Name="Check for a newer release on launch" />
            <TextBlock Text="Once a day at most, the app asks GitHub for this project's latest published release and compares it with this build. It sends no account, repository, or usage data — GitHub sees an address, a time, and the app's name and version, the same as visiting the releases page in a browser. Nothing is downloaded or installed: a newer release shows a dismissible notice on the dashboard with a link to its release page. Off means no request is made at all, on launch or from the button below."
                       FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                <ui:Button Content="Check now"
                           Icon="{ui:SymbolIcon ArrowSync24}"
                           Command="{Binding CheckForUpdatesCommand}"
                           IsEnabled="{Binding EnableUpdateCheck}"
                           AutomationProperties.Name="Check for a newer release now" />
                <TextBlock Text="{Binding UpdateCheckStatus}"
                           AutomationProperties.LiveSetting="Polite" FontSize="12" TextWrapping="Wrap"
                           MaxWidth="420"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>

            <!-- Danger zone opt-in -->
            <TextBlock Text="Danger Zone" FontSize="16" Margin="0,24,0,4"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <CheckBox Content="Show the danger zone on a project's Repo tab"
                      IsChecked="{Binding DangerZoneEnabled}"
                      Margin="0,0,0,4"
                      AutomationProperties.Name="Show the danger zone on a project's Repo tab" />
            <TextBlock Text="Off by default. When on, the Repo tab offers deleting the repository on GitHub — irreversible, and still guarded by typing the full owner/name. Local files are never touched. Takes effect the next time a project page loads."
                       FontSize="12" Margin="0,0,0,24" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

            <!-- About -->
            <TextBlock Text="About" FontSize="16" Margin="0,24,0,8"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <StackPanel>
                <TextBlock FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                    <Run Text="Project Dashboard" FontWeight="SemiBold" />
                    <Run Text="{x:Static vm:SettingsViewModel.AppVersion}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </TextBlock>
                <TextBlock Text="Fluent 2 WPF dashboard for local git repository management"
                           FontSize="12" Margin="0,4,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock FontSize="12" Margin="0,4,0,0"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                    <Run Text="Built with WPF-UI, CommunityToolkit.Mvvm, .NET 10" />
                </TextBlock>
                <TextBlock FontSize="12" Margin="0,4,0,0"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                    <Run Text="Jason Ulbright" />
                </TextBlock>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
