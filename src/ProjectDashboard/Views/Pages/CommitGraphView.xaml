<UserControl
    x:Class="ProjectDashboard.Views.Pages.CommitGraphView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:ProjectDashboard.Views.Controls"
    xmlns:helpers="clr-namespace:ProjectDashboard.Helpers"
    xmlns:models="clr-namespace:ProjectDashboard.Models"
    FontFamily="Segoe UI"
    IsVisibleChanged="OnIsVisibleChanged">

    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommitGraphCommand}" />
    </UserControl.InputBindings>

    <UserControl.Resources>
        <helpers:RelativeTimeConverter x:Key="GraphRelativeTime" />

        <Style x:Key="GraphHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,8" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>

        <!-- Ref chip: coloured by what the decoration IS, so a tag is not mistaken for a branch. -->
        <DataTemplate x:Key="GraphRefTemplate" DataType="{x:Type models:GraphRef}">
            <Border CornerRadius="3" Padding="5,0" Margin="0,0,4,0" VerticalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource StatusNeutralBg}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="LocalBranch">
                                <Setter Property="Background" Value="{StaticResource StatusGoodBg}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="RemoteBranch">
                                <Setter Property="Background" Value="{StaticResource StatusInfoBg}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Tag">
                                <Setter Property="Background" Value="{StaticResource StatusWarnBg}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Head">
                                <Setter Property="Background" Value="{StaticResource StatusPrivateBg}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Name}" FontSize="10" FontFamily="Cascadia Code,Consolas"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <!-- Scrim: opaque enough to read the card against, and it swallows clicks aimed behind it. -->
    <Grid Background="#B0000000">
        <!-- Every navigation mode cycles inside the pane: the scrim stops the mouse but no
             keystroke, and the page's sync buttons sit directly behind it. -->
        <Border MaxWidth="1320" Margin="24" CornerRadius="10"
                KeyboardNavigation.TabNavigation="Cycle"
                KeyboardNavigation.ControlTabNavigation="Cycle"
                KeyboardNavigation.DirectionalNavigation="Cycle"
                Background="{DynamicResource ApplicationBackgroundBrush}"
                BorderBrush="{StaticResource StatusInfoFg}" BorderThickness="1">
            <Grid Margin="24,18,24,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ═══ HEADER ═══ -->
                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <ui:Button DockPanel.Dock="Right" Content="Close" FontSize="12" Padding="12,4"
                               Command="{Binding CloseCommitGraphCommand}"
                               ToolTip="Close the commit graph (Esc)"
                               AutomationProperties.Name="Close the commit graph" />
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="BranchFork24" FontSize="16" VerticalAlignment="Center"
                                           Margin="0,0,8,0" Foreground="{StaticResource StatusInfoFg}" />
                            <TextBlock Text="Commit graph" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding Project.DirectoryName}" FontSize="13" Margin="10,0,0,0"
                                       VerticalAlignment="Bottom" Padding="0,0,0,3"
                                       FontFamily="Cascadia Code,Consolas"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource GraphHint}" Margin="0,2,0,0"
                                   Text="Every commit reachable from a local branch or HEAD, newest first, one column per line of development. Selecting a row selects the same commit in the History list when that list holds it." />
                    </StackPanel>
                </DockPanel>

                <!-- ═══ BODY ═══ -->
                <Grid Grid.Row="1">
                    <Border CornerRadius="6" Padding="12,10" VerticalAlignment="Top"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            Visibility="{Binding GraphEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="This repository has no commits to draw."
                                       FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Style="{StaticResource GraphHint}" Margin="0,6,0,0"
                                       Text="An unborn HEAD — a repository initialised but never committed to — reads this way, and so does an orphan checkout with no other branch." />
                        </StackPanel>
                    </Border>

                    <ListBox x:Name="GraphRowList" ItemsSource="{Binding GraphRows}"
                             SelectedItem="{Binding SelectedGraphRow}"
                             Background="Transparent" HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             AutomationProperties.Name="Commit graph rows">
                        <ListBox.ItemContainerStyle>
                            <!-- The lane cell draws edges to both edges of its band, so the bands
                                 must abut: any vertical padding, margin or border between two rows
                                 breaks every lane line into dashes. Stretch is what gives the cell
                                 the row's full height rather than its text's. -->
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="2,0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="MinHeight" Value="24" />
                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:CommitGraphRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- The lane cell reserves the widest lane count any loaded page
                                         used, so a page that opens a new column does not shift the
                                         rows already drawn. -->
                                    <controls:CommitGraphLanes
                                        Grid.Column="0" Row="{Binding}"
                                        Width="{Binding DataContext.GraphLaneColumnWidth, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        HorizontalAlignment="Left" VerticalAlignment="Stretch" />

                                    <TextBlock Grid.Column="1" Text="{Binding ShortSha}" Margin="8,0,8,0"
                                               VerticalAlignment="Center"
                                               FontFamily="Cascadia Code,Consolas" FontSize="12"
                                               Foreground="{StaticResource StatusInfoFg}" />

                                    <ItemsControl Grid.Column="2" ItemsSource="{Binding Refs}"
                                                  VerticalAlignment="Center" Margin="0,0,6,0"
                                                  ItemTemplate="{StaticResource GraphRefTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>

                                    <TextBlock Grid.Column="3" Text="{Binding Subject}" FontSize="12"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Subject}"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                                    <TextBlock Grid.Column="4" Text="{Binding Author}" Width="140"
                                               VerticalAlignment="Center" Margin="10,0,10,0"
                                               FontSize="11" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Author}"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                                    <TextBlock Grid.Column="5" MinWidth="66" VerticalAlignment="Center"
                                               Text="{Binding Date, Converter={StaticResource GraphRelativeTime}}"
                                               FontSize="11" HorizontalAlignment="Right"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <!-- ═══ FOOTER ═══ -->
                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                    <Border Background="{StaticResource StatusBadBg}" BorderBrush="{StaticResource StatusBadFg}"
                            BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding GraphErrorText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding GraphErrorText}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   AutomationProperties.AutomationId="GraphErrorText" />
                    </Border>

                    <DockPanel>
                        <ui:Button DockPanel.Dock="Left" Content="Load older commits" FontSize="12" Padding="12,4"
                                   Margin="0,0,12,0"
                                   Command="{Binding LoadMoreGraphCommand}"
                                   Visibility="{Binding GraphHasMore, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   AutomationProperties.Name="Draw the next page of the graph" />
                        <TextBlock Text="{Binding GraphStatusText}" FontSize="12" TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   AutomationProperties.AutomationId="GraphStatusText" />
                    </DockPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
