<UserControl
    x:Class="ProjectDashboard.Views.Pages.RewriteWizardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:models="clr-namespace:ProjectDashboard.Models"
    xmlns:vm="clr-namespace:ProjectDashboard.ViewModels.Pages"
    FontFamily="Segoe UI"
    IsVisibleChanged="OnIsVisibleChanged">

    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseRewriteWizardCommand}" />
    </UserControl.InputBindings>

    <UserControl.Resources>
        <Style x:Key="WizardSectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,16,0,6" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="WizardHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,8" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>
        <Style x:Key="WizardChoice" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="WizardField" TargetType="ui:TextBox">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <!-- One scrub check: the verdict word, its sentence, and the evidence behind it. -->
        <DataTemplate x:Key="ScrubVerdictTemplate" DataType="{x:Type vm:ScrubVerdictLine}">
            <Border CornerRadius="6" Padding="12,8" Margin="0,0,0,8"
                    Background="{DynamicResource StatusGoodBg}" BorderThickness="1"
                    BorderBrush="{DynamicResource StatusGoodFg}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Verdict}" Value="OccurrencesRemain">
                                <Setter Property="Background" Value="{DynamicResource StatusBadBg}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource StatusBadFg}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Verdict}" Value="NotVerified">
                                <Setter Property="Background" Value="{DynamicResource StatusBadBg}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource StatusBadFg}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Verdict}" Value="CleanWithinScope">
                                <Setter Property="Background" Value="{DynamicResource StatusWarnBg}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource StatusWarnFg}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="{Binding Headline}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="{Binding Detail}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Visibility="{Binding HasDetail, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="RewriteFactTemplate" DataType="{x:Type vm:RewriteFact}">
            <DockPanel Margin="0,0,0,3">
                <TextBlock DockPanel.Dock="Left" Width="250" Text="{Binding Label}" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{Binding Value}" FontSize="12" TextWrapping="Wrap"
                           FontFamily="Cascadia Code,Consolas"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </DockPanel>
        </DataTemplate>

        <!-- Report block: counters, overall verdict, per-check verdicts, skipped payloads. -->
        <ControlTemplate x:Key="RewriteReportTemplate" TargetType="ContentControl">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding RewriteFacts}" ItemTemplate="{StaticResource RewriteFactTemplate}"
                              AutomationProperties.Name="Rewrite report counters" />

                <TextBlock Text="Verification" Style="{StaticResource WizardSectionHeader}" />
                <!-- The summary line carries the worst verdict of every check, so it is the one
                     row a reader may act on without reading the rest: it draws red whenever the
                     content must not be treated as removed. -->
                <Border CornerRadius="6" Padding="12,8" Margin="0,0,0,10"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderThickness="1" BorderBrush="Transparent">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RewriteOverallVerdict}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RewriteOverallVerdict.IsProblem}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource StatusBadBg}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource StatusBadFg}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RewriteOverallVerdict.Verdict}" Value="CleanWithinScope">
                                    <Setter Property="Background" Value="{DynamicResource StatusWarnBg}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource StatusWarnFg}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RewriteOverallVerdict.ClaimsClean}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource StatusGoodBg}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource StatusGoodFg}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="{Binding RewriteOverallVerdict.Label}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{Binding RewriteOverallVerdict.Headline}" FontSize="12" TextWrapping="Wrap"
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <ItemsControl ItemsSource="{Binding RewriteScrubLines}" ItemTemplate="{StaticResource ScrubVerdictTemplate}"
                              AutomationProperties.Name="Verification results" />

                <TextBlock Text="Payloads the rewrite could not read">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource WizardSectionHeader}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RewriteSkipLines.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ItemsControl ItemsSource="{Binding RewriteSkipLines}"
                              AutomationProperties.Name="Skipped payloads">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,3"
                                       FontFamily="Cascadia Code,Consolas"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ControlTemplate>
    </UserControl.Resources>

    <!-- Scrim: opaque enough to read the card against, and it swallows clicks aimed behind it. -->
    <Grid Background="#B0000000">
        <!-- The scrim stops the mouse but no keystroke. The arrow keys traverse independently of
             Tab, so all three navigation modes cycle: without the directional one an arrow key
             lands on the page header behind the scrim, where Enter fires Fetch, Pull, or Push.
             Cycling also keeps a screen reader inside the surface it is announcing. -->
        <Border MaxWidth="1040" Margin="24" CornerRadius="10"
                KeyboardNavigation.TabNavigation="Cycle"
                KeyboardNavigation.ControlTabNavigation="Cycle"
                KeyboardNavigation.DirectionalNavigation="Cycle"
                Background="{DynamicResource ApplicationBackgroundBrush}"
                BorderBrush="{DynamicResource StatusBadFg}" BorderThickness="1">
            <Grid Margin="24,18,24,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ═══ HEADER ═══ -->
                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <!-- "Close", never "Cancel": the footer's Cancel stops the step in flight, and
                         one word must not mean both. -->
                    <ui:Button DockPanel.Dock="Right" Content="Close" FontSize="12" Padding="12,4"
                               Command="{Binding CloseRewriteWizardCommand}"
                               ToolTip="Close the wizard (Esc)"
                               AutomationProperties.Name="Close the rewrite wizard" />
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="History24" FontSize="16" VerticalAlignment="Center"
                                           Margin="0,0,8,0" Foreground="{DynamicResource StatusBadFg}" />
                            <TextBlock Text="Rewrite history" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding Project.DirectoryName}" FontSize="13" Margin="10,0,0,0"
                                       VerticalAlignment="Bottom" Padding="0,0,0,3"
                                       FontFamily="Cascadia Code,Consolas"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="{Binding RewriteStepTitle}" FontSize="12" Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </DockPanel>

                <!-- ═══ BODY ═══ -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid>

                        <!-- ── STEP 1: OPERATION ── -->
                        <StackPanel Visibility="{Binding RewriteStepIsOperation, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Style="{StaticResource WizardHint}"
                                       Text="Rewriting history replaces every affected commit with a new one. A verified backup is taken before anything is applied, and this app never pushes the result." />

                            <RadioButton x:Name="FirstOperationChoice" GroupName="RewriteOperation" Style="{StaticResource WizardChoice}"
                                         Content="Replace text in file contents"
                                         IsChecked="{Binding RewriteOperationIsReplaceText, Mode=TwoWay}"
                                         AutomationProperties.Name="Operation: replace text in file contents" />
                            <StackPanel Margin="26,4,0,10"
                                        Visibility="{Binding RewriteOperationIsReplaceText, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ui:TextBox Style="{StaticResource WizardField}"
                                            Text="{Binding RewriteFindText, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="Text to find"
                                            AutomationProperties.Name="Text to find in file contents" />
                                <ui:TextBox Style="{StaticResource WizardField}"
                                            Text="{Binding RewriteReplacementText, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="Replacement (leave empty to delete the text)"
                                            AutomationProperties.Name="Replacement for file contents" />
                                <CheckBox Content="Treat the find text as a regular expression" FontSize="12"
                                          IsChecked="{Binding RewriteUseRegex, Mode=TwoWay}"
                                          AutomationProperties.Name="Use a regular expression for file contents" />
                                <TextBlock Style="{StaticResource WizardHint}"
                                           Text="A regular expression only runs over files that decode as UTF-8; anything else is skipped and reported." />
                            </StackPanel>

                            <RadioButton GroupName="RewriteOperation" Style="{StaticResource WizardChoice}"
                                         Content="Remove a file or path from history"
                                         IsChecked="{Binding RewriteOperationIsPurgePath, Mode=TwoWay}"
                                         AutomationProperties.Name="Operation: remove a file or path from history" />
                            <StackPanel Margin="26,4,0,10"
                                        Visibility="{Binding RewriteOperationIsPurgePath, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ui:TextBox Style="{StaticResource WizardField}"
                                            Text="{Binding RewritePurgePathsText, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="Paths to remove, one per line (a folder removes its whole subtree)"
                                            AcceptsReturn="True" MinHeight="56" MaxHeight="120"
                                            VerticalScrollBarVisibility="Auto"
                                            AutomationProperties.Name="Paths to remove from history" />
                                <ui:TextBox Style="{StaticResource WizardField}"
                                            Text="{Binding RewritePurgeMinSizeText, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="Optional: also remove any file this size or larger — 900, 500 KB, 1.5 MB, 2 GB"
                                            AutomationProperties.Name="Minimum blob size to remove" />
                                <!-- The byte count the engine compares against, echoed rather than implied. -->
                                <TextBlock Text="{Binding RewritePurgeMinSizeEcho}" FontSize="12" TextWrapping="Wrap"
                                           Margin="0,-4,0,8" FontFamily="Cascadia Code,Consolas"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           AutomationProperties.AutomationId="RewritePurgeMinSizeEcho">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RewritePurgeMinSizeEcho}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Style="{StaticResource WizardHint}"
                                           Text="Sizes are binary: 1 KB is 1024 bytes. An entry containing * or ? is read as a glob; otherwise it is a path and everything under it. Commits left with no files are pruned." />
                            </StackPanel>

                            <RadioButton GroupName="RewriteOperation" Style="{StaticResource WizardChoice}"
                                         Content="Rewrite commit and tag messages"
                                         IsChecked="{Binding RewriteOperationIsMessages, Mode=TwoWay}"
                                         AutomationProperties.Name="Operation: rewrite commit and tag messages" />
                            <StackPanel Margin="26,4,0,10"
                                        Visibility="{Binding RewriteOperationIsMessages, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ui:TextBox Style="{StaticResource WizardField}"
                                            Text="{Binding RewriteMessageFindText, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="Message text to find"
                                            AutomationProperties.Name="Text to find in messages" />
                                <ui:TextBox Style="{StaticResource WizardField}"
                                            Text="{Binding RewriteMessageReplacementText, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="Replacement (leave empty to delete the text)"
                                            AutomationProperties.Name="Replacement for messages" />
                                <CheckBox Content="Treat the find text as a regular expression" FontSize="12"
                                          IsChecked="{Binding RewriteMessageUseRegex, Mode=TwoWay}"
                                          AutomationProperties.Name="Use a regular expression for messages" />
                            </StackPanel>

                            <RadioButton GroupName="RewriteOperation" Style="{StaticResource WizardChoice}"
                                         Content="Rewrite an author or committer identity"
                                         IsChecked="{Binding RewriteOperationIsIdentity, Mode=TwoWay}"
                                         AutomationProperties.Name="Operation: rewrite an author or committer identity" />
                            <StackPanel Margin="26,4,0,10"
                                        Visibility="{Binding RewriteOperationIsIdentity, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ui:TextBox Style="{StaticResource WizardField}"
                                            Text="{Binding RewriteOldName, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="Match name (leave empty to match any name)"
                                            AutomationProperties.Name="Identity name to match" />
                                <ui:TextBox Style="{StaticResource WizardField}"
                                            Text="{Binding RewriteOldEmail, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="Match email (leave empty to match any email)"
                                            AutomationProperties.Name="Identity email to match" />
                                <ui:TextBox Style="{StaticResource WizardField}"
                                            Text="{Binding RewriteNewName, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="New name (leave empty to keep the existing name)"
                                            AutomationProperties.Name="Replacement identity name" />
                                <ui:TextBox Style="{StaticResource WizardField}"
                                            Text="{Binding RewriteNewEmail, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="New email (leave empty to keep the existing email)"
                                            AutomationProperties.Name="Replacement identity email" />
                            </StackPanel>
                        </StackPanel>

                        <!-- ── STEP 2: SCOPE ── -->
                        <StackPanel Visibility="{Binding RewriteStepIsScope, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Style="{StaticResource WizardHint}"
                                       Text="Message and identity rewrites follow the commit choices only — a file pattern does not narrow them. Narrowing to some commits still changes their descendants, because a later commit that never re-touches a file inherits the rewritten one." />

                            <RadioButton x:Name="FirstScopeChoice" GroupName="RewriteScope" Style="{StaticResource WizardChoice}"
                                         Content="All history, every file"
                                         IsChecked="{Binding RewriteScopeIsAllHistory, Mode=TwoWay}"
                                         AutomationProperties.Name="Scope: all history and every file" />

                            <RadioButton GroupName="RewriteScope" Style="{StaticResource WizardChoice}"
                                         Content="Only files matching these patterns"
                                         IsChecked="{Binding RewriteScopeIsGlobs, Mode=TwoWay}"
                                         AutomationProperties.Name="Scope: only files matching patterns" />
                            <StackPanel Margin="26,4,0,10"
                                        Visibility="{Binding RewriteScopeIsGlobs, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ui:TextBox Style="{StaticResource WizardField}"
                                            Text="{Binding RewriteScopeGlobsText, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="One glob per line, e.g. src/**/*.cs"
                                            AcceptsReturn="True" MinHeight="56" MaxHeight="120"
                                            VerticalScrollBarVisibility="Auto"
                                            AutomationProperties.Name="File globs in scope" />
                            </StackPanel>

                            <RadioButton GroupName="RewriteScope" Style="{StaticResource WizardChoice}"
                                         Content="Only these exact paths"
                                         IsChecked="{Binding RewriteScopeIsExplicitPaths, Mode=TwoWay}"
                                         AutomationProperties.Name="Scope: only these exact paths" />
                            <StackPanel Margin="26,4,0,10"
                                        Visibility="{Binding RewriteScopeIsExplicitPaths, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ui:TextBox Style="{StaticResource WizardField}"
                                            Text="{Binding RewriteScopePathsText, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="One path per line; a folder covers everything under it"
                                            AcceptsReturn="True" MinHeight="56" MaxHeight="120"
                                            VerticalScrollBarVisibility="Auto"
                                            AutomationProperties.Name="Exact paths in scope" />
                            </StackPanel>

                            <RadioButton GroupName="RewriteScope" Style="{StaticResource WizardChoice}"
                                         Content="Only these commits"
                                         IsChecked="{Binding RewriteScopeIsExplicitCommits, Mode=TwoWay}"
                                         AutomationProperties.Name="Scope: only these commits" />
                            <Grid Margin="26,4,0,10"
                                  Visibility="{Binding RewriteScopeIsExplicitCommits, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="320" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="Pick from this repository's history" FontSize="12" Margin="0,0,0,4"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <ListBox ItemsSource="{Binding Commits}"
                                             SelectedItem="{Binding RewriteScopePickedCommit}"
                                             Height="180" Background="Transparent"
                                             AutomationProperties.Name="Commits available to add to the scope">
                                        <!-- Without an automation name the row is announced as its
                                             type's name: an item container falls back to the item's
                                             ToString. -->
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="AutomationProperties.Name">
                                                    <Setter.Value>
                                                        <MultiBinding StringFormat="{}{0}, commit {1}">
                                                            <Binding Path="Message" />
                                                            <Binding Path="ShortHash" />
                                                        </MultiBinding>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:GitCommit}">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Left" Width="64" Text="{Binding ShortHash}"
                                                               FontFamily="Cascadia Code,Consolas" FontSize="12"
                                                               Foreground="{DynamicResource StatusInfoFg}" />
                                                    <TextBlock Text="{Binding Message}" FontSize="12"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Message}"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <DockPanel Margin="0,8,0,0">
                                        <ui:Button DockPanel.Dock="Right" Content="Add to scope" FontSize="12" Padding="10,4"
                                                   Margin="8,0,0,0"
                                                   Command="{Binding AddRewriteScopeCommitCommand}"
                                                   AutomationProperties.Name="Add the selected commit or typed ref to the scope" />
                                        <ui:TextBox Text="{Binding RewriteScopeCommitDraft, UpdateSourceTrigger=PropertyChanged}"
                                                    PlaceholderText="…or type a commit or ref"
                                                    FontSize="12"
                                                    AutomationProperties.Name="Commit or ref to add to the scope">
                                            <ui:TextBox.InputBindings>
                                                <KeyBinding Key="Enter" Command="{Binding AddRewriteScopeCommitCommand}" />
                                            </ui:TextBox.InputBindings>
                                        </ui:TextBox>
                                    </DockPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Commits in scope" FontSize="12" Margin="0,0,0,4"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="No commits selected yet.">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource WizardHint}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RewriteScopeCommits.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ItemsControl ItemsSource="{Binding RewriteScopeCommits}"
                                                  AutomationProperties.Name="Commits currently in scope">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,0,0,4">
                                                    <ui:Button DockPanel.Dock="Right" Content="Remove" FontSize="11" Padding="8,2"
                                                               Command="{Binding DataContext.RemoveRewriteScopeCommitCommand,
                                                                                 RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               CommandParameter="{Binding}"
                                                               AutomationProperties.Name="Remove this commit from the scope" />
                                                    <TextBlock Text="{Binding}" FontFamily="Cascadia Code,Consolas" FontSize="12"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>

                            <RadioButton GroupName="RewriteScope" Style="{StaticResource WizardChoice}"
                                         Content="Only a commit range"
                                         IsChecked="{Binding RewriteScopeIsCommitRange, Mode=TwoWay}"
                                         AutomationProperties.Name="Scope: only a commit range" />
                            <StackPanel Margin="26,4,0,10"
                                        Visibility="{Binding RewriteScopeIsCommitRange, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ui:TextBox Style="{StaticResource WizardField}"
                                            Text="{Binding RewriteRangeFromText, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="From (exclusive; leave empty to start at the root commit)"
                                            AutomationProperties.Name="Range start ref" />
                                <ui:TextBox Style="{StaticResource WizardField}"
                                            Text="{Binding RewriteRangeToText, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="To (inclusive), e.g. HEAD"
                                            AutomationProperties.Name="Range end ref" />
                            </StackPanel>
                        </StackPanel>

                        <!-- ── STEP 3: PREVIEW (dry run) ── -->
                        <StackPanel Visibility="{Binding RewriteStepIsPreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Style="{StaticResource WizardHint}"
                                       Text="The dry run rewrites into a scratch copy and reports what it found. Nothing in this repository changes until you confirm on the next step." />
                            <ui:Button Content="Run the dry run again" FontSize="12" Padding="12,4" Margin="0,0,0,10"
                                       HorizontalAlignment="Left"
                                       Icon="{ui:SymbolIcon Play24}"
                                       Command="{Binding RunRewritePreviewCommand}"
                                       IsEnabled="{Binding RewriteNotRunning}"
                                       AutomationProperties.Name="Run the dry run again" />
                            <ContentControl Template="{StaticResource RewriteReportTemplate}"
                                            Visibility="{Binding RewritePreviewAvailable, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>

                        <!-- ── STEP 4: TYPED CONFIRMATION ── -->
                        <StackPanel Visibility="{Binding RewriteStepIsConfirm, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Border Background="{DynamicResource StatusBadBg}" BorderBrush="{DynamicResource StatusBadFg}"
                                    BorderThickness="1" CornerRadius="8" Padding="14,12">
                                <TextBlock Text="{Binding RewriteConfirmMessage}" FontSize="13" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Border>
                            <ui:TextBox Margin="0,12,0,0" MaxWidth="420" HorizontalAlignment="Left"
                                        Text="{Binding RewriteConfirmInput, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="Type the repository name here"
                                        FontFamily="Cascadia Code,Consolas"
                                        AutomationProperties.Name="Type the repository name to confirm the rewrite" />
                        </StackPanel>

                        <!-- ── RUNNING ── -->
                        <StackPanel Visibility="{Binding RewriteStepIsRunning, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Margin="0,24,0,0" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <ui:ProgressRing IsIndeterminate="True" Width="24" Height="24" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding RewriteStatusText}"
                                           AutomationProperties.LiveSetting="Polite" FontSize="14" Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource WizardHint}" Margin="0,10,0,0"
                                       Text="A verified backup is taken first, then the rewritten history is swapped in as one atomic ref transaction." />
                            <TextBlock Style="{StaticResource WizardHint}" Margin="0,0,0,0"
                                       Text="Cancelling is safe until that transaction begins — up to then nothing in this repository has been touched. Once it begins it runs to completion, because a half-applied swap is the one outcome that cannot be recovered from."
                                       Visibility="{Binding RewriteCanCancel, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Border CornerRadius="6" Padding="12,8" Margin="0,6,0,0" HorizontalAlignment="Left"
                                    Background="{DynamicResource StatusWarnBg}" BorderThickness="1"
                                    BorderBrush="{DynamicResource StatusWarnFg}"
                                    Visibility="{Binding RewriteCancelClosedVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Applying — the rewrite can no longer be cancelled. The ref transaction is all-or-nothing and is finishing now."
                                           FontSize="12" TextWrapping="Wrap" MaxWidth="640"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           AutomationProperties.AutomationId="RewriteCancelClosedNotice"
                                           AutomationProperties.LiveSetting="Polite" />
                            </Border>
                        </StackPanel>

                        <!-- ── RESULT ── -->
                        <StackPanel Visibility="{Binding RewriteStepIsResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Border CornerRadius="8" Padding="14,10" Margin="0,0,0,8"
                                    Background="{DynamicResource StatusBadBg}" BorderBrush="{DynamicResource StatusBadFg}"
                                    BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RewriteResultSucceeded}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource StatusInfoBg}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource StatusInfoFg}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding RewriteStatusText}"
                                           AutomationProperties.LiveSetting="Polite" FontSize="14" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                        Visibility="{Binding RewriteUndoAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ui:Button Content="Undo — restore the pre-rewrite backup" Appearance="Danger"
                                           FontSize="13" Padding="14,6"
                                           Icon="{ui:SymbolIcon ArrowUndo24}"
                                           Command="{Binding UndoRewriteCommand}"
                                           AutomationProperties.Name="Undo the rewrite and restore the pre-rewrite backup" />
                            </StackPanel>

                            <!-- The rewrite left the remote holding the old history. Publishing it
                                 is a separate decision with its own plan and its own typed
                                 confirmation; the pane opens OVER this screen so the Undo above
                                 stays available behind it. -->
                            <StackPanel Margin="0,0,0,10"
                                        Visibility="{Binding RewriteResultSucceeded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ui:Button Content="Push rewritten history…" Appearance="Danger"
                                           FontSize="13" Padding="14,6" HorizontalAlignment="Left"
                                           Icon="{ui:SymbolIcon CloudArrowUp24}"
                                           Command="{Binding OpenForcePushCommand}"
                                           AutomationProperties.Name="Review what a force-push would replace on the remote" />
                                <TextBlock Style="{StaticResource WizardHint}" Margin="0,6,0,0"
                                           Text="Shows exactly which branches would be replaced on their remotes and what each push is leased against, then asks for this repository's name. Nothing is pushed until you do that." />
                            </StackPanel>
                            <TextBlock Text="{Binding RewriteUndoText}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RewriteUndoText}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ContentControl Template="{StaticResource RewriteReportTemplate}"
                                            Visibility="{Binding RewriteHasReport, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- ═══ FOOTER ═══ -->
                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                    <Border Background="{DynamicResource StatusBadBg}" BorderBrush="{DynamicResource StatusBadFg}"
                            BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RewriteErrorText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding RewriteErrorText}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   AutomationProperties.Name="{Binding RewriteErrorText, StringFormat='Rewrite problem: {0}'}"
                                   AutomationProperties.LiveSetting="Assertive" />
                    </Border>

                    <!-- Why Next is refused, live, so an unusable size says so before it is clicked. -->
                    <TextBlock Text="{Binding RewriteNextBlockedReason}" FontSize="12" TextWrapping="Wrap"
                               Margin="0,0,0,8"
                               Foreground="{DynamicResource StatusWarnFg}"
                               AutomationProperties.AutomationId="RewriteNextBlockedReason">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RewriteNextBlockedReason}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <!-- Stops the step in flight. Absent once the swap owns the repository,
                                 where the Running step states why instead. -->
                            <ui:Button Content="{Binding RewriteCancelLabel}" FontSize="13" Padding="14,5" Margin="0,0,8,0"
                                       Icon="{ui:SymbolIcon DismissCircle24}"
                                       Command="{Binding CancelRewriteStepCommand}"
                                       Visibility="{Binding RewriteCanCancel, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       AutomationProperties.Name="Cancel the step that is running" />

                            <ui:Button Content="Back" FontSize="13" Padding="14,5" Margin="0,0,8,0"
                                       Command="{Binding RewriteBackCommand}"
                                       Visibility="{Binding RewriteShowBack, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       AutomationProperties.Name="Back to the previous step" />

                            <ui:Button Content="Next" Appearance="Primary" FontSize="13" Padding="16,5"
                                       Command="{Binding RewriteNextCommand}"
                                       Visibility="{Binding RewriteShowNext, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       AutomationProperties.Name="Continue to the next step" />

                            <!-- Without a held dry run this control is absent, not merely disabled. -->
                            <ui:Button Content="Rewrite history now" Appearance="Danger" FontSize="13" Padding="16,5"
                                       Icon="{ui:SymbolIcon Warning24}"
                                       Command="{Binding ExecuteRewriteCommand}"
                                       Visibility="{Binding RewriteShowExecute, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       AutomationProperties.Name="Rewrite history now" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="0,0,10,0"
                                             Visibility="{Binding RewriteRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock Text="{Binding RewriteStatusText}"
                                       AutomationProperties.LiveSetting="Polite" FontSize="12" TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
