<UserControl
    x:Class="ProjectDashboard.Views.Pages.BackupsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:ProjectDashboard.ViewModels.Pages"
    FontFamily="Segoe UI"
    IsVisibleChanged="OnIsVisibleChanged">

    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseBackupsCommand}" />
    </UserControl.InputBindings>

    <UserControl.Resources>
        <Style x:Key="BackupsHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,8" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>
    </UserControl.Resources>

    <!-- Scrim: opaque enough to read the card against, and it swallows clicks aimed behind it. -->
    <Grid Background="#B0000000">
        <!-- Every navigation mode cycles inside the pane, for the reason the rewrite wizard's
             does: the scrim stops the mouse but no keystroke, and Fetch, Pull, and Push sit
             directly behind it. -->
        <Border MaxWidth="940" Margin="24" CornerRadius="10"
                KeyboardNavigation.TabNavigation="Cycle"
                KeyboardNavigation.ControlTabNavigation="Cycle"
                KeyboardNavigation.DirectionalNavigation="Cycle"
                Background="{DynamicResource ApplicationBackgroundBrush}"
                BorderBrush="{StaticResource StatusBadFg}" BorderThickness="1">
            <Grid Margin="24,18,24,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ═══ HEADER ═══ -->
                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <ui:Button DockPanel.Dock="Right" Content="Close" FontSize="12" Padding="12,4"
                               Command="{Binding CloseBackupsCommand}"
                               ToolTip="Close the backups browser (Esc)"
                               AutomationProperties.Name="Close the backups browser" />
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowUndo24" FontSize="16" VerticalAlignment="Center"
                                           Margin="0,0,8,0" Foreground="{StaticResource StatusBadFg}" />
                            <TextBlock Text="Backups" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding Project.DirectoryName}" FontSize="13" Margin="10,0,0,0"
                                       VerticalAlignment="Bottom" Padding="0,0,0,3"
                                       FontFamily="Cascadia Code,Consolas"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="Restore this repository to a state a backup captured" FontSize="12" Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </DockPanel>

                <!-- ═══ BODY ═══ -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Style="{StaticResource BackupsHint}"
                                   Text="Every history rewrite and every commit-surgery operation writes a verified backup here before it touches anything. The crash record that flags an interrupted operation can itself be lost, so an empty crash record is not proof nothing was interrupted — this list is the record that survives." />

                        <Border CornerRadius="6" Padding="12,8" Margin="0,0,0,10"
                                Background="{StaticResource StatusWarnBg}" BorderThickness="1"
                                BorderBrush="{StaticResource StatusWarnFg}"
                                AutomationProperties.Name="Interrupted operation recorded for this repository">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BackupsJournalNote}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding BackupsJournalNote}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Border>

                        <!-- The empty state states the limit of what it can claim: no backup on
                             disk is not the same as no operation having run. -->
                        <Border CornerRadius="6" Padding="12,10" Margin="0,0,0,10"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                Visibility="{Binding BackupsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="No backups on disk for this repository."
                                           FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Style="{StaticResource BackupsHint}" Margin="0,6,0,0"
                                           Text="That is not proof nothing was ever interrupted here: a backup can be pruned by the retention setting in Settings, or deleted from the app's data folder. If an operation was interrupted and its backup is gone, this app cannot restore it — the reflog in a terminal is the remaining route." />
                            </StackPanel>
                        </Border>

                        <ListBox x:Name="BackupChoices" ItemsSource="{Binding BackupList}"
                                 SelectedItem="{Binding SelectedBackup}"
                                 MaxHeight="300" Background="Transparent"
                                 HorizontalContentAlignment="Stretch"
                                 Visibility="{Binding BackupsHasEntries, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 AutomationProperties.Name="Backups for this repository">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:BackupEntry}">
                                    <StackPanel Margin="0,4,0,4">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Operation}" FontSize="12"
                                                       Margin="12,0,0,0"
                                                       Foreground="{StaticResource StatusInfoFg}" />
                                            <TextBlock Text="{Binding Taken}" FontSize="13" FontWeight="SemiBold"
                                                       FontFamily="Cascadia Code,Consolas"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Detail}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- ── The gate ── -->
                        <StackPanel Visibility="{Binding BackupsHasEntries, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Border Background="{StaticResource StatusBadBg}" BorderBrush="{StaticResource StatusBadFg}"
                                    BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock FontSize="13" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               Text="Restoring replaces every ref in this repository with the ones the backup recorded, repositions HEAD, and resets the working tree onto them. Any commit made since the backup was taken is dropped, and the reset discards uncommitted work — so a dirty working tree is refused before anything is written." />
                                    <TextBlock FontSize="13" TextWrapping="Wrap" Margin="0,10,0,0"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               Text="Type this repository's name below to confirm." />
                                </StackPanel>
                            </Border>
                            <ui:TextBox Margin="0,12,0,0" MaxWidth="420" HorizontalAlignment="Left"
                                        Text="{Binding BackupsConfirmInput, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="Type the repository name here"
                                        FontFamily="Cascadia Code,Consolas"
                                        AutomationProperties.Name="Type the repository name to confirm the restore" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ═══ FOOTER ═══ -->
                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                    <Border Background="{StaticResource StatusBadBg}" BorderBrush="{StaticResource StatusBadFg}"
                            BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BackupsErrorText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding BackupsErrorText}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   AutomationProperties.Name="Backup problem" />
                    </Border>

                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ui:Button Content="Refresh" FontSize="13" Padding="14,5" Margin="0,0,8,0"
                                       Command="{Binding LoadBackupsCommand}"
                                       AutomationProperties.Name="Reload the backup list" />
                            <ui:Button Content="Restore this backup" Appearance="Danger" FontSize="13" Padding="16,5"
                                       Icon="{ui:SymbolIcon ArrowUndo24}"
                                       Command="{Binding RestoreSelectedBackupCommand}"
                                       Visibility="{Binding BackupsHasEntries, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       AutomationProperties.Name="Restore the selected backup" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="0,0,10,0"
                                             Visibility="{Binding BackupsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock Text="{Binding BackupsStatusText}" FontSize="12" TextWrapping="Wrap"
                                       VerticalAlignment="Center" MaxWidth="520"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       AutomationProperties.Name="Backup status" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
