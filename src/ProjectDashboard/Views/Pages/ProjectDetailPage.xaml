<Page
    x:Class="ProjectDashboard.Views.Pages.ProjectDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:helpers="clr-namespace:ProjectDashboard.Helpers"
    xmlns:local="clr-namespace:ProjectDashboard.ViewModels.Pages"
    xmlns:models="clr-namespace:ProjectDashboard.Models"
    xmlns:pages="clr-namespace:ProjectDashboard.Views.Pages"
    FontFamily="Segoe UI"
    Focusable="True"
    PreviewKeyDown="Page_PreviewKeyDown">

    <Page.Resources>
        <helpers:RelativeTimeConverter x:Key="RelativeTimeConverter" />
        <helpers:DiffLineNarrator x:Key="DiffLineNarrator" />
        <helpers:SideBySideRowNarrator x:Key="SideBySideRowNarrator" />

        <!-- Diff row: two number gutters + monospace text, background by kind -->
        <DataTemplate x:Key="DiffLineTemplate" DataType="{x:Type models:DiffLine}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding OldNumber}" FontFamily="Cascadia Code,Consolas" FontSize="11"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right" Margin="0,0,8,0" />
                <TextBlock Grid.Column="1" Text="{Binding NewNumber}" FontFamily="Cascadia Code,Consolas" FontSize="11"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right" Margin="0,0,10,0" />
                <TextBlock Grid.Column="2" Text="{Binding Text}" FontFamily="Cascadia Code,Consolas" FontSize="12"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="NoWrap" />
            </Grid>
        </DataTemplate>

        <Style x:Key="DiffListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="ItemTemplate" Value="{StaticResource DiffLineTemplate}" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="4,0" />
                        <Setter Property="MinHeight" Value="18" />
                        <!-- Without this the row is announced as its type's name: an item container
                             takes the item's ToString when it carries no automation name. -->
                        <Setter Property="AutomationProperties.Name"
                                Value="{Binding Converter={StaticResource DiffLineNarrator}}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}"
                                            BorderThickness="2,0,0,0" BorderBrush="Transparent">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="Added">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource DiffAddedCellBg}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="Removed">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource DiffRemovedCellBg}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="HunkHeader">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource StatusInfoBg}" />
                                        </DataTrigger>
                                        <!-- Last, so it wins over the per-kind backgrounds: the hunk
                                             actions run on the selected row's hunk, and a selection
                                             that is invisible makes them look like they fire at random. -->
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource StatusInfoFg}" />
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource StatusNeutralBg}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Side-by-side row: old cell | new cell, or a header spanning both. Cell colour is
             per side rather than per row, because one row carries both sides; the tints
             themselves live in the swapped theme palette. -->

        <!-- A header row spans both sides, so neither gutter names a line on it. -->
        <Style x:Key="DiffGutterNumber" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="SideBySideRowTemplate" DataType="{x:Type models:SideBySideRow}">
            <!-- The two text cells are equal halves of one arranged width, so the boundary
                 between them sits at the same place on every row of the pane. -->
            <helpers:DiffRowPanel GutterWidth="42">
                <!-- A hunk header, a mode line, or the untracked-preview note: one statement
                     about the file, not a line of either side of it. -->
                <TextBlock helpers:DiffRowPanel.Cell="Span" Text="{Binding HeaderText}"
                           FontFamily="Cascadia Code,Consolas" FontSize="12" TextWrapping="NoWrap"
                           Background="{DynamicResource StatusInfoBg}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Visibility="{Binding IsHeader, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <TextBlock helpers:DiffRowPanel.Cell="OldNumber" Text="{Binding LeftNumber}"
                           FontFamily="Cascadia Code,Consolas" FontSize="11"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           HorizontalAlignment="Right" Margin="0,0,8,0"
                           Style="{StaticResource DiffGutterNumber}" />
                <!-- Clipped: a line longer than the half it sits in scrolls into view with the
                     pane rather than painting over the other side of the file. -->
                <Border helpers:DiffRowPanel.Cell="OldText" MinWidth="120" ClipToBounds="True">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LeftRemoved}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource DiffRemovedCellBg}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding LeftAbsent}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource DiffAbsentCellBg}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock FontFamily="Cascadia Code,Consolas" FontSize="12" TextWrapping="NoWrap"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               helpers:InlineSegments.HighlightBrush="{DynamicResource DiffRemovedWordBg}"
                               helpers:InlineSegments.Segments="{Binding LeftSegments}" />
                </Border>

                <TextBlock helpers:DiffRowPanel.Cell="NewNumber" Text="{Binding RightNumber}"
                           FontFamily="Cascadia Code,Consolas" FontSize="11"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           HorizontalAlignment="Right" Margin="10,0,8,0"
                           Style="{StaticResource DiffGutterNumber}" />
                <Border helpers:DiffRowPanel.Cell="NewText" MinWidth="120" ClipToBounds="True"
                        BorderThickness="1,0,0,0"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RightAdded}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource DiffAddedCellBg}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RightAbsent}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource DiffAbsentCellBg}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock FontFamily="Cascadia Code,Consolas" FontSize="12" TextWrapping="NoWrap"
                               Margin="4,0,0,0"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               helpers:InlineSegments.HighlightBrush="{DynamicResource DiffAddedWordBg}"
                               helpers:InlineSegments.Segments="{Binding RightSegments}" />
                </Border>
            </helpers:DiffRowPanel>
        </DataTemplate>

        <!-- Long lines scroll rather than wrap, as in the unified pane: a wrapped cell would
             put the two sides' line numbers out of step with each other. -->
        <Style x:Key="SideBySideListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="ItemTemplate" Value="{StaticResource SideBySideRowTemplate}" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="4,0" />
                        <Setter Property="MinHeight" Value="18" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="AutomationProperties.Name"
                                Value="{Binding Converter={StaticResource SideBySideRowNarrator}}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}"
                                            BorderThickness="2,0,0,0" BorderBrush="Transparent">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource StatusInfoFg}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Working-file row -->
        <DataTemplate x:Key="WorkingFileTemplate" DataType="{x:Type models:WorkingFile}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Width="18" Text="{Binding UnstagedLabel}"
                           FontFamily="Cascadia Code,Consolas" FontSize="12"
                           Foreground="{DynamicResource StatusWarnFg}" />
                <TextBlock Text="{Binding Path}" FontSize="12" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Path}"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </DockPanel>
        </DataTemplate>
        <DataTemplate x:Key="StagedFileTemplate" DataType="{x:Type models:WorkingFile}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Width="18" Text="{Binding StagedLabel}"
                           FontFamily="Cascadia Code,Consolas" FontSize="12"
                           Foreground="{DynamicResource StatusGoodFg}" />
                <TextBlock Text="{Binding Path}" FontSize="12" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Path}"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </DockPanel>
        </DataTemplate>

        <!-- An item container with no automation name is announced as its item's ToString, which
             for every model here is the type's own name. Each list below sets one that says what
             the row says on screen, with the status column spelled out. -->
        <Style x:Key="WorkingFileRow" TargetType="ListBoxItem">
            <Setter Property="AutomationProperties.Name">
                <Setter.Value>
                    <MultiBinding StringFormat="{}{0} {1}">
                        <Binding Path="UnstagedStatusName" />
                        <Binding Path="Path" />
                    </MultiBinding>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StagedFileRow" TargetType="ListBoxItem">
            <Setter Property="AutomationProperties.Name">
                <Setter.Value>
                    <MultiBinding StringFormat="{}{0} {1}">
                        <Binding Path="StagedStatusName" />
                        <Binding Path="Path" />
                    </MultiBinding>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PaneHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </Page.Resources>

    <Grid Margin="32,16,32,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══ HEADER ═══ -->
        <StackPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                <TextBlock Text="{Binding Project.DisplayName}"
                           FontSize="22" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="{Binding Project.LatestVersion}"
                           FontSize="13" FontFamily="Cascadia Code,Consolas"
                           Margin="14,0,0,0"
                           VerticalAlignment="Bottom" Padding="0,0,0,4"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                <ui:SymbolIcon FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center">
                    <ui:SymbolIcon.Style>
                        <Style TargetType="ui:SymbolIcon">
                            <Setter Property="Symbol" Value="CheckmarkCircle24" />
                            <Setter Property="Foreground" Value="{DynamicResource StatusGoodFg}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Project.GitStatus.IsDirty}" Value="True">
                                    <Setter Property="Symbol" Value="Edit24" />
                                    <Setter Property="Foreground" Value="{DynamicResource StatusWarnFg}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Project.GitStatus.RemoteUrl}" Value="">
                                    <Setter Property="Symbol" Value="CloudOff24" />
                                    <Setter Property="Foreground" Value="{DynamicResource StatusBadFg}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:SymbolIcon.Style>
                </ui:SymbolIcon>
                <TextBlock FontSize="12" FontFamily="Cascadia Code,Consolas"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="{Binding Project.FullPath}" />
            </StackPanel>

            <!-- ═══ INTERRUPTED-OPERATION BANNER ═══
                 A history operation that died mid-flight left a journal entry the app found at
                 startup. Nothing is restored here and nothing is restored automatically: the
                 reader chooses to restore, to keep the record for next launch, or to discard it.
                 Disabled behind a safety overlay with the rest of the page. -->
            <Border x:Name="RecoveryBanner"
                    IsEnabled="{Binding SafetyOverlayHidden}"
                    Visibility="{Binding RecoveryBannerVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Background="{DynamicResource StatusBadBg}"
                    BorderBrush="{DynamicResource StatusBadFg}" BorderThickness="1" CornerRadius="8"
                    Padding="12,10" Margin="0,10,0,0">
                <StackPanel>
                    <DockPanel>
                        <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Warning24" Foreground="{DynamicResource StatusBadFg}"
                                       FontSize="16" Margin="0,0,10,0" VerticalAlignment="Top" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top"
                                    Margin="12,0,0,0">
                            <ui:Button Content="Open Backups…" FontSize="12" Padding="10,4" Margin="0,0,6,0"
                                       Appearance="Primary"
                                       Command="{Binding OpenBackupsForRecoveryCommand}"
                                       AutomationProperties.Name="Open the backup this interrupted operation recorded" />
                            <ui:Button Content="Keep the record" FontSize="12" Padding="10,4" Margin="0,0,6,0"
                                       Command="{Binding KeepRecoveryRecordCommand}"
                                       ToolTip="Hide this until the next launch, keeping the record"
                                       AutomationProperties.Name="Keep the interrupted-operation record" />
                            <ui:Button Content="Discard the record…" FontSize="12" Padding="10,4"
                                       Command="{Binding BeginDiscardRecoveryRecordCommand}"
                                       ToolTip="Drop the record permanently — the backup itself is kept"
                                       AutomationProperties.Name="Discard the interrupted-operation record" />
                        </StackPanel>
                        <TextBlock Text="{Binding RecoveryBannerText}" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="13"
                                   AutomationProperties.AutomationId="RecoveryBannerText"
                                   AutomationProperties.LiveSetting="Assertive" />
                    </DockPanel>

                    <!-- Discarding abandons the only record that this repository may be
                         mid-operation, so it is typed out like every other irreversible choice. -->
                    <StackPanel Margin="26,10,0,0"
                                Visibility="{Binding RecoveryDiscardVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Text="Discarding drops the record that an operation here was interrupted. The backup it names stays on disk and stays restorable from Backups. Type this repository's name to confirm." />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <ui:TextBox Width="260"
                                        Text="{Binding RecoveryDiscardInput, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="Type the repository name"
                                        FontFamily="Cascadia Code,Consolas" FontSize="12"
                                        AutomationProperties.Name="Type the repository name to discard the record" />
                            <ui:Button Content="Discard" Appearance="Danger" FontSize="12" Padding="12,4" Margin="8,0,0,0"
                                       Command="{Binding DiscardRecoveryRecordCommand}"
                                       AutomationProperties.Name="Confirm discarding the interrupted-operation record" />
                            <ui:Button Content="Cancel" FontSize="12" Padding="12,4" Margin="6,0,0,0"
                                       Command="{Binding CancelDiscardRecoveryRecordCommand}"
                                       AutomationProperties.Name="Keep the interrupted-operation record after all" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ═══ STATE BANNER ═══ -->
        <!-- Disabled behind the wizard's scrim with the branch bar and the work-area tabs: these
             rows sit outside the TabControl, so without this a keystroke still reaches them. -->
        <Border Grid.Row="1" x:Name="StateBanner"
                IsEnabled="{Binding SafetyOverlayHidden}"
                Visibility="{Binding StateBannerVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                Background="{DynamicResource StatusWarnBg}"
                BorderBrush="{DynamicResource StatusWarnFg}" BorderThickness="1" CornerRadius="8"
                Padding="12,8" Margin="0,8,0,0">
            <DockPanel>
                <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Warning24" Foreground="{DynamicResource StatusWarnFg}"
                               FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                <ui:Button DockPanel.Dock="Right" Content="Open in Terminal" FontSize="12" Padding="10,4"
                           Command="{Binding OpenRepoInTerminalCommand}" />
                <TextBlock Text="{Binding StateBannerText}" VerticalAlignment="Center" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="13" />
            </DockPanel>
        </Border>

        <!-- ═══ BRANCH BAR ═══ -->
        <!-- Pull is guarded only by IsBusy, which is clear on the wizard's Result step: reached
             behind the scrim it merges the remote's un-rewritten history back over the rewrite
             the Result screen is still reporting on. -->
        <Border Grid.Row="2" x:Name="BranchBar"
                IsEnabled="{Binding SafetyOverlayHidden}"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                CornerRadius="8" Padding="12,6" Margin="0,8,0,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="BranchFork24" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource StatusInfoFg}" />
                    <TextBlock Text="{Binding BranchLabel}" FontFamily="Cascadia Code,Consolas" FontSize="13"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <Border Background="{DynamicResource StatusInfoBg}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding AheadBehindLabel}" FontSize="11"
                                   Foreground="{DynamicResource StatusInfoFg}" />
                    </Border>
                    <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="12,0,0,0"
                                     VerticalAlignment="Center"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Text="{Binding SyncStatusText}"
                               AutomationProperties.LiveSetting="Polite" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:Button Content="Remove stale lock and retry" FontSize="12" Padding="10,4" Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Visibility="{Binding StaleLockRetryVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                               Command="{Binding RemoveStaleLockAndRetryCommand}" />
                    <!-- The inverse of what just finished, beside the line reporting it. Only
                         reversible operations put one here, and the label names the action the
                         button runs — the name it is read out under says no more than that. -->
                    <ui:Button Content="{Binding UndoOfferLabel}" FontSize="12" Padding="10,4" Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Visibility="{Binding UndoOfferVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                               Command="{Binding RunUndoOfferCommand}"
                               AutomationProperties.Name="{Binding UndoOfferLabel}" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="Refresh" FontSize="12" Padding="10,4" Margin="0,0,6,0"
                               Icon="{ui:SymbolIcon ArrowSync24}"
                               Command="{Binding RefreshWorkingCopyCommand}"
                               ToolTip="Re-read the working tree (F5)"
                               AutomationProperties.Name="Refresh the working tree" />
                    <ui:Button Content="Fetch" FontSize="12" Padding="10,4" Margin="0,0,6,0"
                               Icon="{ui:SymbolIcon ArrowDownload24}"
                               Command="{Binding FetchCommand}" />
                    <ui:Button Content="Pull" FontSize="12" Padding="10,4" Margin="0,0,6,0"
                               Icon="{ui:SymbolIcon ArrowDown24}"
                               Command="{Binding PullCommand}" />
                    <ui:Button Content="Push" FontSize="12" Padding="10,4"
                               Icon="{ui:SymbolIcon ArrowUp24}"
                               Command="{Binding PushCommand}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══ WORK AREA TABS ═══ -->
        <TabControl Grid.Row="3" x:Name="WorkTabs" Background="Transparent" BorderThickness="0"
                    IsEnabled="{Binding SafetyOverlayHidden}"
                    AutomationProperties.Name="Work area"
                    SelectionChanged="WorkTabs_SelectionChanged">

            <!-- ── OVERVIEW ── -->
            <TabItem Header="Overview" Tag="{x:Static models:DetailTab.Overview}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                    <StackPanel Margin="0,12,0,12" MaxWidth="1200" HorizontalAlignment="Left">

                        <TextBlock Text="{Binding Project.Manifest.Description}"
                                   FontSize="13" Margin="0,0,0,12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Project.Manifest.Description}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    CornerRadius="8" Padding="20,16" Margin="0,0,12,0" MinWidth="380">
                                <StackPanel>
                                    <TextBlock Text="Project Manifest" FontWeight="SemiBold" FontSize="14"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,12" />
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="Description" FontSize="12" Margin="0,0,0,2"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <TextBox Text="{Binding ManifestDescription, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="12" AcceptsReturn="True" TextWrapping="Wrap"
                                                 MinHeight="46" MaxHeight="90"
                                                 VerticalScrollBarVisibility="Auto"
                                                 AutomationProperties.Name="Project description" />
                                    </StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,12">
                                            <TextBlock Text="Type" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,2" />
                                            <ComboBox ItemsSource="{x:Static local:ProjectDetailViewModel.ProjectTypes}"
                                                      SelectedItem="{Binding SelectedProjectType}" FontSize="12"
                                                      AutomationProperties.Name="Project type" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,12">
                                            <TextBlock Text="Status" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,2" />
                                            <ComboBox ItemsSource="{x:Static local:ProjectDetailViewModel.Statuses}"
                                                      SelectedItem="{Binding SelectedStatus}" FontSize="12"
                                                      AutomationProperties.Name="Project status" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="Category" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,2" />
                                            <ComboBox ItemsSource="{x:Static local:ProjectDetailViewModel.CategoriesList}"
                                                      SelectedItem="{Binding SelectedCategory}" FontSize="12"
                                                      AutomationProperties.Name="Project category" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1">
                                            <TextBlock Text="Validation" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,2" />
                                            <ComboBox ItemsSource="{x:Static local:ProjectDetailViewModel.Schedules}"
                                                      SelectedItem="{Binding ValidationSchedule}" FontSize="12"
                                                      AutomationProperties.Name="Validation schedule" />
                                        </StackPanel>
                                    </Grid>
                                    <ui:Button Content="Save" Appearance="Primary" Margin="0,12,0,0"
                                               HorizontalAlignment="Left"
                                               Command="{Binding SaveManifestCommand}"
                                               AutomationProperties.Name="Save the project metadata" />
                                    <TextBlock Text="{Binding ManifestStatusText}" FontSize="12" Margin="0,8,0,0"
                                               TextWrapping="Wrap"
                                               AutomationProperties.LiveSetting="Polite"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ManifestStatusText}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    CornerRadius="8" Padding="20,16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                        <TextBlock DockPanel.Dock="Left" Text="Notes" FontWeight="SemiBold" FontSize="14"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <ui:Button DockPanel.Dock="Right" HorizontalAlignment="Right"
                                                   Padding="6,2" FontSize="12"
                                                   Icon="{ui:SymbolIcon Edit24}"
                                                   Content="{Binding NotesEditLabel}"
                                                   Command="{Binding ToggleEditNotesCommand}"
                                                   ToolTip="Notes are saved when the editor closes"
                                                   AutomationProperties.Name="{Binding NotesEditName}" />
                                    </DockPanel>
                                    <ItemsControl Grid.Row="1" ItemsSource="{Binding NoteLines}">
                                        <ItemsControl.Style>
                                            <Style TargetType="ItemsControl">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditingNotes}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ItemsControl.Style>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:NoteLine}">
                                                <DockPanel Margin="0,2">
                                                    <ui:SymbolIcon DockPanel.Dock="Left" Symbol="{Binding Icon}" FontSize="14"
                                                                   Foreground="{Binding IconBrush}" Margin="0,3,8,0"
                                                                   VerticalAlignment="Top" />
                                                    <TextBlock Text="{Binding Text}" FontSize="13"
                                                               TextWrapping="Wrap"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBox Grid.Row="1"
                                             Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Project notes"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             MinHeight="140"
                                             VerticalScrollBarVisibility="Auto"
                                             FontFamily="Cascadia Code,Consolas"
                                             FontSize="13"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                             CaretBrush="{DynamicResource TextFillColorPrimaryBrush}">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditingNotes}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    <TextBlock Grid.Row="2" Text="{Binding NotesStatusText}" FontSize="12"
                                               Margin="0,8,0,0" TextWrapping="Wrap"
                                               AutomationProperties.LiveSetting="Polite"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NotesStatusText}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </Grid>

                        <Expander IsExpanded="False" Margin="0,20,0,0">
                            <Expander.Header>
                                <TextBlock Text="README" FontWeight="SemiBold" FontSize="14"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Expander.Header>
                            <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    CornerRadius="0,0,8,8" Padding="20">
                                <!-- IsDocumentEnabled gates whether a Hyperlink inside the
                                     document receives mouse input at all: without it the
                                     rendered markdown link is styled as a link, carries its
                                     tooltip, and does nothing when clicked. IsReadOnly still
                                     blocks editing. The caret is the keyboard's cursor in a
                                     RichTextBox, so it has to be visible for the reader to
                                     steer Enter onto a link. -->
                                <RichTextBox x:Name="ReadmeRichText"
                                             IsReadOnly="True"
                                             IsDocumentEnabled="True"
                                             IsReadOnlyCaretVisible="True"
                                             PreviewKeyDown="RenderedText_PreviewKeyDown"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             FontFamily="Segoe UI"
                                             FontSize="13" />
                            </Border>
                        </Expander>

                        <Expander IsExpanded="False" Margin="0,12,0,12">
                            <Expander.Header>
                                <TextBlock Text="CHANGELOG" FontWeight="SemiBold" FontSize="14"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Expander.Header>
                            <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    CornerRadius="0,0,8,8" Padding="20">
                                <RichTextBox x:Name="ChangelogRichText"
                                             IsReadOnly="True"
                                             IsDocumentEnabled="True"
                                             IsReadOnlyCaretVisible="True"
                                             PreviewKeyDown="RenderedText_PreviewKeyDown"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             FontFamily="Segoe UI"
                                             FontSize="13" />
                            </Border>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── CHANGES ── -->
            <TabItem Header="Changes" Tag="{x:Static models:DetailTab.Changes}">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,0,12,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Conflicted (only when present) -->
                        <Border Grid.Row="0" Background="{DynamicResource StatusBadBg}" CornerRadius="8"
                                Padding="10,8" Margin="0,0,0,8">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ConflictedFiles.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="Conflicted" Style="{StaticResource PaneHeader}"
                                           Foreground="{DynamicResource StatusBadFg}" />
                                <ItemsControl ItemsSource="{Binding ConflictedFiles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:WorkingFile}">
                                            <TextBlock Text="{Binding Path}" FontSize="12"
                                                       Foreground="{DynamicResource StatusBadFg}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Unstaged -->
                        <Border Grid.Row="1" Background="{DynamicResource ControlFillColorDefaultBrush}"
                                CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource PaneHeader}">
                                        <Run Text="Unstaged" /><Run Text=" (" /><Run Text="{Binding UnstagedFiles.Count, Mode=OneWay}" /><Run Text=")" />
                                    </TextBlock>
                                    <ui:Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="Stage all"
                                               FontSize="11" Padding="8,2"
                                               Command="{Binding StageAllCommand}" />
                                </DockPanel>
                                <!-- Extended selection: the actions below read every selected
                                     row, and the diff pane follows the one just clicked. -->
                                <ListBox x:Name="UnstagedList" Grid.Row="1" ItemsSource="{Binding UnstagedFiles}"
                                         SelectionMode="Extended"
                                         SelectionChanged="OnUnstagedSelectionChanged"
                                         GotKeyboardFocus="OnWorkListGotKeyboardFocus"
                                         ItemTemplate="{StaticResource WorkingFileTemplate}"
                                         ItemContainerStyle="{StaticResource WorkingFileRow}"
                                         Background="Transparent" BorderThickness="0"
                                         PreviewMouseRightButtonDown="OnListRightButtonDown"
                                         AutomationProperties.Name="Unstaged files">
                                    <ListBox.ContextMenu>
                                        <ContextMenu ToolTipService.ShowOnDisabled="True"
                                                     AutomationProperties.Name="Unstaged file actions">
                                            <MenuItem Header="Stage selected"
                                                      Command="{Binding StageSelectedCommand}"
                                                      AutomationProperties.Name="Stage every selected file" />
                                            <MenuItem Header="Discard selected…"
                                                      Command="{Binding DiscardSelectedCommand}"
                                                      AutomationProperties.Name="Discard every selected file" />
                                            <Separator />
                                            <MenuItem Header="History and blame for this file…"
                                                      Command="{Binding OpenFileHistoryCommand}"
                                                      CommandParameter="{Binding SelectedUnstagedFile.Path}"
                                                      AutomationProperties.Name="Open this file's history and blame" />
                                        </ContextMenu>
                                    </ListBox.ContextMenu>
                                </ListBox>
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
                                    <ui:Button Content="Stage" FontSize="11" Padding="8,2" Margin="0,0,6,0"
                                               Command="{Binding StageSelectedCommand}"
                                               AutomationProperties.Name="Stage every selected file" />
                                    <ui:Button Content="Discard" FontSize="11" Padding="8,2"
                                               Command="{Binding DiscardSelectedCommand}"
                                               AutomationProperties.Name="Discard every selected file" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Staged -->
                        <Border Grid.Row="2" Background="{DynamicResource ControlFillColorDefaultBrush}"
                                CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource PaneHeader}">
                                        <Run Text="Staged" /><Run Text=" (" /><Run Text="{Binding StagedFiles.Count, Mode=OneWay}" /><Run Text=")" />
                                    </TextBlock>
                                    <ui:Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="Unstage all"
                                               FontSize="11" Padding="8,2"
                                               Command="{Binding UnstageAllCommand}" />
                                </DockPanel>
                                <ListBox x:Name="StagedList" Grid.Row="1" ItemsSource="{Binding StagedFiles}"
                                         SelectionMode="Extended"
                                         SelectionChanged="OnStagedSelectionChanged"
                                         GotKeyboardFocus="OnWorkListGotKeyboardFocus"
                                         ItemTemplate="{StaticResource StagedFileTemplate}"
                                         ItemContainerStyle="{StaticResource StagedFileRow}"
                                         Background="Transparent" BorderThickness="0"
                                         PreviewMouseRightButtonDown="OnListRightButtonDown"
                                         AutomationProperties.Name="Staged files">
                                    <ListBox.ContextMenu>
                                        <ContextMenu ToolTipService.ShowOnDisabled="True"
                                                     AutomationProperties.Name="Staged file actions">
                                            <MenuItem Header="Unstage selected"
                                                      Command="{Binding UnstageSelectedCommand}"
                                                      AutomationProperties.Name="Unstage every selected file" />
                                            <Separator />
                                            <MenuItem Header="History and blame for this file…"
                                                      Command="{Binding OpenFileHistoryCommand}"
                                                      CommandParameter="{Binding SelectedStagedFile.Path}"
                                                      AutomationProperties.Name="Open this file's history and blame" />
                                        </ContextMenu>
                                    </ListBox.ContextMenu>
                                </ListBox>
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
                                    <ui:Button Content="Unstage" FontSize="11" Padding="8,2"
                                               Command="{Binding UnstageSelectedCommand}"
                                               AutomationProperties.Name="Unstage every selected file" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Commit box -->
                        <Border Grid.Row="3" Background="{DynamicResource ControlFillColorDefaultBrush}"
                                CornerRadius="8" Padding="10,8">
                            <StackPanel>
                                <ui:TextBox Text="{Binding CommitMessage, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="Commit message (Ctrl+Enter to commit)"
                                            AcceptsReturn="True" MinHeight="52" MaxHeight="96"
                                            VerticalScrollBarVisibility="Auto"
                                            AutomationProperties.Name="Commit message">
                                    <ui:TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding CommitCommand}" />
                                    </ui:TextBox.InputBindings>
                                </ui:TextBox>
                                <!-- Guidance, not enforcement: git accepts every message this
                                     counts, so the numbers only report what the reader typed. -->
                                <DockPanel Margin="0,6,0,0">
                                    <ComboBox DockPanel.Dock="Right" Width="150" FontSize="11"
                                              ItemsSource="{Binding RecentSubjects}"
                                              SelectedItem="{Binding SelectedRecentSubject}"
                                              ToolTip="Reuse a subject from this repository's loaded history"
                                              AutomationProperties.Name="Recent commit subjects">
                                        <ComboBox.Style>
                                            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RecentSubjects.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ComboBox.Style>
                                    </ComboBox>
                                    <TextBlock Text="{Binding CommitGuide.CounterText}" FontSize="11"
                                               VerticalAlignment="Center"
                                               AutomationProperties.Name="{Binding CommitGuide.CounterText, StringFormat='Commit message length: {0}'}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CommitGuide.SubjectOverLimit}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource StatusWarnFg}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding CommitGuide.BodyOverLimit}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource StatusWarnFg}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DockPanel>

                                <TextBlock Text="{Binding CommitGuide.Warning}" FontSize="11" Margin="0,4,0,0"
                                           TextWrapping="Wrap" Foreground="{DynamicResource StatusWarnFg}"
                                           AutomationProperties.Name="{Binding CommitGuide.Warning, StringFormat='Commit message warning: {0}'}"
                                           AutomationProperties.LiveSetting="Polite">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CommitGuide.HasWarning}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <DockPanel Margin="0,8,0,0">
                                    <CheckBox DockPanel.Dock="Left" Content="Amend last commit" FontSize="12"
                                              IsChecked="{Binding AmendMode}" />
                                    <ui:Button DockPanel.Dock="Right" HorizontalAlignment="Right"
                                               Content="Commit" Appearance="Primary" FontSize="12" Padding="14,4"
                                               Command="{Binding CommitCommand}" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Diff pane -->
                    <Border Grid.Column="1" Background="{DynamicResource ControlFillColorDefaultBrush}"
                            CornerRadius="8" Padding="10,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{Binding DiffTitle}" Style="{StaticResource PaneHeader}"
                                       FontFamily="Cascadia Code,Consolas" />

                            <!-- Hunk actions apply to the hunk the selected row belongs to. Each
                                 tooltip carries the reason its button is unavailable, so a refused
                                 action never reads as a broken one. -->
                            <DockPanel Grid.Row="1" Margin="0,0,0,6">
                                <ui:Button DockPanel.Dock="Left" Content="Stage hunk" FontSize="11" Padding="8,2"
                                           Margin="0,0,6,0"
                                           Command="{Binding StageHunkCommand}"
                                           ToolTip="{Binding StageHunkBlockedReason}"
                                           AutomationProperties.Name="Stage the selected hunk" />
                                <ui:Button DockPanel.Dock="Left" Content="Unstage hunk" FontSize="11" Padding="8,2"
                                           Margin="0,0,6,0"
                                           Command="{Binding UnstageHunkCommand}"
                                           ToolTip="{Binding UnstageHunkBlockedReason}"
                                           AutomationProperties.Name="Unstage the selected hunk" />
                                <ui:Button DockPanel.Dock="Left" Content="Discard hunk…" FontSize="11" Padding="8,2"
                                           Appearance="Caution"
                                           Command="{Binding DiscardHunkCommand}"
                                           ToolTip="{Binding DiscardHunkBlockedReason}"
                                           AutomationProperties.Name="Discard the selected hunk" />
                                <!-- The layout is a rendering of the rows already loaded, so the
                                     toggle costs no git call and keeps the selected hunk. -->
                                <ui:Button DockPanel.Dock="Right" HorizontalAlignment="Right"
                                           Content="{Binding DiffLayoutLabel}" FontSize="11" Padding="8,2"
                                           Command="{Binding ToggleDiffLayoutCommand}"
                                           ToolTip="Switch between the unified and two-column renderings of this diff"
                                           AutomationProperties.Name="Switch the diff layout" />
                                <TextBlock Margin="12,0,0,0" FontSize="11" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Text="Select a line to choose its hunk; double-click a hunk header to stage or unstage it." />
                            </DockPanel>

                            <TextBlock Grid.Row="2" Margin="0,0,0,6" FontSize="12" TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="DiffTruncatedNotice"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="This diff was too large to read in full — the rows below stop where the read did, and hunk actions are unavailable."
                                       Visibility="{Binding DiffIsTruncated, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <TextBlock Grid.Row="3" Text="Binary file — no text diff." FontSize="12"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Visibility="{Binding DiffIsBinary, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <!-- Binary diffs parse to zero lines, so the empty list simply
                                 sits behind the binary note above. -->
                            <ListBox x:Name="WorkingDiffRows" Grid.Row="3" ItemsSource="{Binding DiffLines}"
                                     SelectedItem="{Binding SelectedDiffLine}"
                                     Style="{StaticResource DiffListStyle}"
                                     Visibility="{Binding DiffUnified, Converter={StaticResource BooleanToVisibilityConverter}}"
                                     SelectionChanged="OnWorkingDiffSelectionChanged"
                                     MouseDoubleClick="OnWorkingDiffDoubleClick"
                                     PreviewMouseRightButtonDown="OnListRightButtonDown"
                                     AutomationProperties.Name="File diff">
                                <ListBox.ContextMenu>
                                    <ContextMenu ToolTipService.ShowOnDisabled="True"
                                                 AutomationProperties.Name="Hunk actions">
                                        <MenuItem Header="Stage this hunk"
                                                  Command="{Binding StageHunkCommand}"
                                                  ToolTip="{Binding StageHunkBlockedReason}"
                                                  AutomationProperties.Name="Stage the selected hunk" />
                                        <MenuItem Header="Unstage this hunk"
                                                  Command="{Binding UnstageHunkCommand}"
                                                  ToolTip="{Binding UnstageHunkBlockedReason}"
                                                  AutomationProperties.Name="Unstage the selected hunk" />
                                        <MenuItem Header="Discard this hunk…"
                                                  Command="{Binding DiscardHunkCommand}"
                                                  ToolTip="{Binding DiscardHunkBlockedReason}"
                                                  AutomationProperties.Name="Discard the selected hunk" />
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                            </ListBox>

                            <!-- Same rows, same hunk indexes, same selection: the two panes are
                                 one diff rendered two ways, and only one of them is up. -->
                            <ListBox x:Name="WorkingDiffColumns" Grid.Row="3" ItemsSource="{Binding DiffRows}"
                                     SelectedItem="{Binding SelectedDiffRow}"
                                     Style="{StaticResource SideBySideListStyle}"
                                     Visibility="{Binding DiffSideBySide, Converter={StaticResource BooleanToVisibilityConverter}}"
                                     SelectionChanged="OnWorkingDiffSelectionChanged"
                                     MouseDoubleClick="OnWorkingDiffDoubleClick"
                                     PreviewMouseRightButtonDown="OnListRightButtonDown"
                                     AutomationProperties.Name="File diff, side by side">
                                <ListBox.ContextMenu>
                                    <ContextMenu ToolTipService.ShowOnDisabled="True"
                                                 AutomationProperties.Name="Hunk actions">
                                        <MenuItem Header="Stage this hunk"
                                                  Command="{Binding StageHunkCommand}"
                                                  ToolTip="{Binding StageHunkBlockedReason}"
                                                  AutomationProperties.Name="Stage the selected hunk" />
                                        <MenuItem Header="Unstage this hunk"
                                                  Command="{Binding UnstageHunkCommand}"
                                                  ToolTip="{Binding UnstageHunkBlockedReason}"
                                                  AutomationProperties.Name="Unstage the selected hunk" />
                                        <MenuItem Header="Discard this hunk…"
                                                  Command="{Binding DiscardHunkCommand}"
                                                  ToolTip="{Binding DiscardHunkBlockedReason}"
                                                  AutomationProperties.Name="Discard the selected hunk" />
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ── HISTORY ── -->
            <TabItem Header="History" Tag="{x:Static models:DetailTab.History}">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <DockPanel>
                            <ui:Button DockPanel.Dock="Right" Content="Rewrite history…" Appearance="Danger"
                                       FontSize="12" Padding="12,4"
                                       Icon="{ui:SymbolIcon History24}"
                                       Command="{Binding OpenRewriteWizardCommand}"
                                       ToolTip="Rewrite this repository's history — replace text, remove files, or fix authorship"
                                       AutomationProperties.Name="Rewrite history" />
                            <!-- The durable route to a backup: the wizard's Undo belongs to one live
                                 session, and closing it takes the only in-session restore with it. -->
                            <ui:Button DockPanel.Dock="Right" Content="Backups…" FontSize="12" Padding="12,4"
                                       Margin="0,0,8,0"
                                       Icon="{ui:SymbolIcon ArrowUndo24}"
                                       Command="{Binding OpenBackupsCommand}"
                                       ToolTip="Browse the backups taken before this repository's history operations, and restore one"
                                       AutomationProperties.Name="Browse backups" />
                            <!-- Tags name commits in this list, and a new one lands on whichever
                                 commit is selected here. -->
                            <ui:Button DockPanel.Dock="Right" Content="Tags…" FontSize="12" Padding="12,4"
                                       Margin="0,0,8,0"
                                       Icon="{ui:SymbolIcon Tag24}"
                                       Command="{Binding OpenTagsCommand}"
                                       ToolTip="This repository's tags, and a way to create, delete, or check one out — all local"
                                       AutomationProperties.Name="Open the tag viewer" />
                            <!-- Where a replaced history is still reachable from, which is why it
                                 sits beside the action that expires it. -->
                            <ui:Button DockPanel.Dock="Right" Content="Reflog…" FontSize="12" Padding="12,4"
                                       Margin="0,0,8,0"
                                       Icon="{ui:SymbolIcon ClockArrowDownload24}"
                                       Command="{Binding OpenReflogCommand}"
                                       ToolTip="Every position this repository's refs have held, and a way to check one out as a new branch"
                                       AutomationProperties.Name="Open the reflog viewer" />
                            <ui:Button DockPanel.Dock="Right" Content="Commit graph…" FontSize="12" Padding="12,4"
                                       Margin="0,0,8,0"
                                       Icon="{ui:SymbolIcon BranchFork24}"
                                       Command="{Binding OpenCommitGraphCommand}"
                                       ToolTip="Draw this repository's branch lanes, with paging and selection shared with the list below"
                                       AutomationProperties.Name="Open the commit graph" />
                            <ui:Button DockPanel.Dock="Right" Content="Deep clean…" Appearance="Danger"
                                       FontSize="12" Padding="12,4" Margin="0,0,8,0"
                                       Icon="{ui:SymbolIcon Broom24}"
                                       Command="{Binding DeepCleanCommand}"
                                       Visibility="{Binding DangerZoneEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       ToolTip="Expire every reflog and prune, so a completed rewrite's replaced commits stop being reachable here"
                                       AutomationProperties.Name="Deep clean this repository" />
                            <TextBlock FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="Rewriting replaces commits with new ones. A backup is taken first and nothing is pushed." />
                        </DockPanel>
                        <TextBlock Text="{Binding DeepCleanStatusText}" FontSize="12" TextWrapping="Wrap"
                                   Margin="0,8,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   AutomationProperties.AutomationId="DeepCleanStatusText"
                                   AutomationProperties.LiveSetting="Polite">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DeepCleanStatusText}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380" />
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{DynamicResource ControlFillColorDefaultBrush}"
                            CornerRadius="8" Padding="10,8" Margin="0,0,12,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Commits" Style="{StaticResource PaneHeader}" />
                            <ListBox x:Name="HistoryList" Grid.Row="1" ItemsSource="{Binding Commits}"
                                     SelectedItem="{Binding SelectedCommit}"
                                     Background="Transparent" BorderThickness="0"
                                     GotKeyboardFocus="OnWorkListGotKeyboardFocus"
                                     PreviewMouseRightButtonDown="OnListRightButtonDown"
                                     AutomationProperties.Name="Commit history">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="AutomationProperties.Name">
                                            <Setter.Value>
                                                <MultiBinding StringFormat="{}{0}, commit {1}">
                                                    <Binding Path="Message" />
                                                    <Binding Path="ShortHash" />
                                                </MultiBinding>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ContextMenu>
                                    <ContextMenu ToolTipService.ShowOnDisabled="True"
                                                 AutomationProperties.Name="Commit actions">
                                        <MenuItem Header="Reword…"
                                                  Command="{Binding RewordSelectedCommitCommand}"
                                                  ToolTip="{Binding SurgeryBlockedReason}"
                                                  AutomationProperties.Name="Reword this commit" />
                                        <MenuItem Header="Squash into previous…"
                                                  Command="{Binding SquashSelectedIntoPreviousCommand}"
                                                  ToolTip="{Binding SquashIntoPreviousBlockedReason}"
                                                  AutomationProperties.Name="Squash this commit into the previous one" />
                                        <MenuItem Header="Drop…"
                                                  Command="{Binding DropSelectedCommitCommand}"
                                                  ToolTip="{Binding SurgeryBlockedReason}"
                                                  AutomationProperties.Name="Drop this commit" />
                                        <MenuItem Header="Amend staged changes into this commit…"
                                                  Command="{Binding AmendStagedIntoSelectedCommitCommand}"
                                                  ToolTip="{Binding AmendIntoCommitBlockedReason}"
                                                  AutomationProperties.Name="Fold the staged changes into this commit" />
                                        <Separator />
                                        <MenuItem Header="Reset to here"
                                                  AutomationProperties.Name="Reset this branch to this commit">
                                            <MenuItem Header="Soft — keep the changes staged"
                                                      Command="{Binding ResetSoftToSelectedCommitCommand}"
                                                      ToolTip="{Binding ResetBlockedReason}"
                                                      AutomationProperties.Name="Soft reset to this commit" />
                                            <MenuItem Header="Mixed — keep the changes unstaged"
                                                      Command="{Binding ResetMixedToSelectedCommitCommand}"
                                                      ToolTip="{Binding ResetBlockedReason}"
                                                      AutomationProperties.Name="Mixed reset to this commit" />
                                            <MenuItem Header="Hard — discard the changes"
                                                      Command="{Binding ResetHardToSelectedCommitCommand}"
                                                      ToolTip="{Binding SurgeryBlockedReason}"
                                                      AutomationProperties.Name="Hard reset to this commit" />
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="Revert…"
                                                  Command="{Binding RevertSelectedCommitCommand}"
                                                  ToolTip="{Binding SurgeryBlockedReason}"
                                                  AutomationProperties.Name="Revert this commit" />
                                        <MenuItem Header="Cherry-pick onto current branch…"
                                                  Command="{Binding CherryPickSelectedCommitCommand}"
                                                  ToolTip="{Binding SurgeryBlockedReason}"
                                                  AutomationProperties.Name="Cherry-pick this commit onto the current branch" />
                                        <Separator />
                                        <MenuItem Header="Plan a reorder from here…"
                                                  Command="{Binding PlanHistoryEditCommand}"
                                                  ToolTip="{Binding SurgeryBlockedReason}"
                                                  AutomationProperties.Name="Plan a reorder, drop, or squash over this range" />
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:GitCommit}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Width="64"
                                                       Text="{Binding ShortHash}"
                                                       FontFamily="Cascadia Code,Consolas" FontSize="12"
                                                       Foreground="{DynamicResource StatusInfoFg}" />
                                            <TextBlock DockPanel.Dock="Right" MinWidth="56"
                                                       Text="{Binding Date, Converter={StaticResource RelativeTimeConverter}}"
                                                       FontSize="11" HorizontalAlignment="Right"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <TextBlock Text="{Binding Message}" FontSize="12"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Message}"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel Grid.Row="2" Margin="0,8,0,0">
                                <!-- Paging keeps the list a contiguous walk from HEAD: the depth a
                                     history edit is planned over is this list's row position, so a
                                     page that did not continue the same walk is refused, not appended. -->
                                <DockPanel Margin="0,0,0,6">
                                    <ui:Button DockPanel.Dock="Left" Content="Load older commits" FontSize="11" Padding="8,3"
                                               Margin="0,0,8,0"
                                               Command="{Binding LoadOlderCommitsCommand}"
                                               Visibility="{Binding HistoryHasMore, Converter={StaticResource BooleanToVisibilityConverter}}"
                                               AutomationProperties.Name="Load older commits into the history list" />
                                    <TextBlock Text="{Binding HistoryPagingStatusText}" FontSize="11" TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               AutomationProperties.AutomationId="HistoryPagingStatusText"
                                               AutomationProperties.LiveSetting="Polite" />
                                </DockPanel>
                                <ui:Button Content="Plan a reorder from the selected commit…" FontSize="11" Padding="8,3"
                                           HorizontalAlignment="Left" Margin="0,0,0,6"
                                           Command="{Binding PlanHistoryEditCommand}"
                                           ToolTip="{Binding SurgeryBlockedReason}"
                                           AutomationProperties.Name="Plan a reorder, drop, or squash over this range" />
                                <TextBlock Text="{Binding SurgeryStatusText}" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           AutomationProperties.Name="{Binding SurgeryStatusText, StringFormat='History edit status: {0}'}"
                                           AutomationProperties.LiveSetting="Polite" />
                                <TextBlock Text="{Binding SurgeryFailureText}" FontSize="11" TextWrapping="Wrap"
                                           Margin="0,4,0,0" Foreground="{DynamicResource StatusBadFg}"
                                           AutomationProperties.Name="{Binding SurgeryFailureText, StringFormat='History edit failure: {0}'}"
                                           AutomationProperties.LiveSetting="Assertive">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SurgeryFailureText}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ui:Button Content="Retry and stop at the conflict for the terminal" FontSize="11" Padding="8,3"
                                           HorizontalAlignment="Left" Margin="0,6,0,0"
                                           Command="{Binding RetrySurgeryLeavingItStoppedCommand}"
                                           Visibility="{Binding SurgeryLeaveStoppedOfferVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                           AutomationProperties.Name="Retry, leaving the rebase stopped at the conflict" />
                                <ui:Button Content="Stash the uncommitted changes" FontSize="11" Padding="8,3"
                                           HorizontalAlignment="Left" Margin="0,6,0,0"
                                           Command="{Binding StashBeforeSurgeryCommand}"
                                           Visibility="{Binding SurgeryStashOfferVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                           AutomationProperties.Name="Stash the uncommitted changes blocking this edit" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                            Visibility="{Binding SurgerySigningOfferVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ui:Button Content="Sign as configured" FontSize="11" Padding="8,3" Margin="0,0,6,0"
                                               Command="{Binding RetrySurgerySignedCommand}"
                                               AutomationProperties.Name="Run the edit, signing every commit as this repository is configured to" />
                                    <ui:Button Content="Run without signing" FontSize="11" Padding="8,3"
                                               Appearance="Caution"
                                               Command="{Binding RetrySurgeryUnsignedCommand}"
                                               AutomationProperties.Name="Run the edit with commit signing turned off for this run" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                            Visibility="{Binding SurgeryUndoVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ui:Button Content="{Binding SurgeryUndoLabel}" FontSize="11" Padding="10,3"
                                               Appearance="Caution" Margin="0,0,6,0"
                                               Command="{Binding UndoLastSurgeryCommand}"
                                               AutomationProperties.Name="Restore the backup taken before the last history edit" />
                                    <ui:Button Content="Dismiss" FontSize="11" Padding="8,3"
                                               Command="{Binding DismissSurgeryUndoCommand}"
                                               AutomationProperties.Name="Hide the undo offer" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Background="{DynamicResource ControlFillColorDefaultBrush}"
                            CornerRadius="8" Padding="10,8" Margin="0,0,12,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Changed files" Style="{StaticResource PaneHeader}" />
                            <ListBox Grid.Row="1" ItemsSource="{Binding CommitFiles}"
                                     SelectedItem="{Binding SelectedCommitFile}"
                                     Background="Transparent" BorderThickness="0"
                                     PreviewMouseRightButtonDown="OnListRightButtonDown"
                                     AutomationProperties.Name="Files changed in commit">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="AutomationProperties.Name">
                                            <Setter.Value>
                                                <MultiBinding StringFormat="{}{0} {1}">
                                                    <Binding Path="StatusLabel" />
                                                    <Binding Path="Path" />
                                                </MultiBinding>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ContextMenu>
                                    <ContextMenu ToolTipService.ShowOnDisabled="True"
                                                 AutomationProperties.Name="Changed file actions">
                                        <MenuItem Header="History and blame for this file…"
                                                  Command="{Binding OpenFileHistoryCommand}"
                                                  CommandParameter="{Binding SelectedCommitFile.Path}"
                                                  AutomationProperties.Name="Open this file's history and blame" />
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:CommitFile}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Width="18" Text="{Binding Status}"
                                                       FontFamily="Cascadia Code,Consolas" FontSize="12"
                                                       Foreground="{DynamicResource StatusWarnFg}" />
                                            <TextBlock Text="{Binding Path}" FontSize="12"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Grid.Row="2" Margin="0,6,0,0">
                                <ui:Button Content="History and blame for this file…" FontSize="11" Padding="8,3"
                                           HorizontalAlignment="Left" Margin="0,0,0,6"
                                           Command="{Binding OpenFileHistoryCommand}"
                                           CommandParameter="{Binding SelectedCommitFile.Path}"
                                           ToolTip="Every commit that touched this path, followed across renames, beside a blame of its current content"
                                           AutomationProperties.Name="Open this file's history and blame" />
                                <ui:Button Content="View commit on GitHub" FontSize="11" Padding="8,3"
                                           HorizontalAlignment="Left"
                                           Command="{Binding OpenCommitCommand}"
                                           CommandParameter="{Binding SelectedCommit}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Background="{DynamicResource ControlFillColorDefaultBrush}"
                            CornerRadius="8" Padding="10,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{Binding SelectedCommitFile.Path, FallbackValue=Diff}"
                                       Style="{StaticResource PaneHeader}" FontFamily="Cascadia Code,Consolas" />
                            <TextBlock Grid.Row="1" Margin="0,0,0,6" FontSize="12" TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="CommitDiffTruncatedNotice"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="This diff was too large to read in full — the rows below stop where the read did."
                                       Visibility="{Binding CommitDiffIsTruncated, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ListBox Grid.Row="2" ItemsSource="{Binding CommitDiffLines}"
                                     Style="{StaticResource DiffListStyle}"
                                     Visibility="{Binding DiffUnified, Converter={StaticResource BooleanToVisibilityConverter}}"
                                     AutomationProperties.Name="Commit diff" />
                            <ListBox Grid.Row="2" ItemsSource="{Binding CommitDiffRows}"
                                     Style="{StaticResource SideBySideListStyle}"
                                     Visibility="{Binding DiffSideBySide, Converter={StaticResource BooleanToVisibilityConverter}}"
                                     AutomationProperties.Name="Commit diff, side by side" />
                        </Grid>
                    </Border>
                </Grid>
                </Grid>
            </TabItem>

            <!-- ── BRANCHES ── -->
            <TabItem Header="Branches" Tag="{x:Static models:DetailTab.Branches}">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- A branch behind its upstream cannot be published by an ordinary push, which
                         is what a rewrite leaves behind on every branch it touched. -->
                    <Border Grid.Row="0" Background="{DynamicResource StatusWarnBg}"
                            BorderBrush="{DynamicResource StatusWarnFg}" BorderThickness="1"
                            CornerRadius="8" Padding="14,10" Margin="0,0,0,10"
                            AutomationProperties.AutomationId="BranchesDivergedNotice"
                            Visibility="{Binding BranchesDivergedFromRemote, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DockPanel>
                            <ui:Button DockPanel.Dock="Right" Content="Push rewritten history…" Appearance="Danger"
                                       FontSize="12" Padding="12,4" Margin="12,0,0,0" VerticalAlignment="Center"
                                       Icon="{ui:SymbolIcon CloudArrowUp24}"
                                       Command="{Binding OpenForcePushCommand}"
                                       AutomationProperties.Name="Review and force-push the diverged branches" />
                            <TextBlock TextWrapping="Wrap" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Text="At least one branch here holds commits its remote does not, and the remote holds commits it does not — which is what a history rewrite leaves. Publishing those branches replaces what the remote has, so it happens only through the reviewed, typed-confirmation flow." />
                        </DockPanel>
                    </Border>

                    <DockPanel Grid.Row="1" Margin="0,0,0,10">
                        <ui:Button DockPanel.Dock="Right" Content="Refresh" FontSize="12" Padding="10,4" Margin="8,0,0,0"
                                   Icon="{ui:SymbolIcon ArrowSync24}"
                                   Command="{Binding LoadBranchesTabCommand}"
                                   AutomationProperties.Name="Reload the branches and remotes" />
                        <ui:Button DockPanel.Dock="Right" Content="Create branch" FontSize="12" Padding="10,4" Margin="8,0,0,0"
                                   Appearance="Primary"
                                   Command="{Binding CreateBranchCommand}" />
                        <ui:TextBox Text="{Binding NewBranchName, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="new-branch-name (creates from current HEAD and switches)"
                                    AutomationProperties.Name="New branch name">
                            <ui:TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding CreateBranchCommand}" />
                            </ui:TextBox.InputBindings>
                        </ui:TextBox>
                    </DockPanel>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="440" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" Margin="0,0,12,0"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            CornerRadius="8" Padding="10,8">
                        <ListBox ItemsSource="{Binding Branches}"
                                 SelectedItem="{Binding SelectedBranch}"
                                 Background="Transparent" BorderThickness="0"
                                 AutomationProperties.Name="Local branches">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="AutomationProperties.Name">
                                        <Setter.Value>
                                            <MultiBinding StringFormat="{}{0} {1}">
                                                <Binding Path="Name" />
                                                <Binding Path="TrackLabel" />
                                            </MultiBinding>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:BranchInfo}">
                                    <DockPanel Margin="0,2">
                                        <ui:SymbolIcon DockPanel.Dock="Left" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <ui:SymbolIcon.Style>
                                                <Style TargetType="ui:SymbolIcon">
                                                    <Setter Property="Symbol" Value="BranchFork24" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter Property="Symbol" Value="CheckmarkCircle24" />
                                                            <Setter Property="Foreground" Value="{DynamicResource StatusGoodFg}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:SymbolIcon.Style>
                                        </ui:SymbolIcon>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding LastCommit, Converter={StaticResource RelativeTimeConverter}}"
                                                       FontSize="11" Margin="0,0,12,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <ui:Button Content="Switch" FontSize="11" Padding="8,2" Margin="0,0,6,0"
                                                       Command="{Binding DataContext.SwitchBranchCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                       CommandParameter="{Binding}">
                                                <ui:Button.Style>
                                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:Button.Style>
                                            </ui:Button>
                                            <ui:Button Content="Delete" FontSize="11" Padding="8,2"
                                                       Command="{Binding DataContext.DeleteBranchCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                       CommandParameter="{Binding}">
                                                <ui:Button.Style>
                                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:Button.Style>
                                            </ui:Button>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontFamily="Cascadia Code,Consolas"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <Border Background="{DynamicResource StatusInfoBg}" CornerRadius="4" Padding="6,1"
                                                Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding TrackLabel}" FontSize="10"
                                                       Foreground="{DynamicResource StatusInfoFg}" />
                                        </Border>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <!-- ── SELECTED BRANCH ── -->
                    <Border Grid.Row="1" Grid.Column="0" Margin="0,12,12,0"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            CornerRadius="8" Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedBranch.Name, FallbackValue=Selected branch, TargetNullValue=Selected branch}"
                                       Style="{StaticResource PaneHeader}" FontFamily="Cascadia Code,Consolas" />
                            <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="All local. Renaming a branch here leaves the branch on any remote under its old name, and an upstream is a link only — setting or clearing one fetches and pushes nothing." />

                            <DockPanel Margin="0,0,0,6">
                                <ui:Button DockPanel.Dock="Right" Content="Rename" FontSize="11" Padding="10,3"
                                           Margin="8,0,0,0"
                                           Command="{Binding RenameSelectedBranchCommand}"
                                           AutomationProperties.Name="Rename the selected branch" />
                                <ui:TextBox Text="{Binding BranchRenameTo, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="new name for the selected branch"
                                            FontSize="12" FontFamily="Cascadia Code,Consolas"
                                            AutomationProperties.Name="New name for the selected branch">
                                    <ui:TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding RenameSelectedBranchCommand}" />
                                    </ui:TextBox.InputBindings>
                                </ui:TextBox>
                            </DockPanel>

                            <DockPanel Margin="0,0,0,6">
                                <TextBlock DockPanel.Dock="Left" Text="Upstream" FontSize="12" VerticalAlignment="Center"
                                           Margin="0,0,10,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ui:Button DockPanel.Dock="Right" Content="Clear" FontSize="11" Padding="10,3"
                                           Margin="8,0,0,0"
                                           Command="{Binding UnsetBranchUpstreamCommand}"
                                           AutomationProperties.Name="Clear the selected branch's upstream" />
                                <ui:Button DockPanel.Dock="Right" Content="Set" FontSize="11" Padding="10,3"
                                           Margin="8,0,0,0"
                                           Command="{Binding SetBranchUpstreamCommand}"
                                           AutomationProperties.Name="Set the selected branch's upstream" />
                                <ComboBox ItemsSource="{Binding UpstreamChoices}"
                                          SelectedItem="{Binding SelectedUpstreamChoice}"
                                          FontFamily="Cascadia Code,Consolas" FontSize="12"
                                          AutomationProperties.Name="Remote-tracking branch to track" />
                            </DockPanel>

                            <DockPanel Margin="0,0,0,6">
                                <TextBlock DockPanel.Dock="Left" Text="Compare with" FontSize="12" VerticalAlignment="Center"
                                           Margin="0,0,10,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ui:Button DockPanel.Dock="Right" Content="Compare" FontSize="11" Padding="10,3"
                                           Margin="8,0,0,0"
                                           Command="{Binding CompareSelectedBranchCommand}"
                                           AutomationProperties.Name="Count the commits between the selected branch and another ref" />
                                <ComboBox ItemsSource="{Binding CompareBaseChoices}"
                                          SelectedItem="{Binding SelectedCompareBase}"
                                          FontFamily="Cascadia Code,Consolas" FontSize="12"
                                          AutomationProperties.Name="Ref to compare the selected branch with" />
                            </DockPanel>

                            <TextBlock Text="{Binding BranchCompareText}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       AutomationProperties.AutomationId="BranchCompareText">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BranchCompareText}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Text="{Binding BranchExtrasStatusText}" FontSize="11" TextWrapping="Wrap"
                                       Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       AutomationProperties.AutomationId="BranchExtrasStatusText"
                                       AutomationProperties.LiveSetting="Polite" />
                            <TextBlock Text="{Binding BranchExtrasErrorText}" FontSize="11" TextWrapping="Wrap"
                                       Margin="0,4,0,0" Foreground="{DynamicResource StatusBadFg}"
                                       AutomationProperties.AutomationId="BranchExtrasErrorText"
                                       AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </Border>

                    <!-- ── REMOTES ── -->
                    <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Margin="0,0,0,0"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            CornerRadius="8" Padding="10,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Remotes" Style="{StaticResource PaneHeader}" />

                            <Border Grid.Row="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    AutomationProperties.AutomationId="RemotesEmptyState"
                                    Visibility="{Binding RemotesEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="This repository has no remotes configured. Fetch, pull, and push have nowhere to go until one is added." />
                            </Border>

                            <ListBox Grid.Row="2" ItemsSource="{Binding Remotes}"
                                     SelectedItem="{Binding SelectedRemote}"
                                     Background="Transparent" BorderThickness="0"
                                     HorizontalContentAlignment="Stretch"
                                     AutomationProperties.Name="Configured remotes">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="AutomationProperties.Name">
                                            <Setter.Value>
                                                <MultiBinding StringFormat="{}{0}, {1}">
                                                    <Binding Path="Name" />
                                                    <Binding Path="FetchUrl" />
                                                </MultiBinding>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:RemoteEntry}">
                                        <StackPanel Margin="0,3">
                                            <TextBlock Text="{Binding Name}" FontSize="13"
                                                       FontFamily="Cascadia Code,Consolas"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <TextBlock Text="{Binding FetchUrl, StringFormat=fetch {0}}" FontSize="11"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding FetchUrl}"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <TextBlock Text="{Binding PushUrl, StringFormat=push  {0}}" FontSize="11"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding PushUrl}"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel Grid.Row="3" Margin="0,8,0,0">
                                <DockPanel Margin="0,0,0,6">
                                    <ui:Button DockPanel.Dock="Right" Content="Rename" FontSize="11" Padding="10,3"
                                               Margin="8,0,0,0"
                                               Command="{Binding RenameRemoteCommand}"
                                               AutomationProperties.Name="Rename the selected remote" />
                                    <ui:TextBox Text="{Binding RemoteRenameTo, UpdateSourceTrigger=PropertyChanged}"
                                                PlaceholderText="name" FontSize="12"
                                                FontFamily="Cascadia Code,Consolas"
                                                AutomationProperties.Name="New name for the selected remote" />
                                </DockPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <ui:Button DockPanel.Dock="Right" Content="Change URL" FontSize="11" Padding="10,3"
                                               Margin="8,0,0,0"
                                               Command="{Binding SetRemoteUrlCommand}"
                                               AutomationProperties.Name="Change the selected remote's fetch URL" />
                                    <ui:TextBox Text="{Binding RemoteUrlEdit, UpdateSourceTrigger=PropertyChanged}"
                                                PlaceholderText="fetch URL" FontSize="12"
                                                AutomationProperties.Name="Fetch URL for the selected remote" />
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <ui:Button Content="Remove remote" FontSize="11" Padding="10,3" Appearance="Danger"
                                               Command="{Binding RemoveRemoteCommand}"
                                               AutomationProperties.Name="Remove the selected remote" />
                                    <ui:Button Content="Prune…" FontSize="11" Padding="10,3" Margin="8,0,0,0"
                                               Command="{Binding PruneRemoteCommand}"
                                               ToolTip="Drop this repository's tracking refs for branches the remote no longer has — shows what would go first"
                                               AutomationProperties.Name="Prune the selected remote's stale tracking branches" />
                                </StackPanel>

                                <TextBlock Text="Add a remote" Style="{StaticResource PaneHeader}" />
                                <DockPanel Margin="0,0,0,6">
                                    <ui:TextBox DockPanel.Dock="Left" Width="110"
                                                Text="{Binding NewRemoteName, UpdateSourceTrigger=PropertyChanged}"
                                                PlaceholderText="name" FontSize="12" Margin="0,0,8,0"
                                                FontFamily="Cascadia Code,Consolas"
                                                AutomationProperties.Name="Name for the new remote" />
                                    <ui:Button DockPanel.Dock="Right" Content="Add" FontSize="11" Padding="12,3"
                                               Margin="8,0,0,0" Appearance="Primary"
                                               Command="{Binding AddRemoteCommand}"
                                               AutomationProperties.Name="Add the remote" />
                                    <ui:TextBox Text="{Binding NewRemoteUrl, UpdateSourceTrigger=PropertyChanged}"
                                                PlaceholderText="URL" FontSize="12"
                                                AutomationProperties.Name="URL for the new remote">
                                        <ui:TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding AddRemoteCommand}" />
                                        </ui:TextBox.InputBindings>
                                    </ui:TextBox>
                                </DockPanel>

                                <TextBlock Text="Branches on a remote" Style="{StaticResource PaneHeader}" />
                            </StackPanel>

                            <Grid Grid.Row="4">
                                <Border CornerRadius="6" Padding="10,8" VerticalAlignment="Top"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                        AutomationProperties.AutomationId="RemoteBranchesEmptyState"
                                        Visibility="{Binding RemoteBranchesEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock FontSize="12" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="No remote-tracking branches are recorded here. A clone that has never fetched reads the same way as a remote with no branches." />
                                </Border>

                                <ListBox ItemsSource="{Binding RemoteBranches}"
                                         SelectedItem="{Binding SelectedRemoteBranch}"
                                         Background="Transparent" BorderThickness="0"
                                         AutomationProperties.Name="Remote-tracking branches">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontSize="12"
                                                       FontFamily="Cascadia Code,Consolas"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>

                            <StackPanel Grid.Row="5" Margin="0,8,0,0">
                                <DockPanel Margin="0,0,0,6">
                                    <ui:Button DockPanel.Dock="Right" Content="Check out locally" FontSize="11"
                                               Padding="10,3" Margin="8,0,0,0"
                                               Command="{Binding CheckoutRemoteBranchCommand}"
                                               ToolTip="Create a local branch tracking the selected remote branch and switch to it"
                                               AutomationProperties.Name="Check the selected remote branch out as a local branch" />
                                    <ui:TextBox Text="{Binding RemoteBranchLocalName, UpdateSourceTrigger=PropertyChanged}"
                                                PlaceholderText="local branch name" FontSize="12"
                                                FontFamily="Cascadia Code,Consolas"
                                                AutomationProperties.Name="Name for the local branch">
                                        <ui:TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding CheckoutRemoteBranchCommand}" />
                                        </ui:TextBox.InputBindings>
                                    </ui:TextBox>
                                </DockPanel>
                                <ui:Button Content="Delete on the remote…" FontSize="11" Padding="10,3"
                                           Appearance="Danger" HorizontalAlignment="Left"
                                           Command="{Binding DeleteRemoteBranchCommand}"
                                           ToolTip="Remove the selected branch from the remote repository — takes a typed confirmation"
                                           AutomationProperties.Name="Delete the selected branch on its remote" />
                                <TextBlock Text="{Binding RemotesStatusText}" FontSize="11" TextWrapping="Wrap"
                                           Margin="0,6,0,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           AutomationProperties.AutomationId="RemotesStatusText"
                                           AutomationProperties.LiveSetting="Polite" />
                                <TextBlock Text="{Binding RemotesErrorText}" FontSize="11" TextWrapping="Wrap"
                                           Margin="0,4,0,0" Foreground="{DynamicResource StatusBadFg}"
                                           AutomationProperties.AutomationId="RemotesErrorText"
                                           AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ── ISSUES ── -->
            <TabItem Header="Issues" Tag="{x:Static models:DetailTab.Issues}">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <ui:Button DockPanel.Dock="Right" Content="Refresh" FontSize="12" Padding="10,4" Margin="8,0,0,0"
                                   Icon="{ui:SymbolIcon ArrowSync24}"
                                   Command="{Binding RefreshIssuesCommand}"
                                   AutomationProperties.Name="Refresh issues" />
                        <ui:Button DockPanel.Dock="Right" Content="New Issue" FontSize="12" Padding="10,4"
                                   Appearance="Primary" Icon="{ui:SymbolIcon Add24}"
                                   Command="{Binding ShowNewIssueCommand}"
                                   AutomationProperties.Name="New issue" />
                        <TextBlock FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding GitHubStatusText}"
                                   AutomationProperties.LiveSetting="Polite" />
                    </DockPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="380" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Issue list -->
                        <Border Grid.Column="0" Background="{DynamicResource ControlFillColorDefaultBrush}"
                                CornerRadius="8" Padding="10,8" Margin="0,0,12,0">
                            <Grid>
                                <TextBlock Text="{Binding IssuesError}" FontSize="12" TextWrapping="Wrap"
                                           VerticalAlignment="Top" Foreground="{DynamicResource StatusBadFg}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IssuesError}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="No open issues." FontSize="12"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Issues.Count}" Value="0" />
                                                        <Condition Binding="{Binding IssuesError}" Value="" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ListBox ItemsSource="{Binding Issues}"
                                         SelectedItem="{Binding SelectedIssue}"
                                         Background="Transparent" BorderThickness="0"
                                         AutomationProperties.Name="Open issues">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="4,4" />
                                            <Setter Property="AutomationProperties.Name">
                                                <Setter.Value>
                                                    <MultiBinding StringFormat="{}Issue {0}: {1}">
                                                        <Binding Path="Number" />
                                                        <Binding Path="Title" />
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                            <EventSetter Event="MouseDoubleClick" Handler="IssueRow_Open" />
                                            <EventSetter Event="KeyDown" Handler="IssueRow_KeyDown" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:GitHubIssue}">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Width="52" FontSize="12"
                                                           FontFamily="Cascadia Code,Consolas"
                                                           Foreground="{DynamicResource StatusInfoFg}">
                                                    <Run Text="#" /><Run Text="{Binding Number, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock DockPanel.Dock="Right" MinWidth="52" FontSize="11" HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding UpdatedAt, Converter={StaticResource RelativeTimeConverter}}"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                <TextBlock Text="{Binding Title}" FontSize="13"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <!-- Right pane: compose form OR issue detail OR hint -->
                        <Border Grid.Column="1" Background="{DynamicResource ControlFillColorDefaultBrush}"
                                CornerRadius="8" Padding="16,12">
                            <Grid>
                                <!-- Hint (no selection, not composing) -->
                                <TextBlock Text="Select an issue to view its thread, or click New Issue."
                                           FontSize="13" VerticalAlignment="Top"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding SelectedIssue}" Value="{x:Null}" />
                                                        <Condition Binding="{Binding IssueComposeVisible}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Compose new issue -->
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              Visibility="{Binding IssueComposeVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="New Issue" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="Title" FontSize="12" Margin="0,0,0,2"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <ui:TextBox Text="{Binding NewIssueTitle, UpdateSourceTrigger=PropertyChanged}"
                                                    PlaceholderText="Short summary" Margin="0,0,0,8"
                                                    AutomationProperties.Name="New issue title" />
                                        <TextBlock Text="Body (Markdown)" FontSize="12" Margin="0,0,0,2"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <ui:TextBox Text="{Binding NewIssueBody, UpdateSourceTrigger=PropertyChanged}"
                                                    AcceptsReturn="True" MinHeight="120" MaxHeight="240"
                                                    VerticalScrollBarVisibility="Auto" Margin="0,0,0,8"
                                                    AutomationProperties.Name="New issue body" />
                                        <TextBlock Text="Labels (comma-separated)" FontSize="12" Margin="0,0,0,2"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <ui:TextBox Text="{Binding NewIssueLabels, UpdateSourceTrigger=PropertyChanged}"
                                                    PlaceholderText="bug, p1" Margin="0,0,0,4"
                                                    AutomationProperties.Name="New issue labels" />
                                        <ItemsControl ItemsSource="{Binding AvailableLabelNames}" Margin="0,0,0,10">
                                            <ItemsControl.Style>
                                                <Style TargetType="ItemsControl">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AvailableLabelNames.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ItemsControl.Style>
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource StatusInfoBg}" CornerRadius="4"
                                                            Padding="6,1" Margin="0,0,4,4">
                                                        <TextBlock Text="{Binding}" FontSize="10"
                                                                   Foreground="{DynamicResource StatusInfoFg}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:Button Content="Create Issue" Appearance="Primary" FontSize="12" Padding="14,4"
                                                       Margin="0,0,8,0" Command="{Binding SubmitNewIssueCommand}"
                                                       AutomationProperties.Name="Create issue" />
                                            <ui:Button Content="Cancel" FontSize="12" Padding="14,4"
                                                       Command="{Binding CancelNewIssueCommand}"
                                                       AutomationProperties.Name="Cancel new issue" />
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- Issue detail -->
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedIssue}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IssueComposeVisible}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Header -->
                                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                        <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20" HorizontalAlignment="Left"
                                                         Visibility="{Binding IssueDetailLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <TextBlock Text="{Binding IssueDetailError}" FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource StatusBadFg}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IssueDetailError}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <DockPanel LastChildFill="True">
                                            <Border DockPanel.Dock="Right" CornerRadius="4" Padding="8,2" Margin="8,0,0,0"
                                                    VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource StatusGoodBg}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IssueDetail.State}" Value="closed">
                                                                <Setter Property="Background" Value="{DynamicResource StatusBadBg}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding IssueDetail.State}" FontSize="11">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource StatusGoodFg}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IssueDetail.State}" Value="closed">
                                                                    <Setter Property="Foreground" Value="{DynamicResource StatusBadFg}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            <TextBlock FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                       Text="{Binding IssueDetail.Title}" />
                                        </DockPanel>
                                        <TextBlock FontSize="11" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                            <Run Text="#" /><Run Text="{Binding IssueDetail.Number, Mode=OneWay}" />
                                            <Run Text=" · labels: " /><Run Text="{Binding IssueDetail.Labels, Mode=OneWay}" />
                                            <Run Text=" · assignees: " /><Run Text="{Binding IssueDetail.Assignees, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Conversation (body + comments, native markdown) -->
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                                  PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                                        <RichTextBox x:Name="IssueConversationRich" IsReadOnly="True"
                                                     IsDocumentEnabled="True"
                                                     IsReadOnlyCaretVisible="True"
                                                     PreviewKeyDown="RenderedText_PreviewKeyDown"
                                                     BorderThickness="0" Background="Transparent"
                                                     FontFamily="Segoe UI" FontSize="13"
                                                     AutomationProperties.Name="Issue conversation" />
                                    </ScrollViewer>

                                    <!-- Action bar -->
                                    <StackPanel Grid.Row="2" Margin="0,8,0,0">
                                        <ui:TextBox Text="{Binding IssueCommentDraft, UpdateSourceTrigger=PropertyChanged}"
                                                    PlaceholderText="Add a comment (Markdown)"
                                                    AcceptsReturn="True" MinHeight="48" MaxHeight="120"
                                                    VerticalScrollBarVisibility="Auto" Margin="0,0,0,6"
                                                    AutomationProperties.Name="Issue comment" />
                                        <WrapPanel>
                                            <ui:Button Content="Comment" FontSize="12" Padding="12,4" Margin="0,0,6,6"
                                                       Appearance="Primary" Command="{Binding CommentIssueCommand}"
                                                       AutomationProperties.Name="Post comment" />
                                            <ui:Button Content="Close issue" FontSize="12" Padding="12,4" Margin="0,0,6,6"
                                                       Command="{Binding CloseIssueCommand}"
                                                       AutomationProperties.Name="Close issue">
                                                <ui:Button.Style>
                                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IssueDetail.State}" Value="closed">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:Button.Style>
                                            </ui:Button>
                                            <ui:Button Content="Reopen issue" FontSize="12" Padding="12,4" Margin="0,0,6,6"
                                                       Command="{Binding ReopenIssueCommand}"
                                                       AutomationProperties.Name="Reopen issue">
                                                <ui:Button.Style>
                                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IssueDetail.State}" Value="closed">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:Button.Style>
                                            </ui:Button>
                                            <ui:Button Content="Open on GitHub" FontSize="12" Padding="12,4" Margin="0,0,6,6"
                                                       Icon="{ui:SymbolIcon Open24}"
                                                       Command="{Binding OpenIssueCommand}"
                                                       CommandParameter="{Binding SelectedIssue}"
                                                       AutomationProperties.Name="Open issue on GitHub" />
                                        </WrapPanel>
                                        <WrapPanel Margin="0,2,0,0">
                                            <ui:TextBox Text="{Binding IssueAssignee, UpdateSourceTrigger=PropertyChanged}"
                                                        PlaceholderText="assignee (login or @me)" Width="180" Margin="0,0,6,6"
                                                        AutomationProperties.Name="Assignee login" />
                                            <ui:Button Content="Assign" FontSize="12" Padding="12,4" Margin="0,0,12,6"
                                                       Command="{Binding AssignIssueCommand}"
                                                       AutomationProperties.Name="Assign issue" />
                                            <ComboBox ItemsSource="{Binding AvailableLabelNames}"
                                                      SelectedItem="{Binding SelectedLabelToAdd}"
                                                      Width="150" Margin="0,0,6,6" FontSize="12"
                                                      AutomationProperties.Name="Label to add" />
                                            <ui:Button Content="Add label" FontSize="12" Padding="12,4" Margin="0,0,12,6"
                                                       Command="{Binding AddIssueLabelCommand}"
                                                       AutomationProperties.Name="Add label" />
                                            <ComboBox ItemsSource="{Binding IssueLabels}"
                                                      SelectedItem="{Binding SelectedLabelToRemove}"
                                                      Width="150" Margin="0,0,6,6" FontSize="12"
                                                      AutomationProperties.Name="Label to remove" />
                                            <ui:Button Content="Remove label" FontSize="12" Padding="12,4" Margin="0,0,0,6"
                                                       Command="{Binding RemoveIssueLabelCommand}"
                                                       AutomationProperties.Name="Remove label" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ── PULL REQUESTS ── -->
            <TabItem Header="Pull Requests" Tag="{x:Static models:DetailTab.PullRequests}">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <ui:Button DockPanel.Dock="Right" Content="Refresh" FontSize="12" Padding="10,4" Margin="8,0,0,0"
                                   Icon="{ui:SymbolIcon ArrowSync24}"
                                   Command="{Binding LoadPullRequestsCommand}"
                                   AutomationProperties.Name="Refresh pull requests" />
                        <ui:Button DockPanel.Dock="Right" Content="New PR" FontSize="12" Padding="10,4"
                                   Appearance="Primary" Icon="{ui:SymbolIcon Add24}"
                                   Command="{Binding ShowNewPrCommand}"
                                   AutomationProperties.Name="New pull request from current branch" />
                        <TextBlock FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding GitHubStatusText}"
                                   AutomationProperties.LiveSetting="Polite" />
                    </DockPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="380" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- PR list -->
                        <Border Grid.Column="0" Background="{DynamicResource ControlFillColorDefaultBrush}"
                                CornerRadius="8" Padding="10,8" Margin="0,0,12,0">
                            <Grid>
                                <TextBlock Text="{Binding PullRequestsError}" FontSize="12" TextWrapping="Wrap"
                                           VerticalAlignment="Top" Foreground="{DynamicResource StatusBadFg}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PullRequestsError}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="No open pull requests." FontSize="12"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding PullRequests.Count}" Value="0" />
                                                        <Condition Binding="{Binding PullRequestsError}" Value="" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ListBox ItemsSource="{Binding PullRequests}"
                                         SelectedItem="{Binding SelectedPullRequest}"
                                         Background="Transparent" BorderThickness="0"
                                         AutomationProperties.Name="Open pull requests">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="4,4" />
                                            <Setter Property="AutomationProperties.Name">
                                                <Setter.Value>
                                                    <MultiBinding StringFormat="{}Pull request {0}, {1}: {2}">
                                                        <Binding Path="Number" />
                                                        <Binding Path="StateLabel" />
                                                        <Binding Path="Title" />
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                            <EventSetter Event="MouseDoubleClick" Handler="PrRow_Open" />
                                            <EventSetter Event="KeyDown" Handler="PrRow_KeyDown" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:GitHubPullRequest}">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Width="52" FontSize="12"
                                                           FontFamily="Cascadia Code,Consolas"
                                                           Foreground="{DynamicResource StatusInfoFg}">
                                                    <Run Text="#" /><Run Text="{Binding Number, Mode=OneWay}" />
                                                </TextBlock>
                                                <!-- checks chip -->
                                                <Border DockPanel.Dock="Right" CornerRadius="4" Padding="6,1" Margin="8,0,0,0"
                                                        VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource StatusNeutralBg}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ChecksState}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ChecksState}" Value="passing">
                                                                    <Setter Property="Background" Value="{DynamicResource StatusGoodBg}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ChecksState}" Value="failing">
                                                                    <Setter Property="Background" Value="{DynamicResource StatusBadBg}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ChecksState}" Value="pending">
                                                                    <Setter Property="Background" Value="{DynamicResource StatusWarnBg}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding ChecksState}" FontSize="10">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource StatusNeutralFg}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ChecksState}" Value="passing">
                                                                        <Setter Property="Foreground" Value="{DynamicResource StatusGoodFg}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding ChecksState}" Value="failing">
                                                                        <Setter Property="Foreground" Value="{DynamicResource StatusBadFg}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding ChecksState}" Value="pending">
                                                                        <Setter Property="Foreground" Value="{DynamicResource StatusWarnFg}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                                <!-- draft chip -->
                                                <Border DockPanel.Dock="Right" Background="{DynamicResource StatusNeutralBg}"
                                                        CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                        Visibility="{Binding IsDraft, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="draft" FontSize="10"
                                                               Foreground="{DynamicResource StatusNeutralFg}" />
                                                </Border>
                                                <TextBlock Text="{Binding Title}" FontSize="13"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <!-- Right pane: compose form OR PR detail OR hint -->
                        <Border Grid.Column="1" Background="{DynamicResource ControlFillColorDefaultBrush}"
                                CornerRadius="8" Padding="16,12">
                            <Grid>
                                <!-- Hint -->
                                <TextBlock Text="Select a pull request to view it, or click New PR to open one from the current branch."
                                           FontSize="13" VerticalAlignment="Top" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding SelectedPullRequest}" Value="{x:Null}" />
                                                        <Condition Binding="{Binding PullRequestComposeVisible}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Compose new PR -->
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              Visibility="{Binding PullRequestComposeVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="New Pull Request" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,4"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                            <Run Text="Head branch: " /><Run Text="{Binding BranchLabel, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="Title" FontSize="12" Margin="0,0,0,2"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <ui:TextBox Text="{Binding NewPrTitle, UpdateSourceTrigger=PropertyChanged}"
                                                    PlaceholderText="Short summary" Margin="0,0,0,8"
                                                    AutomationProperties.Name="New pull request title" />
                                        <TextBlock Text="Body (Markdown)" FontSize="12" Margin="0,0,0,2"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <ui:TextBox Text="{Binding NewPrBody, UpdateSourceTrigger=PropertyChanged}"
                                                    AcceptsReturn="True" MinHeight="120" MaxHeight="240"
                                                    VerticalScrollBarVisibility="Auto" Margin="0,0,0,8"
                                                    AutomationProperties.Name="New pull request body" />
                                        <TextBlock Text="Base branch (blank = repo default)" FontSize="12" Margin="0,0,0,2"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <ui:TextBox Text="{Binding NewPrBase, UpdateSourceTrigger=PropertyChanged}"
                                                    PlaceholderText="main" Margin="0,0,0,8" Width="220" HorizontalAlignment="Left"
                                                    AutomationProperties.Name="New pull request base branch" />
                                        <CheckBox Content="Create as draft" FontSize="12" Margin="0,0,0,10"
                                                  IsChecked="{Binding NewPrDraft}"
                                                  AutomationProperties.Name="Create pull request as draft" />
                                        <StackPanel Orientation="Horizontal">
                                            <ui:Button Content="Create PR" Appearance="Primary" FontSize="12" Padding="14,4"
                                                       Margin="0,0,8,0" Command="{Binding SubmitNewPrCommand}"
                                                       AutomationProperties.Name="Create pull request" />
                                            <ui:Button Content="Cancel" FontSize="12" Padding="14,4"
                                                       Command="{Binding CancelNewPrCommand}"
                                                       AutomationProperties.Name="Cancel new pull request" />
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- PR detail -->
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedPullRequest}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding PullRequestComposeVisible}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Header -->
                                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                        <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20" HorizontalAlignment="Left"
                                                         Visibility="{Binding PullRequestDetailLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <TextBlock Text="{Binding PullRequestDetailError}" FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource StatusBadFg}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PullRequestDetailError}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   Text="{Binding PullRequestDetail.Title}" />
                                        <TextBlock FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                            <Run Text="#" /><Run Text="{Binding PullRequestDetail.Number, Mode=OneWay}" />
                                            <Run Text="  " /><Run Text="{Binding PullRequestDetail.HeadRef, Mode=OneWay}" />
                                            <Run Text=" → " /><Run Text="{Binding PullRequestDetail.BaseRef, Mode=OneWay}" />
                                            <Run Text="  ·  " /><Run Text="{Binding PullRequestDetail.ChangedFiles, Mode=OneWay}" />
                                            <Run Text=" files  +" /><Run Text="{Binding PullRequestDetail.Additions, Mode=OneWay}" />
                                            <Run Text=" -" /><Run Text="{Binding PullRequestDetail.Deletions, Mode=OneWay}" />
                                            <Run Text="  ·  checks: " /><Run Text="{Binding PullRequestDetail.ChecksState, Mode=OneWay}" />
                                            <Run Text="  ·  " /><Run Text="{Binding PullRequestDetail.Mergeable, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Description + comments (native markdown) -->
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                                  PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                                        <RichTextBox x:Name="PullRequestConversationRich" IsReadOnly="True"
                                                     IsDocumentEnabled="True"
                                                     IsReadOnlyCaretVisible="True"
                                                     PreviewKeyDown="RenderedText_PreviewKeyDown"
                                                     BorderThickness="0" Background="Transparent"
                                                     FontFamily="Segoe UI" FontSize="13"
                                                     AutomationProperties.Name="Pull request conversation" />
                                    </ScrollViewer>

                                    <!-- Action bar -->
                                    <StackPanel Grid.Row="2" Margin="0,8,0,0">
                                        <ui:TextBox Text="{Binding PrCommentDraft, UpdateSourceTrigger=PropertyChanged}"
                                                    PlaceholderText="Add a comment (Markdown)"
                                                    AcceptsReturn="True" MinHeight="44" MaxHeight="100"
                                                    VerticalScrollBarVisibility="Auto" Margin="0,0,0,6"
                                                    AutomationProperties.Name="Pull request comment" />
                                        <WrapPanel Margin="0,0,0,4">
                                            <ui:Button Content="Comment" FontSize="12" Padding="12,4" Margin="0,0,6,6"
                                                       Command="{Binding CommentPrCommand}"
                                                       AutomationProperties.Name="Post comment" />
                                            <ui:Button Content="Checkout locally" FontSize="12" Padding="12,4" Margin="0,0,6,6"
                                                       Icon="{ui:SymbolIcon ArrowDownload24}"
                                                       Command="{Binding CheckoutPrCommand}"
                                                       AutomationProperties.Name="Checkout pull request locally" />
                                            <ui:Button Content="Close" FontSize="12" Padding="12,4" Margin="0,0,6,6"
                                                       Command="{Binding ClosePrCommand}"
                                                       AutomationProperties.Name="Close pull request" />
                                            <ui:Button Content="Mark ready" FontSize="12" Padding="12,4" Margin="0,0,6,6"
                                                       Command="{Binding MarkPrReadyCommand}"
                                                       AutomationProperties.Name="Mark pull request ready for review">
                                                <ui:Button.Style>
                                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PullRequestDetail.IsDraft}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:Button.Style>
                                            </ui:Button>
                                            <ui:Button Content="Open on GitHub" FontSize="12" Padding="12,4" Margin="0,0,6,6"
                                                       Icon="{ui:SymbolIcon Open24}"
                                                       Command="{Binding OpenPullRequestCommand}"
                                                       CommandParameter="{Binding SelectedPullRequest}"
                                                       AutomationProperties.Name="Open pull request on GitHub" />
                                        </WrapPanel>

                                        <!-- Merge row -->
                                        <WrapPanel Margin="0,0,0,4">
                                            <TextBlock Text="Merge:" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,6"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <ComboBox ItemsSource="{x:Static local:ProjectDetailViewModel.MergeStrategies}"
                                                      SelectedItem="{Binding SelectedMergeStrategy}"
                                                      Width="110" FontSize="12" Margin="0,0,6,6"
                                                      AutomationProperties.Name="Merge strategy" />
                                            <CheckBox Content="Delete branch" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,6"
                                                      IsChecked="{Binding MergeDeleteBranch}"
                                                      AutomationProperties.Name="Delete branch after merge" />
                                            <ui:Button Content="Merge" Appearance="Primary" FontSize="12" Padding="12,4" Margin="0,0,6,6"
                                                       Command="{Binding MergePrCommand}"
                                                       AutomationProperties.Name="Merge pull request" />
                                        </WrapPanel>

                                        <!-- Review row -->
                                        <ui:TextBox Text="{Binding ReviewBody, UpdateSourceTrigger=PropertyChanged}"
                                                    PlaceholderText="Review comment (required for request changes)"
                                                    AcceptsReturn="True" MinHeight="40" MaxHeight="90"
                                                    VerticalScrollBarVisibility="Auto" Margin="0,0,0,6"
                                                    AutomationProperties.Name="Review comment" />
                                        <WrapPanel>
                                            <TextBlock Text="Review:" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,6"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <ui:Button Content="Approve" FontSize="12" Padding="12,4" Margin="0,0,6,6"
                                                       Command="{Binding ReviewPrCommand}"
                                                       CommandParameter="{x:Static models:ReviewAction.Approve}"
                                                       AutomationProperties.Name="Approve pull request" />
                                            <ui:Button Content="Request changes" FontSize="12" Padding="12,4" Margin="0,0,6,6"
                                                       Command="{Binding ReviewPrCommand}"
                                                       CommandParameter="{x:Static models:ReviewAction.RequestChanges}"
                                                       AutomationProperties.Name="Request changes on pull request" />
                                            <ui:Button Content="Comment review" FontSize="12" Padding="12,4" Margin="0,0,6,6"
                                                       Command="{Binding ReviewPrCommand}"
                                                       CommandParameter="{x:Static models:ReviewAction.Comment}"
                                                       AutomationProperties.Name="Submit review comment" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ── STASHES ── -->
            <TabItem Header="Stashes" Tag="{x:Static models:DetailTab.Stashes}">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <ui:Button DockPanel.Dock="Right" Content="Refresh" FontSize="12" Padding="10,4"
                                   Icon="{ui:SymbolIcon ArrowSync24}"
                                   Command="{Binding LoadStashesCommand}"
                                   AutomationProperties.Name="Refresh the stash list" />
                        <TextBlock FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="Apply keeps the stash; Pop applies and removes it; Drop deletes it (confirmed). Selecting a stash shows what it holds." />
                    </DockPanel>

                    <Border Grid.Row="1" Background="{DynamicResource ControlFillColorDefaultBrush}"
                            CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
                        <DockPanel>
                            <ui:Button DockPanel.Dock="Right" Content="Stash changes" Appearance="Primary"
                                       FontSize="12" Padding="12,4" Margin="10,0,0,0" VerticalAlignment="Bottom"
                                       Command="{Binding StashChangesCommand}"
                                       ToolTip="Save the working tree onto the stash stack and leave it clean"
                                       AutomationProperties.Name="Stash the working tree changes" />
                            <CheckBox DockPanel.Dock="Right" Content="Include untracked files" FontSize="12"
                                      Margin="12,0,0,0" VerticalAlignment="Bottom"
                                      IsChecked="{Binding StashIncludeUntracked}"
                                      ToolTip="Take files git is not tracking yet into the stash as well"
                                      AutomationProperties.Name="Include untracked files in the stash" />
                            <StackPanel>
                                <TextBlock Text="Message" FontSize="12" Margin="0,0,0,2"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <TextBox Text="{Binding NewStashMessage, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="12"
                                         AutomationProperties.Name="Stash message"
                                         ToolTip="What this snapshot is; left empty, git names it after the current commit" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" MinWidth="360" />
                            <ColumnDefinition Width="4*" MinWidth="280" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource ControlFillColorDefaultBrush}"
                                CornerRadius="8" Padding="10,8" Margin="0,0,12,0">
                            <Grid>
                                <TextBlock Text="No stashes." FontSize="12"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Stashes.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ListBox ItemsSource="{Binding Stashes}"
                                         SelectedItem="{Binding SelectedStash}"
                                         Background="Transparent" BorderThickness="0"
                                         AutomationProperties.Name="Stashes">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="AutomationProperties.Name">
                                                <Setter.Value>
                                                    <MultiBinding StringFormat="{}{0}: {1}">
                                                        <Binding Path="Ref" />
                                                        <Binding Path="Subject" />
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:StashEntry}">
                                            <DockPanel Margin="0,2">
                                                <TextBlock DockPanel.Dock="Left" Width="92" Text="{Binding Ref}"
                                                           FontFamily="Cascadia Code,Consolas" FontSize="12"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource StatusInfoFg}" />
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding Date, Converter={StaticResource RelativeTimeConverter}}"
                                                               FontSize="11" Margin="0,0,12,0" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                    <ui:Button Content="Apply" FontSize="11" Padding="8,2" Margin="0,0,6,0"
                                                               Command="{Binding DataContext.StashApplyCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                               CommandParameter="{Binding}" />
                                                    <ui:Button Content="Pop" FontSize="11" Padding="8,2" Margin="0,0,6,0"
                                                               Command="{Binding DataContext.StashPopCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                               CommandParameter="{Binding}" />
                                                    <ui:Button Content="Drop" FontSize="11" Padding="8,2"
                                                               Command="{Binding DataContext.StashDropCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                               CommandParameter="{Binding}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Subject}" FontSize="12" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Subject}"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Background="{DynamicResource ControlFillColorDefaultBrush}"
                                CornerRadius="8" Padding="10,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="What this stash holds" Style="{StaticResource PaneHeader}" />
                                <TextBlock Grid.Row="1" Text="{Binding StashDiffError}" FontSize="12" TextWrapping="Wrap"
                                           Margin="0,0,0,6"
                                           AutomationProperties.LiveSetting="Polite"
                                           Foreground="{DynamicResource StatusWarnFg}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StashDiffError}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Row="2" Margin="0,0,0,6" FontSize="12" TextWrapping="Wrap"
                                           AutomationProperties.AutomationId="StashDiffTruncatedNotice"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Text="This stash was too large to read in full — the rows below stop where the read did."
                                           Visibility="{Binding StashDiffIsTruncated, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <ComboBox Grid.Row="3" ItemsSource="{Binding StashDiffFiles}"
                                          SelectedItem="{Binding SelectedStashDiffFile}"
                                          DisplayMemberPath="Path" FontSize="12" Margin="0,0,0,6"
                                          AutomationProperties.Name="File changed in the selected stash">
                                    <ComboBox.Style>
                                        <Style TargetType="ComboBox">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StashDiffFiles.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ComboBox.Style>
                                </ComboBox>
                                <ListBox Grid.Row="4" ItemsSource="{Binding StashDiffLines}"
                                         Style="{StaticResource DiffListStyle}"
                                         Visibility="{Binding DiffUnified, Converter={StaticResource BooleanToVisibilityConverter}}"
                                         AutomationProperties.Name="Stash diff" />
                                <ListBox Grid.Row="4" ItemsSource="{Binding StashDiffRows}"
                                         Style="{StaticResource SideBySideListStyle}"
                                         Visibility="{Binding DiffSideBySide, Converter={StaticResource BooleanToVisibilityConverter}}"
                                         AutomationProperties.Name="Stash diff, side by side" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ── ACTIONS ── -->
            <TabItem Header="Actions" Tag="{x:Static models:DetailTab.Actions}">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <ui:Button DockPanel.Dock="Right" Content="Refresh" FontSize="12" Padding="10,4"
                                   Icon="{ui:SymbolIcon ArrowSync24}"
                                   Command="{Binding LoadWorkflowRunsCommand}"
                                   AutomationProperties.Name="Refresh workflow runs" />
                        <TextBlock FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding GitHubStatusText}"
                                   AutomationProperties.LiveSetting="Polite" />
                    </DockPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="420" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Run list -->
                        <Border Grid.Column="0" Background="{DynamicResource ControlFillColorDefaultBrush}"
                                CornerRadius="8" Padding="10,8" Margin="0,0,12,0">
                            <Grid>
                                <TextBlock Text="{Binding WorkflowRunsError}" FontSize="12" TextWrapping="Wrap"
                                           VerticalAlignment="Top"
                                           Foreground="{DynamicResource StatusBadFg}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WorkflowRunsError}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="No workflow runs." FontSize="12"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding WorkflowRuns.Count}" Value="0" />
                                                        <Condition Binding="{Binding WorkflowRunsError}" Value="" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ListBox ItemsSource="{Binding WorkflowRuns}"
                                         SelectedItem="{Binding SelectedWorkflowRun}"
                                         Background="Transparent" BorderThickness="0"
                                         AutomationProperties.Name="Workflow runs">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="4,4" />
                                            <Setter Property="AutomationProperties.Name">
                                                <Setter.Value>
                                                    <MultiBinding StringFormat="{}{0}, {1}{2}">
                                                        <Binding Path="DisplayTitle" />
                                                        <Binding Path="OutcomeLabel" />
                                                        <Binding Path="BranchSuffix" />
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                            <EventSetter Event="MouseDoubleClick" Handler="RunRow_Open" />
                                            <EventSetter Event="KeyDown" Handler="RunRow_KeyDown" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:WorkflowRun}">
                                            <StackPanel>
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Left" CornerRadius="4" Padding="6,1" Margin="0,0,8,0"
                                                            MinWidth="72" VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource StatusNeutralBg}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding OutcomeLabel}" Value="success">
                                                                        <Setter Property="Background" Value="{DynamicResource StatusGoodBg}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding OutcomeLabel}" Value="failure">
                                                                        <Setter Property="Background" Value="{DynamicResource StatusBadBg}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding OutcomeLabel}" Value="in progress">
                                                                        <Setter Property="Background" Value="{DynamicResource StatusWarnBg}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding OutcomeLabel}" Value="queued">
                                                                        <Setter Property="Background" Value="{DynamicResource StatusInfoBg}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding OutcomeLabel}" FontSize="10"
                                                                   HorizontalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource StatusNeutralFg}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding OutcomeLabel}" Value="success">
                                                                            <Setter Property="Foreground" Value="{DynamicResource StatusGoodFg}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding OutcomeLabel}" Value="failure">
                                                                            <Setter Property="Foreground" Value="{DynamicResource StatusBadFg}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding OutcomeLabel}" Value="in progress">
                                                                            <Setter Property="Foreground" Value="{DynamicResource StatusWarnFg}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding OutcomeLabel}" Value="queued">
                                                                            <Setter Property="Foreground" Value="{DynamicResource StatusInfoFg}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                    <TextBlock DockPanel.Dock="Right" FontSize="11" Margin="8,0,0,0"
                                                               VerticalAlignment="Center"
                                                               Text="{Binding ElapsedLabel}"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                    <TextBlock Text="{Binding Name}" FontSize="13"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayTitle}"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                </DockPanel>
                                                <TextBlock FontSize="11" Margin="80,1,0,0"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                                    <Run Text="{Binding Branch, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Event, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <!-- Right pane: jobs and steps for the selected run -->
                        <Border Grid.Column="1" Background="{DynamicResource ControlFillColorDefaultBrush}"
                                CornerRadius="8" Padding="16,12">
                            <Grid>
                                <TextBlock Text="Select a run to see its jobs and steps."
                                           FontSize="13" VerticalAlignment="Top" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedWorkflowRun}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedWorkflowRun}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                        <TextBlock FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   Text="{Binding SelectedWorkflowRun.DisplayTitle}" />
                                        <TextBlock FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                            <Run Text="{Binding SelectedWorkflowRun.Name, Mode=OneWay}" />
                                            <Run Text=" · " /><Run Text="{Binding SelectedWorkflowRun.Branch, Mode=OneWay}" />
                                            <Run Text=" · " /><Run Text="{Binding SelectedWorkflowRun.Event, Mode=OneWay}" />
                                            <Run Text=" · " /><Run Text="{Binding SelectedWorkflowRun.OutcomeLabel, Mode=OneWay}" />
                                            <Run Text=" · " /><Run Text="{Binding SelectedWorkflowRun.ElapsedLabel, Mode=OneWay}" />
                                        </TextBlock>
                                        <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20" HorizontalAlignment="Left"
                                                         Margin="0,4,0,0"
                                                         Visibility="{Binding WorkflowJobsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <TextBlock Text="{Binding WorkflowJobsError}" FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource StatusBadFg}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding WorkflowJobsError}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>

                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                                  PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                                        <Grid>
                                            <TextBlock Text="This run reported no jobs." FontSize="12"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding WorkflowJobs.Count}" Value="0" />
                                                                    <Condition Binding="{Binding WorkflowJobsError}" Value="" />
                                                                    <Condition Binding="{Binding WorkflowJobsLoading}" Value="False" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <ItemsControl ItemsSource="{Binding WorkflowJobs}"
                                                          AutomationProperties.Name="Jobs in this run">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type models:WorkflowJob}">
                                                        <StackPanel Margin="0,0,0,10">
                                                            <DockPanel>
                                                                <TextBlock DockPanel.Dock="Right" FontSize="11" Margin="8,0,0,0"
                                                                           VerticalAlignment="Center"
                                                                           Text="{Binding ElapsedLabel}"
                                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                                <TextBlock FontSize="13" FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                                                    <Run Text="{Binding Name, Mode=OneWay}" /><Run Text=" — " /><Run Text="{Binding OutcomeLabel, Mode=OneWay}" />
                                                                </TextBlock>
                                                            </DockPanel>
                                                            <ItemsControl ItemsSource="{Binding Steps}" Margin="12,2,0,0">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate DataType="{x:Type models:WorkflowStep}">
                                                                        <DockPanel Margin="0,1">
                                                                            <TextBlock DockPanel.Dock="Left" Width="28" FontSize="11"
                                                                                       FontFamily="Cascadia Code,Consolas"
                                                                                       Text="{Binding Number}"
                                                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                                            <TextBlock DockPanel.Dock="Right" MinWidth="70" FontSize="11"
                                                                                       Text="{Binding OutcomeLabel}">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding OutcomeLabel}" Value="success">
                                                                                                <Setter Property="Foreground" Value="{DynamicResource StatusGoodFg}" />
                                                                                            </DataTrigger>
                                                                                            <DataTrigger Binding="{Binding OutcomeLabel}" Value="failure">
                                                                                                <Setter Property="Foreground" Value="{DynamicResource StatusBadFg}" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                            <TextBlock Text="{Binding Name}" FontSize="12"
                                                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"
                                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                        </DockPanel>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </ScrollViewer>

                                    <WrapPanel Grid.Row="2" Margin="0,8,0,0">
                                        <CheckBox Content="Failed jobs only" FontSize="12" VerticalAlignment="Center"
                                                  Margin="0,0,10,6" IsChecked="{Binding RerunFailedJobsOnly}"
                                                  AutomationProperties.Name="Re-run failed jobs only" />
                                        <ui:Button Content="Re-run" Appearance="Primary" FontSize="12" Padding="12,4" Margin="0,0,6,6"
                                                   Icon="{ui:SymbolIcon ArrowSync24}"
                                                   Command="{Binding RerunWorkflowRunCommand}"
                                                   AutomationProperties.Name="Re-run this workflow run" />
                                        <ui:Button Content="Cancel run" FontSize="12" Padding="12,4" Margin="0,0,6,6"
                                                   Command="{Binding CancelWorkflowRunCommand}"
                                                   AutomationProperties.Name="Cancel this workflow run" />
                                        <ui:Button Content="Open on GitHub" FontSize="12" Padding="12,4" Margin="0,0,6,6"
                                                   Icon="{ui:SymbolIcon Open24}"
                                                   Command="{Binding OpenWorkflowRunCommand}"
                                                   CommandParameter="{Binding SelectedWorkflowRun}"
                                                   AutomationProperties.Name="Open this run on GitHub" />
                                    </WrapPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ── RELEASES ── -->
            <TabItem Header="Releases" Tag="{x:Static models:DetailTab.Releases}">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <ui:Button DockPanel.Dock="Right" Content="Refresh" FontSize="12" Padding="10,4" Margin="8,0,0,0"
                                   Icon="{ui:SymbolIcon ArrowSync24}"
                                   Command="{Binding LoadReleasesCommand}"
                                   AutomationProperties.Name="Refresh releases" />
                        <ui:Button DockPanel.Dock="Right" Content="New Release" FontSize="12" Padding="10,4"
                                   Appearance="Primary" Icon="{ui:SymbolIcon Add24}"
                                   Command="{Binding ShowNewReleaseCommand}"
                                   AutomationProperties.Name="New release from an existing tag" />
                        <TextBlock FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding GitHubStatusText}"
                                   AutomationProperties.LiveSetting="Polite" />
                    </DockPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="380" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Release list -->
                        <Border Grid.Column="0" Background="{DynamicResource ControlFillColorDefaultBrush}"
                                CornerRadius="8" Padding="10,8" Margin="0,0,12,0">
                            <Grid>
                                <TextBlock Text="{Binding ReleasesError}" FontSize="12" TextWrapping="Wrap"
                                           VerticalAlignment="Top" Foreground="{DynamicResource StatusBadFg}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ReleasesError}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="No releases yet." FontSize="12"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Releases.Count}" Value="0" />
                                                        <Condition Binding="{Binding ReleasesError}" Value="" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ListBox ItemsSource="{Binding Releases}"
                                         SelectedItem="{Binding SelectedRelease}"
                                         Background="Transparent" BorderThickness="0"
                                         AutomationProperties.Name="Releases">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="4,4" />
                                            <Setter Property="AutomationProperties.Name">
                                                <Setter.Value>
                                                    <MultiBinding StringFormat="{}{0}{1}">
                                                        <Binding Path="DisplayTitle" />
                                                        <Binding Path="StateSuffix" />
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                            <EventSetter Event="MouseDoubleClick" Handler="ReleaseRow_Open" />
                                            <EventSetter Event="KeyDown" Handler="ReleaseRow_KeyDown" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:Release}">
                                            <StackPanel>
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Right" CornerRadius="4" Padding="6,1" Margin="8,0,0,0"
                                                            VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource StatusNeutralBg}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding StateLabel}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding StateLabel}" Value="prerelease">
                                                                        <Setter Property="Background" Value="{DynamicResource StatusWarnBg}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding StateLabel}" FontSize="10">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource StatusNeutralFg}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding StateLabel}" Value="prerelease">
                                                                            <Setter Property="Foreground" Value="{DynamicResource StatusWarnFg}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                    <TextBlock Text="{Binding DisplayTitle}" FontSize="13"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayTitle}"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                </DockPanel>
                                                <TextBlock FontSize="11" Margin="0,1,0,0"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                                    <Run Text="{Binding PublishedAt, Mode=OneWay, Converter={StaticResource RelativeTimeConverter}}" />
                                                    <Run Text=" · " /><Run Text="{Binding Assets.Count, Mode=OneWay}" /><Run Text=" asset(s)" />
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <!-- Right pane: compose form OR release detail OR hint -->
                        <Border Grid.Column="1" Background="{DynamicResource ControlFillColorDefaultBrush}"
                                CornerRadius="8" Padding="16,12">
                            <Grid>
                                <TextBlock Text="Select a release to read its notes, or click New Release to cut one from an existing tag."
                                           FontSize="13" VerticalAlignment="Top" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding SelectedRelease}" Value="{x:Null}" />
                                                        <Condition Binding="{Binding ReleaseComposeVisible}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Compose new release -->
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              Visibility="{Binding ReleaseComposeVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="New Release" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="Tag (an existing tag in this repository)" FontSize="12" Margin="0,0,0,2"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <ComboBox ItemsSource="{Binding AvailableTagNames}"
                                                  SelectedItem="{Binding NewReleaseTag}"
                                                  Width="260" HorizontalAlignment="Left" FontSize="12" Margin="0,0,0,4"
                                                  AutomationProperties.Name="Release tag" />
                                        <TextBlock Text="A tag not yet pushed is created on the remote by publishing, on the commit it points at here."
                                                   FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AvailableTagNames.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="This repository has no tags — create one on the Branches tab first."
                                                   FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource StatusWarnFg}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AvailableTagNames.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="Title" FontSize="12" Margin="0,0,0,2"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <ui:TextBox Text="{Binding NewReleaseTitle, UpdateSourceTrigger=PropertyChanged}"
                                                    PlaceholderText="Release name" Margin="0,0,0,8"
                                                    AutomationProperties.Name="New release title" />
                                        <TextBlock Text="Notes (Markdown)" FontSize="12" Margin="0,0,0,2"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <ui:TextBox Text="{Binding NewReleaseBody, UpdateSourceTrigger=PropertyChanged}"
                                                    AcceptsReturn="True" MinHeight="140" MaxHeight="260"
                                                    VerticalScrollBarVisibility="Auto" Margin="0,0,0,8"
                                                    AutomationProperties.Name="New release notes" />
                                        <CheckBox Content="Create as draft" FontSize="12" Margin="0,0,0,4"
                                                  IsChecked="{Binding NewReleaseDraft}"
                                                  AutomationProperties.Name="Create release as draft" />
                                        <CheckBox Content="Mark as prerelease" FontSize="12" Margin="0,0,0,10"
                                                  IsChecked="{Binding NewReleasePrerelease}"
                                                  AutomationProperties.Name="Mark release as prerelease" />
                                        <StackPanel Orientation="Horizontal">
                                            <ui:Button Content="Create Release" Appearance="Primary" FontSize="12" Padding="14,4"
                                                       Margin="0,0,8,0" Command="{Binding SubmitNewReleaseCommand}"
                                                       AutomationProperties.Name="Create release" />
                                            <ui:Button Content="Cancel" FontSize="12" Padding="14,4"
                                                       Command="{Binding CancelNewReleaseCommand}"
                                                       AutomationProperties.Name="Cancel new release" />
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- Release detail -->
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedRelease}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ReleaseComposeVisible}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                        <TextBlock FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   Text="{Binding SelectedRelease.DisplayTitle}" />
                                        <TextBlock FontSize="11" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                            <Run Text="{Binding SelectedRelease.TagName, Mode=OneWay}" />
                                            <Run Text=" · " /><Run Text="{Binding SelectedRelease.PublishedAt, Mode=OneWay, Converter={StaticResource RelativeTimeConverter}}" />
                                            <Run Text=" · " /><Run Text="{Binding SelectedRelease.StateLabel, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>

                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                                  PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                                        <RichTextBox x:Name="ReleaseNotesRich" IsReadOnly="True"
                                                     IsDocumentEnabled="True"
                                                     IsReadOnlyCaretVisible="True"
                                                     PreviewKeyDown="RenderedText_PreviewKeyDown"
                                                     BorderThickness="0" Background="Transparent"
                                                     FontFamily="Segoe UI" FontSize="13"
                                                     AutomationProperties.Name="Release notes" />
                                    </ScrollViewer>

                                    <!-- Assets -->
                                    <StackPanel Grid.Row="2" Margin="0,8,0,0">
                                        <TextBlock Text="Assets" Style="{StaticResource PaneHeader}" />
                                        <TextBlock Text="No assets attached to this release." FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedRelease.Assets.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ItemsControl ItemsSource="{Binding SelectedRelease.Assets}" MaxHeight="140"
                                                      AutomationProperties.Name="Release assets">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type models:ReleaseAsset}">
                                                    <DockPanel Margin="0,2">
                                                        <ui:Button DockPanel.Dock="Right" Content="Download" FontSize="11" Padding="8,2"
                                                                   Icon="{ui:SymbolIcon ArrowDownload24}"
                                                                   Command="{Binding DataContext.DownloadReleaseAssetCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                   CommandParameter="{Binding}"
                                                                   AutomationProperties.Name="Download this asset" />
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding SizeLabel}" FontSize="11"
                                                                   MinWidth="70" Margin="8,0,8,0" VerticalAlignment="Center"
                                                                   HorizontalAlignment="Right"
                                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                        <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"
                                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <WrapPanel Grid.Row="3" Margin="0,8,0,0">
                                        <ui:Button Content="Open on GitHub" FontSize="12" Padding="12,4" Margin="0,0,6,6"
                                                   Icon="{ui:SymbolIcon Open24}"
                                                   Command="{Binding OpenReleaseCommand}"
                                                   CommandParameter="{Binding SelectedRelease}"
                                                   AutomationProperties.Name="Open this release on GitHub" />
                                        <ui:Button Content="Delete release" FontSize="12" Padding="12,4" Margin="0,0,6,6"
                                                   Command="{Binding DeleteReleaseCommand}"
                                                   AutomationProperties.Name="Delete this release" />
                                    </WrapPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ── REPO ── -->
            <TabItem Header="Repo" Tag="{x:Static models:DetailTab.Repo}">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <ui:Button DockPanel.Dock="Right" Content="Refresh" FontSize="12" Padding="10,4"
                                   Icon="{ui:SymbolIcon ArrowSync24}"
                                   Command="{Binding LoadRepoTabCommand}"
                                   AutomationProperties.Name="Refresh repository settings and notifications" />
                        <ui:ProgressRing DockPanel.Dock="Right" IsIndeterminate="True" Width="16" Height="16"
                                         Margin="0,0,10,0" VerticalAlignment="Center"
                                         Visibility="{Binding RepoSettingsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding GitHubStatusText}"
                                   AutomationProperties.LiveSetting="Polite" />
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                        <StackPanel MaxWidth="860" HorizontalAlignment="Left">

                            <TextBlock Text="{Binding RepoSettingsError}" FontSize="12" TextWrapping="Wrap"
                                       Margin="0,0,0,8" Foreground="{DynamicResource StatusBadFg}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RepoSettingsError}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Details -->
                            <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8"
                                    Padding="16,12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Repository details" Style="{StaticResource PaneHeader}" />
                                    <TextBlock FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                        <Run Text="{Binding Project.GitHubSlug, Mode=OneWay}" />
                                        <Run Text=" · default branch " /><Run Text="{Binding RepoSettings.DefaultBranch, Mode=OneWay}" />
                                        <Run Text=" · " /><Run Text="{Binding RepoSettings.Visibility, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="Description" FontSize="12" Margin="0,0,0,2"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <ui:TextBox Text="{Binding RepoDescriptionDraft, UpdateSourceTrigger=PropertyChanged}"
                                                PlaceholderText="What this repository is" Margin="0,0,0,8"
                                                AutomationProperties.Name="Repository description" />
                                    <TextBlock Text="Homepage" FontSize="12" Margin="0,0,0,2"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <ui:TextBox Text="{Binding RepoHomepageDraft, UpdateSourceTrigger=PropertyChanged}"
                                                PlaceholderText="https://example.com" Margin="0,0,0,8"
                                                AutomationProperties.Name="Repository homepage" />
                                    <TextBlock Text="Topics (comma-separated)" FontSize="12" Margin="0,0,0,2"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <ui:TextBox Text="{Binding RepoTopicsDraft, UpdateSourceTrigger=PropertyChanged}"
                                                PlaceholderText="wpf, dotnet" Margin="0,0,0,10"
                                                AutomationProperties.Name="Repository topics" />
                                    <ui:Button Content="Save details" Appearance="Primary" FontSize="12" Padding="14,4"
                                               HorizontalAlignment="Left"
                                               Command="{Binding SaveRepoDetailsCommand}"
                                               AutomationProperties.Name="Save repository description, homepage and topics" />
                                </StackPanel>
                            </Border>

                            <!-- Features -->
                            <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8"
                                    Padding="16,12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Features" Style="{StaticResource PaneHeader}" />
                                    <CheckBox Content="Issues" FontSize="12" Margin="0,0,0,4"
                                              IsChecked="{Binding RepoIssuesEnabled}"
                                              AutomationProperties.Name="Enable issues" />
                                    <CheckBox Content="Wiki" FontSize="12" Margin="0,0,0,4"
                                              IsChecked="{Binding RepoWikiEnabled}"
                                              AutomationProperties.Name="Enable wiki" />
                                    <CheckBox Content="Projects" FontSize="12" Margin="0,0,0,10"
                                              IsChecked="{Binding RepoProjectsEnabled}"
                                              AutomationProperties.Name="Enable projects" />
                                    <ui:Button Content="Save features" FontSize="12" Padding="14,4"
                                               HorizontalAlignment="Left"
                                               Command="{Binding SaveRepoFeaturesCommand}"
                                               AutomationProperties.Name="Save repository feature toggles" />
                                </StackPanel>
                            </Border>

                            <!-- Default branch + visibility -->
                            <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8"
                                    Padding="16,12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Branch and visibility" Style="{StaticResource PaneHeader}" />
                                    <TextBlock Text="Default branch (must already exist on the remote)" FontSize="12" Margin="0,0,0,2"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <WrapPanel Margin="0,0,0,10">
                                        <ui:TextBox Text="{Binding RepoDefaultBranchDraft, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="220" Margin="0,0,8,0"
                                                    AutomationProperties.Name="Default branch" />
                                        <ui:Button Content="Change default branch" FontSize="12" Padding="12,4"
                                                   Command="{Binding ChangeDefaultBranchCommand}"
                                                   AutomationProperties.Name="Change the default branch" />
                                    </WrapPanel>
                                    <TextBlock Text="Visibility — outward-facing; the change takes a typed repository name" FontSize="12"
                                               Margin="0,0,0,2" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <WrapPanel>
                                        <ComboBox ItemsSource="{x:Static local:ProjectDetailViewModel.RepoVisibilities}"
                                                  SelectedItem="{Binding SelectedRepoVisibility}"
                                                  Width="140" FontSize="12" Margin="0,0,8,0"
                                                  AutomationProperties.Name="Repository visibility" />
                                        <ui:Button Content="Change visibility" FontSize="12" Padding="12,4"
                                                   Command="{Binding ChangeRepoVisibilityCommand}"
                                                   AutomationProperties.Name="Change repository visibility" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8"
                                    Padding="16,12" Margin="0,0,0,12">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <ui:Button DockPanel.Dock="Right" Content="Mark all read" FontSize="11" Padding="8,2"
                                                   Command="{Binding MarkAllNotificationsReadCommand}"
                                                   AutomationProperties.Name="Mark every notification on this repository read" />
                                        <ui:Button DockPanel.Dock="Right" Content="Refresh" FontSize="11" Padding="8,2" Margin="0,0,6,0"
                                                   Icon="{ui:SymbolIcon ArrowSync24}"
                                                   Command="{Binding LoadNotificationsCommand}"
                                                   AutomationProperties.Name="Refresh notifications" />
                                        <TextBlock Text="Unread notifications" Style="{StaticResource PaneHeader}"
                                                   Margin="0" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding NotificationsError}" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{DynamicResource StatusBadFg}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NotificationsError}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="Nothing unread on this repository." FontSize="12"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding Notifications.Count}" Value="0" />
                                                            <Condition Binding="{Binding NotificationsError}" Value="" />
                                                            <Condition Binding="{Binding NotificationsLoading}" Value="False" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ListBox ItemsSource="{Binding Notifications}" MaxHeight="220"
                                             Background="Transparent" BorderThickness="0"
                                             AutomationProperties.Name="Unread notifications">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="4,4" />
                                                <Setter Property="AutomationProperties.Name">
                                                    <Setter.Value>
                                                        <MultiBinding StringFormat="{}{0}: {1}">
                                                            <Binding Path="ReasonLabel" />
                                                            <Binding Path="Title" />
                                                        </MultiBinding>
                                                    </Setter.Value>
                                                </Setter>
                                                <EventSetter Event="MouseDoubleClick" Handler="NotificationRow_Open" />
                                                <EventSetter Event="KeyDown" Handler="NotificationRow_KeyDown" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:GitHubNotification}">
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Left" Background="{DynamicResource StatusInfoBg}"
                                                            CornerRadius="4" Padding="6,1" Margin="0,0,8,0" MinWidth="88"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ReasonLabel}" FontSize="10"
                                                                   HorizontalAlignment="Center"
                                                                   Foreground="{DynamicResource StatusInfoFg}" />
                                                    </Border>
                                                    <ui:Button DockPanel.Dock="Right" Content="Mark read" FontSize="11" Padding="8,2"
                                                               Margin="8,0,0,0"
                                                               Command="{Binding DataContext.MarkNotificationReadCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                               CommandParameter="{Binding}"
                                                               AutomationProperties.Name="Mark this notification read" />
                                                    <ui:Button DockPanel.Dock="Right" Content="Open" FontSize="11" Padding="8,2"
                                                               Margin="8,0,0,0" Icon="{ui:SymbolIcon Open24}"
                                                               Command="{Binding DataContext.OpenNotificationCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                               CommandParameter="{Binding}"
                                                               AutomationProperties.Name="Open this notification on GitHub" />
                                                    <TextBlock Text="{Binding Title}" FontSize="12" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Text="Opening a notification never marks it read — use Mark read."
                                               FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource StatusBadBg}" BorderBrush="{DynamicResource StatusBadFg}"
                                    BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,16"
                                    Visibility="{Binding DangerZoneEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    AutomationProperties.Name="Danger zone">
                                <StackPanel>
                                    <TextBlock Text="Danger zone" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"
                                               Foreground="{DynamicResource StatusBadFg}" />
                                    <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               Text="Deleting the repository removes its issues, pull requests, releases and Actions history on GitHub for good. The local files on this machine are not touched. You will be asked to type the full owner/name to confirm." />
                                    <ui:Button Content="Delete repository on GitHub" Appearance="Danger" FontSize="12" Padding="14,4"
                                               HorizontalAlignment="Left"
                                               Command="{Binding DeleteRepoCommand}"
                                               AutomationProperties.Name="Delete this repository on GitHub" />
                                    <TextBlock Text="{Binding RepoDeleteNotice}"
                                               AutomationProperties.LiveSetting="Assertive" FontSize="12" TextWrapping="Wrap"
                                               Margin="0,10,0,0"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RepoDeleteNotice}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ui:Button Content="Grant delete_repo scope" FontSize="12" Padding="14,4" Margin="0,8,0,0"
                                               HorizontalAlignment="Left"
                                               Visibility="{Binding DeleteScopeHintVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                               Command="{Binding GrantDeleteScopeCommand}"
                                               AutomationProperties.Name="Grant the delete_repo scope to the GitHub CLI" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ── INTERNALS ── -->
            <TabItem Header="Internals" Tag="{x:Static models:DetailTab.Internals}">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="460" />
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,10">
                        <ui:Button DockPanel.Dock="Right" Content="Refresh" FontSize="12" Padding="10,4"
                                   Icon="{ui:SymbolIcon ArrowSync24}"
                                   Command="{Binding LoadInternalsCommand}"
                                   AutomationProperties.Name="Reload the worktrees, submodules, and ignore rules" />
                        <TextBlock FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="What this checkout is made of: the worktrees sharing this repository, the submodules it declares, and the ignore rules at its root. Everything here is local — nothing on this tab contacts a remote except a submodule update, which clones what it is missing." />
                    </DockPanel>

                    <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- ── WORKTREES ── -->
                        <Border Grid.Row="0" Margin="0,0,0,12"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                CornerRadius="8" Padding="10,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Worktrees" Style="{StaticResource PaneHeader}" />

                                <ListBox Grid.Row="1" ItemsSource="{Binding Worktrees}"
                                         SelectedItem="{Binding SelectedWorktree}"
                                         Background="Transparent" BorderThickness="0"
                                         HorizontalContentAlignment="Stretch"
                                         AutomationProperties.Name="Worktrees of this repository">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="AutomationProperties.Name">
                                                <Setter.Value>
                                                    <MultiBinding StringFormat="{}{0}{1}{2}">
                                                        <Binding Path="Path" />
                                                        <Binding Path="BranchSuffix" />
                                                        <Binding Path="StateSuffix" />
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,3">
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Right" Background="{DynamicResource StatusInfoBg}"
                                                            CornerRadius="4" Padding="6,1" Margin="10,0,0,0"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding BranchLabel}" FontSize="10"
                                                                   Foreground="{DynamicResource StatusInfoFg}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Path}" FontSize="12"
                                                               FontFamily="Cascadia Code,Consolas"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding StateLabel}" FontSize="11"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding StateLabel}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <StackPanel Grid.Row="2" Margin="0,8,0,0">
                                    <DockPanel Margin="0,0,0,6">
                                        <ui:TextBox DockPanel.Dock="Left" Width="150"
                                                    Text="{Binding NewWorktreeBranch, UpdateSourceTrigger=PropertyChanged}"
                                                    PlaceholderText="new branch (required)" FontSize="12" Margin="0,0,8,0"
                                                    FontFamily="Cascadia Code,Consolas"
                                                    AutomationProperties.Name="Branch to create in the new worktree" />
                                        <ui:Button DockPanel.Dock="Right" Content="Add" FontSize="11" Padding="12,3"
                                                   Margin="8,0,0,0" Appearance="Primary"
                                                   Command="{Binding AddWorktreeCommand}"
                                                   AutomationProperties.Name="Add the worktree" />
                                        <ui:Button DockPanel.Dock="Right" Content="Browse…" FontSize="11" Padding="10,3"
                                                   Margin="8,0,0,0"
                                                   Command="{Binding ChooseWorktreePathCommand}"
                                                   AutomationProperties.Name="Choose where the new worktree goes" />
                                        <ui:TextBox Text="{Binding NewWorktreePath, UpdateSourceTrigger=PropertyChanged}"
                                                    PlaceholderText="path for the new worktree" FontSize="12"
                                                    AutomationProperties.Name="Path for the new worktree">
                                            <ui:TextBox.InputBindings>
                                                <KeyBinding Key="Enter" Command="{Binding AddWorktreeCommand}" />
                                            </ui:TextBox.InputBindings>
                                        </ui:TextBox>
                                    </DockPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:Button Content="Remove worktree" FontSize="11" Padding="10,3"
                                                   Appearance="Danger" Margin="0,0,8,0"
                                                   Command="{Binding RemoveWorktreeCommand}"
                                                   AutomationProperties.Name="Remove the selected worktree" />
                                        <ui:Button Content="Prune stale entries…" FontSize="11" Padding="10,3"
                                                   Command="{Binding PruneWorktreesCommand}"
                                                   ToolTip="Clear the administrative entries whose working tree is gone"
                                                   AutomationProperties.Name="Prune the stale worktree entries" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding WorktreesStatusText}" FontSize="11" TextWrapping="Wrap"
                                               Margin="0,6,0,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               AutomationProperties.AutomationId="WorktreesStatusText"
                                               AutomationProperties.LiveSetting="Polite" />
                                    <TextBlock Text="{Binding WorktreesErrorText}" FontSize="11" TextWrapping="Wrap"
                                               Margin="0,4,0,0" Foreground="{DynamicResource StatusBadFg}"
                                               AutomationProperties.AutomationId="WorktreesErrorText"
                                               AutomationProperties.LiveSetting="Polite" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- ── SUBMODULES ── -->
                        <Border Grid.Row="1" Background="{DynamicResource ControlFillColorDefaultBrush}"
                                CornerRadius="8" Padding="10,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Submodules" Style="{StaticResource PaneHeader}" />

                                <Border Grid.Row="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                        AutomationProperties.AutomationId="SubmodulesEmptyState"
                                        Visibility="{Binding SubmodulesEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock FontSize="12" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="This repository declares no submodules and records no gitlinks." />
                                </Border>

                                <ListBox Grid.Row="2" ItemsSource="{Binding Submodules}"
                                         SelectedItem="{Binding SelectedSubmodule}"
                                         Background="Transparent" BorderThickness="0"
                                         HorizontalContentAlignment="Stretch"
                                         AutomationProperties.Name="Submodules of this repository">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="AutomationProperties.Name">
                                                <Setter.Value>
                                                    <MultiBinding StringFormat="{}{0}{1}">
                                                        <Binding Path="Path" />
                                                        <Binding Path="UrlSuffix" />
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:SubmoduleEntry}">
                                            <StackPanel Margin="0,3">
                                                <TextBlock Text="{Binding Path}" FontSize="12"
                                                           FontFamily="Cascadia Code,Consolas"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Url}"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <Border CornerRadius="4" Padding="6,1" Margin="0,0,6,0">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource StatusWarnBg}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsInitialized}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource StatusGoodBg}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock FontSize="10"
                                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="not initialized" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsInitialized}" Value="True">
                                                                            <Setter Property="Text" Value="initialized" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                    <Border Background="{DynamicResource StatusBadBg}" CornerRadius="4"
                                                            Padding="6,1" Margin="0,0,6,0"
                                                            Visibility="{Binding IsConflicted, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock Text="conflicted" FontSize="10"
                                                                   Foreground="{DynamicResource StatusBadFg}" />
                                                    </Border>
                                                    <Border Background="{DynamicResource StatusWarnBg}" CornerRadius="4"
                                                            Padding="6,1" Margin="0,0,6,0"
                                                            Visibility="{Binding IsDirty, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock Text="dirty" FontSize="10"
                                                                   Foreground="{DynamicResource StatusWarnFg}" />
                                                    </Border>
                                                    <Border Background="{DynamicResource StatusWarnBg}" CornerRadius="4"
                                                            Padding="6,1" Margin="0,0,6,0"
                                                            Visibility="{Binding CommitDiffersFromRecorded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock Text="off the recorded commit" FontSize="10"
                                                                   Foreground="{DynamicResource StatusWarnFg}" />
                                                    </Border>
                                                    <Border Background="{DynamicResource StatusInfoBg}" CornerRadius="4"
                                                            Padding="6,1" Margin="0,0,6,0"
                                                            Visibility="{Binding HasNestedSubmodules, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock Text="has submodules of its own" FontSize="10"
                                                                   Foreground="{DynamicResource StatusInfoFg}" />
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <StackPanel Grid.Row="3" Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <ui:Button Content="Init" FontSize="11" Padding="12,3" Margin="0,0,6,0"
                                                   Command="{Binding InitSubmoduleCommand}"
                                                   ToolTip="Register the submodule in this repository's config without cloning it"
                                                   AutomationProperties.Name="Initialize the selected submodule" />
                                        <ui:Button Content="Update" FontSize="11" Padding="12,3" Margin="0,0,6,0"
                                                   Appearance="Primary"
                                                   Command="{Binding UpdateSubmoduleCommand}"
                                                   ToolTip="Clone if needed and check out the commit this repository records"
                                                   AutomationProperties.Name="Update the selected submodule" />
                                        <ui:Button Content="Sync" FontSize="11" Padding="12,3" Margin="0,0,6,0"
                                                   Command="{Binding SyncSubmoduleCommand}"
                                                   ToolTip="Rewrite the submodule's configured URL from .gitmodules"
                                                   AutomationProperties.Name="Sync the selected submodule's URL" />
                                        <ui:Button Content="Deinitialize…" FontSize="11" Padding="12,3"
                                                   Appearance="Danger"
                                                   Command="{Binding DeinitSubmoduleCommand}"
                                                   ToolTip="Empty the submodule's working tree and unregister it"
                                                   AutomationProperties.Name="Deinitialize the selected submodule" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox Content="Force" FontSize="11" Margin="0,0,12,0"
                                                  IsChecked="{Binding SubmoduleForce}"
                                                  ToolTip="Adds --force to update and deinitialize"
                                                  AutomationProperties.Name="Add force to the submodule action" />
                                        <CheckBox FontSize="11"
                                                  Content="I understand a forced update discards work in the submodule"
                                                  IsChecked="{Binding SubmoduleConfirmDiscard}"
                                                  AutomationProperties.Name="Acknowledge that a forced update discards work in the submodule" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding SubmodulesStatusText}" FontSize="11" TextWrapping="Wrap"
                                               Margin="0,6,0,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               AutomationProperties.AutomationId="SubmodulesStatusText"
                                               AutomationProperties.LiveSetting="Polite" />
                                    <TextBlock Text="{Binding SubmodulesErrorText}" FontSize="11" TextWrapping="Wrap"
                                               Margin="0,4,0,0" Foreground="{DynamicResource StatusBadFg}"
                                               AutomationProperties.AutomationId="SubmodulesErrorText"
                                               AutomationProperties.LiveSetting="Polite" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ── IGNORE RULES ── -->
                    <Border Grid.Row="1" Grid.Column="1"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            CornerRadius="8" Padding="10,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Ignore rules" Style="{StaticResource PaneHeader}" />

                            <TextBlock Grid.Row="1" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="The .gitignore at this repository's root. Saving writes the file and nothing else — it is an ordinary edit to commit, and a file git already tracks stays tracked whatever the rules say.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="The .gitignore at this repository's root. Saving writes the file and nothing else — it is an ordinary edit to commit, and a file git already tracks stays tracked whatever the rules say." />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding GitignoreLoaded}" Value="True" />
                                                    <Condition Binding="{Binding GitignoreExists}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Text" Value="This repository has no .gitignore at its root. Saving creates one — an ordinary new file to commit. A file git already tracks stays tracked whatever the rules say." />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ui:TextBox Grid.Row="2" Text="{Binding GitignoreText, UpdateSourceTrigger=PropertyChanged}"
                                        AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                                        VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                        FontFamily="Cascadia Code,Consolas" FontSize="12"
                                        PlaceholderText="one pattern per line"
                                        AutomationProperties.AutomationId="GitignoreEditor"
                                        AutomationProperties.Name="Ignore rules for this repository" />

                            <StackPanel Grid.Row="3" Margin="0,8,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <ui:Button Content="Save" FontSize="11" Padding="14,3" Margin="0,0,6,0"
                                               Appearance="Primary"
                                               Command="{Binding SaveGitignoreCommand}"
                                               AutomationProperties.Name="Save the ignore rules" />
                                    <ui:Button Content="Reload from disk" FontSize="11" Padding="12,3"
                                               Command="{Binding RevertGitignoreCommand}"
                                               AutomationProperties.Name="Discard the edits and reload the ignore rules" />
                                    <TextBlock Text="unsaved" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"
                                               Foreground="{DynamicResource StatusWarnFg}"
                                               Visibility="{Binding GitignoreDirty, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>

                                <TextBlock Text="Test a path against the rules" Style="{StaticResource PaneHeader}" />
                                <DockPanel Margin="0,0,0,6">
                                    <ui:Button DockPanel.Dock="Right" Content="Test" FontSize="11" Padding="12,3"
                                               Margin="8,0,0,0"
                                               Command="{Binding ProbeIgnorePathCommand}"
                                               AutomationProperties.Name="Ask git whether the path is ignored" />
                                    <ui:TextBox Text="{Binding IgnoreProbePath, UpdateSourceTrigger=PropertyChanged}"
                                                PlaceholderText="path relative to the repository root"
                                                FontSize="12" FontFamily="Cascadia Code,Consolas"
                                                AutomationProperties.Name="Path to test against the ignore rules">
                                        <ui:TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding ProbeIgnorePathCommand}" />
                                        </ui:TextBox.InputBindings>
                                    </ui:TextBox>
                                </DockPanel>
                                <TextBlock Text="{Binding IgnoreProbeResult}" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           AutomationProperties.AutomationId="IgnoreProbeResult" />
                                <TextBlock Text="{Binding GitignoreStatusText}" FontSize="11" TextWrapping="Wrap"
                                           Margin="0,6,0,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           AutomationProperties.AutomationId="GitignoreStatusText"
                                           AutomationProperties.LiveSetting="Polite" />
                                <TextBlock Text="{Binding GitignoreErrorText}" FontSize="11" TextWrapping="Wrap"
                                           Margin="0,4,0,0" Foreground="{DynamicResource StatusBadFg}"
                                           AutomationProperties.AutomationId="GitignoreErrorText"
                                           AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ═══ REWRITE WIZARD ═══
             A pane rather than a dialog: the dry-run report is long-form and scrolls, the run
             stays visible while the page's busy gate is held, and every gate it enforces is
             view-model state a headless test can drive. The negative margin cancels the page
             padding so the scrim covers the whole surface. -->
        <pages:RewriteWizardView Grid.Row="0" Grid.RowSpan="4" Margin="-32,-16,-32,-16"
                                 IsEnabled="{Binding MaintenanceOverlayHidden}"
                                 Visibility="{Binding RewriteWizardVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 AutomationProperties.Name="Rewrite history wizard" />

        <!-- ═══ BACKUPS ═══
             A pane on the same terms as the wizard: the restore it offers replaces every ref in
             the repository, so the surfaces behind it are disabled rather than merely covered. -->
        <pages:BackupsView Grid.Row="0" Grid.RowSpan="4" Margin="-32,-16,-32,-16"
                           IsEnabled="{Binding MaintenanceOverlayHidden}"
                           Visibility="{Binding BackupsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                           AutomationProperties.Name="Backups browser" />

        <!-- ═══ REFLOG ═══
             Last but one in the Grid so it draws over the panes above it. -->
        <pages:ReflogView Grid.Row="0" Grid.RowSpan="4" Margin="-32,-16,-32,-16"
                          Visibility="{Binding ReflogVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                          AutomationProperties.Name="Reflog viewer" />

        <!-- ═══ TAGS ═══
             Draws over the reflog viewer, and refuses to open while one is up, so only one
             ref-level surface is ever live. -->
        <pages:TagsView Grid.Row="0" Grid.RowSpan="4" Margin="-32,-16,-32,-16"
                        Visibility="{Binding TagsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                        AutomationProperties.Name="Tag viewer" />

        <!-- ═══ PUSH REWRITTEN HISTORY ═══
             Last in the Grid, so opening it from the wizard's result screen draws over the wizard
             rather than replacing it — closing the wizard would take the only one-click undo for
             the history just replaced. -->
        <pages:ForcePushView Grid.Row="0" Grid.RowSpan="4" Margin="-32,-16,-32,-16"
                             Visibility="{Binding ForcePushVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                             AutomationProperties.Name="Push rewritten history" />

        <!-- ═══ FILE HISTORY AND BLAME ═══
             Read-only, and it refuses to open while any pane above is up, so nothing here can
             draw over one that is holding an undo. -->
        <pages:FileHistoryView Grid.Row="0" Grid.RowSpan="4" Margin="-32,-16,-32,-16"
                               Visibility="{Binding FileHistoryVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                               AutomationProperties.Name="File history and blame" />

        <!-- ═══ COMMIT GRAPH ═══ -->
        <pages:CommitGraphView Grid.Row="0" Grid.RowSpan="4" Margin="-32,-16,-32,-16"
                               Visibility="{Binding CommitGraphVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                               AutomationProperties.Name="Commit graph" />
    </Grid>
</Page>
