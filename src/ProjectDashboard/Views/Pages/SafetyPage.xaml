<Page
    x:Class="ProjectDashboard.Views.Pages.SafetyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:ProjectDashboard.ViewModels.Pages"
    FontFamily="Segoe UI">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Page.Resources>

    <Grid Margin="24,18,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ HEADER ═══ -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="18" VerticalAlignment="Center"
                               Margin="0,0,8,0" Foreground="{DynamicResource StatusInfoFg}" />
                <TextBlock Text="Safety" FontSize="24"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </StackPanel>
            <TextBlock Text="{Binding RollupText}" FontSize="14" Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       AutomationProperties.AutomationId="SafetyRollupText" />
            <!-- Which tiers have run, always: an absence of findings from a check nobody ran
                 is not a clean bill of health. -->
            <TextBlock Text="{Binding TierText}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       AutomationProperties.AutomationId="SafetyTierText" />
        </StackPanel>

        <!-- ═══ PORTFOLIO CHECKS ═══ -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <ui:Button Content="Check branches and backups" FontSize="13" Padding="14,5" Margin="0,0,8,0"
                       Icon="{ui:SymbolIcon BranchFork24}"
                       Command="{Binding CheckBranchesAndBackupsCommand}"
                       ToolTip="One ref read and one backup listing per repository"
                       AutomationProperties.Name="Check branches and backups across every repository" />
            <ui:Button Content="Check all — reads every object store" FontSize="13" Padding="14,5" Margin="0,0,8,0"
                       Icon="{ui:SymbolIcon ShieldTask24}"
                       Command="{Binding CheckAllCommand}"
                       ToolTip="Verifies every backup bundle and walks every reflog. Minutes on a large portfolio."
                       AutomationProperties.Name="Verify every backup and walk every reflog — this takes minutes" />
            <ui:Button Content="Cancel" FontSize="13" Padding="14,5" Margin="0,0,8,0"
                       Command="{Binding CancelCheckCommand}"
                       Visibility="{Binding CheckRunning, Converter={StaticResource BooleanToVisibilityConverter}}"
                       AutomationProperties.Name="Cancel the running check" />
            <TextBlock Text="{Binding ProgressText}" FontSize="12" VerticalAlignment="Center"
                       FontFamily="Cascadia Code,Consolas"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       AutomationProperties.AutomationId="SafetyProgressText" />
        </StackPanel>

        <!-- ═══ FINDINGS ═══ -->
        <!-- One flat, virtualized list: group headings are rows of their own so a portfolio of
             hundreds of repositories realizes only the rows on screen. -->
        <ListBox Grid.Row="2" x:Name="SafetyRows" ItemsSource="{Binding Rows}"
                 Background="Transparent" BorderThickness="0"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 AutomationProperties.Name="Safety findings">
            <ListBox.ItemContainerStyle>
                <!-- Without an automation name the row is announced as its type's name: an item
                     container falls back to the item's ToString. -->
                <Style TargetType="ListBoxItem">
                    <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                    <Setter Property="Padding" Value="6,4" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:SafetyRow}">
                    <StackPanel>
                        <!-- Group heading -->
                        <StackPanel Margin="0,10,0,2"
                                    Visibility="{Binding IsGroup, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding Line}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>

                        <!-- Finding -->
                        <StackPanel Margin="14,2,0,2"
                                    Visibility="{Binding IsFinding, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <DockPanel>
                                <ui:Button DockPanel.Dock="Right" FontSize="11" Padding="10,3" Margin="12,0,0,0"
                                           Content="{Binding ActionLabel}"
                                           Command="{Binding DataContext.RunRowActionCommand,
                                                             RelativeSource={RelativeSource AncestorType=Page}}"
                                           CommandParameter="{Binding}"
                                           Visibility="{Binding HasAction, Converter={StaticResource BooleanToVisibilityConverter}}"
                                           AutomationProperties.Name="{Binding AccessibleName, StringFormat=Act on {0}}" />
                                <TextBlock DockPanel.Dock="Left" Width="190" Text="{Binding Title}" FontSize="12"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"
                                           FontFamily="Cascadia Code,Consolas"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding Line}" FontSize="13" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </DockPanel>
                            <TextBlock Text="{Binding SeverityLabel}" FontSize="11" Margin="190,2,0,0"
                                       Foreground="{DynamicResource StatusWarnFg}" />
                            <TextBlock Text="{Binding Detail}" FontSize="11" TextWrapping="Wrap" Margin="190,2,0,0"
                                       Visibility="{Binding HasDetail, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- ═══ FOOTER ═══ -->
        <TextBlock Grid.Row="3" Text="{Binding StatusText}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   AutomationProperties.AutomationId="SafetyStatusText"
                   AutomationProperties.LiveSetting="Polite" />
    </Grid>
</Page>
