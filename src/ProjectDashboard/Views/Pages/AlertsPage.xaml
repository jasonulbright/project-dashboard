<Page
    x:Class="ProjectDashboard.Views.Pages.AlertsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:ProjectDashboard.ViewModels.Pages"
    FontFamily="Segoe UI">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Page.Resources>

    <Grid Margin="24,18,24,18" Grid.IsSharedSizeScope="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ HEADER ═══ -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Alert24" FontSize="18" VerticalAlignment="Center"
                               Margin="0,0,8,0" Foreground="{DynamicResource StatusInfoFg}" />
                <TextBlock Text="Alerts" FontSize="24"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </StackPanel>
            <TextBlock FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Text="What is open against each repository on GitHub: issues, pull requests, and the three security sources. The page opens from what it last knew — each row says when — and a refresh asks conditionally, so an unchanged repository costs a request the rate limit never counts. A source that refuses says why on its cell; it is never shown as zero. Issue and pull request counts come from the last scan." />
        </StackPanel>

        <!-- ═══ FILTERS ═══ -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <ui:TextBox Width="220" FontSize="12" PlaceholderText="Filter by name or owner/repo"
                        Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.Name="Filter repositories by name" />
            <CheckBox Content="Only rows with something open" FontSize="12" Margin="12,0,0,0"
                      VerticalAlignment="Center" IsChecked="{Binding OnlyWithAlerts}"
                      AutomationProperties.Name="Show only repositories with something open" />
            <ComboBox Width="160" Margin="12,0,0,0" FontSize="12"
                      ItemsSource="{Binding SourceFilterChoices}" SelectedItem="{Binding SourceFilter}"
                      AutomationProperties.Name="Which source the filter looks at" />
            <ui:Button Content="Refresh" FontSize="12" Padding="12,4" Margin="12,0,0,0"
                       Icon="{ui:SymbolIcon ArrowSync24}"
                       Command="{Binding RefreshAllCommand}"
                       AutomationProperties.Name="Ask GitHub again about every repository" />
        </StackPanel>

        <!-- ═══ COLUMN HEADINGS ═══ -->
        <Grid Grid.Row="2" Margin="12,0,12,4"
              Visibility="{Binding HasRows, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="70" SharedSizeGroup="AlertIssues" />
                <ColumnDefinition Width="70" SharedSizeGroup="AlertPrs" />
                <ColumnDefinition Width="90" SharedSizeGroup="AlertDependabot" />
                <ColumnDefinition Width="90" SharedSizeGroup="AlertCode" />
                <ColumnDefinition Width="90" SharedSizeGroup="AlertSecret" />
                <ColumnDefinition Width="110" SharedSizeGroup="AlertAsOf" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="AlertActions" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Repository" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock Grid.Column="1" Text="Issues" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock Grid.Column="2" Text="PRs" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock Grid.Column="3" Text="Dependabot" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock Grid.Column="4" Text="Code scan" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock Grid.Column="5" Text="Secret scan" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock Grid.Column="6" Text="Answers as of" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </Grid>

        <!-- ═══ ROWS ═══ -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Rows}" AutomationProperties.Name="Repository alerts">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:AlertRow}">
                            <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    CornerRadius="6" Padding="12,8" Margin="0,0,0,6"
                                    AutomationProperties.Name="{Binding AccessibleName}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="70" SharedSizeGroup="AlertIssues" />
                                        <ColumnDefinition Width="70" SharedSizeGroup="AlertPrs" />
                                        <ColumnDefinition Width="90" SharedSizeGroup="AlertDependabot" />
                                        <ColumnDefinition Width="90" SharedSizeGroup="AlertCode" />
                                        <ColumnDefinition Width="90" SharedSizeGroup="AlertSecret" />
                                        <ColumnDefinition Width="110" SharedSizeGroup="AlertAsOf" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="AlertActions" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{Binding Slug}" FontSize="11"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding IssuesText}" FontSize="13"
                                               VerticalAlignment="Center"
                                               ToolTip="Open issues, as of the last scan"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Grid.Column="2" Text="{Binding PrsText}" FontSize="13"
                                               VerticalAlignment="Center"
                                               ToolTip="Open pull requests, as of the last scan"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Grid.Column="3" Text="{Binding DependabotText}" FontSize="13"
                                               VerticalAlignment="Center" ToolTip="{Binding DependabotDetail}"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Grid.Column="4" Text="{Binding CodeScanningText}" FontSize="13"
                                               VerticalAlignment="Center" ToolTip="{Binding CodeScanningDetail}"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Grid.Column="5" Text="{Binding SecretScanningText}" FontSize="13"
                                               VerticalAlignment="Center" ToolTip="{Binding SecretScanningDetail}"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Grid.Column="6" Text="{Binding AsOfText}" FontSize="11"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <ui:Button Grid.Column="7" Content="Security…" FontSize="11" Padding="8,3"
                                               VerticalAlignment="Center"
                                               Command="{Binding DataContext.OpenSecurityPageCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                               CommandParameter="{Binding}"
                                               ToolTip="Open this repository's security page on GitHub"
                                               AutomationProperties.Name="{Binding Name, StringFormat='Open the security page for {0} on GitHub'}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding EmptyNotice}" FontSize="13" TextWrapping="Wrap" Margin="4,8,4,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EmptyNotice}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>

        <!-- ═══ STATUS ═══ -->
        <TextBlock Grid.Row="4" Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap"
                   Text="{Binding StatusText}"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   AutomationProperties.Name="{Binding StatusText, StringFormat='Alerts status: {0}'}"
                   AutomationProperties.LiveSetting="Polite" />
    </Grid>
</Page>
