<Application
    x:Class="ProjectDashboard.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <!-- Last, so its keys outrank the theme dictionary's. MainWindow swaps this
                     entry for the light one whenever the applied theme changes; the palette
                     is referenced with DynamicResource everywhere for that reason. -->
                <ResourceDictionary Source="pack://application:,,,/ProjectDashboard;component/Views/Themes/StatusPalette.Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Accessibility: a visible keyboard-focus ring (adorner, doesn't disturb the element's
                 own border) + a style that makes a clickable Border keyboard-focusable. -->
            <Style x:Key="FocusRing">
                <Setter Property="Control.Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Rectangle Margin="1" RadiusX="8" RadiusY="8"
                                       Stroke="{DynamicResource FocusRingBrush}" StrokeThickness="2"
                                       SnapsToDevicePixels="True" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="FocusableChip" TargetType="Border">
                <Setter Property="Focusable" Value="True" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
